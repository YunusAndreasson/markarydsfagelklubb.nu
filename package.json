    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "wrangler types && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "ship": "bash scripts/ship.sh",
    "types:db": "supabase gen types typescript --project-id zgnmajovyqibgxlcomvb > src/lib/database.types.ts && biome format --write src/lib/database.types.ts",
    "types:cf": "wrangler types",
    "admin:password": "node scripts/set-admin-password.mjs",
    "wp-import": "tsx scripts/wp-import/index.ts",
    "wp-import:pages": "tsx scripts/wp-import/import-pages.ts",
    "wp-import:redirects": "tsx scripts/wp-import/write-redirects.ts"
  },
