---
import Aside from "@/components/site/Aside.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import Section from "@/components/site/Section.astro"
import type { Recent, YearStats } from "@/lib/artportalen/types"
import { arter, yearHeadline } from "@/lib/obsar-stats"
import ArrivalEntries from "./ArrivalEntries.astro"
import RegisterGroup from "./RegisterGroup.astro"
import RegisterSet from "./RegisterSet.astro"
import SightingEntries from "./SightingEntries.astro"

/**
 * The kommun's birds on the home page (docs/design.md, "Obsar och statistik",
 * "Startsidan"): a `RegisterSet` like the other bird sections. The year in one
 * sentence, the year's newest species beside the newest sightings, the count's
 * source at the foot; Obsar's pages, the next step, in the outer margin.
 */
interface Props {
  stats: YearStats | null
  recent: Recent | null
  now: Date
}

const { stats, recent, now } = Astro.props
const sightings = recent?.sightings.slice(0, 4) ?? []
const links = [
  ...(stats ? [{ href: "/obsar/arslista", label: `Årslistan, ${arter(stats.speciesCount)}` }] : []),
  { href: "/obsar/senaste", label: "Alla fynd den senaste månaden" },
  { href: "/obsar/ligan", label: "Ligan, flest arter i år" },
]
---

{
  (stats || sightings.length > 0) && (
    <Section id="fynd" title="Fynd i kommunen" href="/obsar" link="Allt om obsar" layout="spread" wide>
      <div class="in-wide">
        <RegisterSet>
          {stats && <p slot="lead" class="type-ingress text-muted-foreground measure">{yearHeadline(stats)}</p>}
          {stats && (
            <RegisterGroup id="fynd-nya" label="Nya för året">
              <ArrivalEntries species={stats.species} count={4} />
            </RegisterGroup>
          )}
          {sightings.length > 0 && (
            <RegisterGroup id="fynd-senaste" label="Senaste fynden">
              <SightingEntries sightings={sightings} now={now} brief />
            </RegisterGroup>
          )}
          {stats && (
            <Fragment slot="note">
              {stats.reports.toLocaleString("sv-SE")} rapporter från {stats.observerCount} rapportörer i år, hämtade från Artportalen.
            </Fragment>
          )}
        </RegisterSet>
      </div>
      <Aside label="Mer om fynden" sticky={false} first={false}>
        <AsideNote label="Listorna" headingLevel={3} kind="note">
          <ul class="flex flex-col">
            {links.map((one) => (
              <li>
                <a href={one.href} class="action-link">
                  {one.label}
                </a>
              </li>
            ))}
          </ul>
        </AsideNote>
      </Aside>
    </Section>
  )
}
