---
import RarityChip from "@/components/site/RarityChip.astro"
import type { RarityLevel } from "@/lib/rarity"
import { capitalize } from "@/lib/text"

/**
 * One line of a register: a short date or time in its own narrow column, the
 * species in Alegreya, then quieter lines under it (docs/design.md, "Obsar och
 * statistik"). The same entry serves the årslista, Markarydslistan, Senaste
 * fynden and the hub, so they read as one notebook.
 */
interface Props {
  /** "2 jan", "08:15", "1974"; empty for a report without a time. */
  when?: string
  datetime?: string
  title: string
  /** Links the species, e.g. to the report on Artportalen. */
  href?: string | null
  /** A reported count, set before the name. */
  count?: number | null
  sci?: string
  notes?: (string | null | undefined | false)[]
  /** The club's rarity prefix, as a chip after the name; none for a bird not on the club's list. */
  rarity?: RarityLevel | null
}

const { when = "", datetime, title: given, href, count, sci, notes = [], rarity } = Astro.props
// A name that starts the line starts with a capital, as a heading would
// ("Prutgås"); after a count it reads as a phrase and stays small ("8 sidensvans").
// Artportalen writes names in lower case, the club's list capitalised, and the
// two meet on the same page.
const counted = count !== null && count !== undefined
const title = counted ? given : capitalize(given)
const lines = notes.filter((note): note is string => Boolean(note))
---

<li class="mb-3.5 grid break-inside-avoid grid-cols-[4.25rem_minmax(0,1fr)] items-baseline gap-x-3">
  <time datetime={datetime} class="type-label">{when}</time>
  <div class="flex min-w-0 flex-col">
    <p class="flex flex-wrap items-baseline gap-x-1.5">
      {counted && <span class="font-semibold tabular-nums">{count}</span>}
      {
        href ? (
          <a href={href} class="type-item title-link">
            {title}
          </a>
        ) : (
          <span class="type-item">{title}</span>
        )
      }
      {rarity !== null && rarity !== undefined && <RarityChip level={rarity} />}
    </p>
    {sci && <i class="type-caption type-latin">{sci}</i>}
    {lines.map((line) => <p class="type-label text-balance">{line}</p>)}
  </div>
</li>
