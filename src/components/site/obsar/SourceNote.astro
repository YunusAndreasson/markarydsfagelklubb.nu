---
import { formatDate } from "@/lib/stockholm-time"

/**
 * The credit every Obsar page carries (docs/design.md, "Obsar och statistik"),
 * at the foot of the content track.
 * Artportalen's data is CC0; the credit is courtesy and tells the reader what
 * the numbers leave out.
 */
interface Props {
  fetchedAt?: string | null
  /** At the margin's edge, under `wide` sections. */
  wide?: boolean
}

const { fetchedAt, wide = false } = Astro.props
---

<p class:list={["type-caption measure", !wide && "at-text"]}>
  Källa: <a href="https://www.artportalen.se/" class="link">Artportalen</a>, SLU Artdatabanken. Skyddsklassade fynd ingår
  inte, och nya rapporter kan komma in i efterhand.{fetchedAt && ` Uppdaterad ${formatDate(fetchedAt, "dateTime")}.`}
</p>
