---
/**
 * The one shape of every bird section on the home page and Obsar's Översikt
 * (docs/design.md, "Startsidan", "Spalterna"): a lead sentence, only when it
 * says something the lists don't; the lists side by side when the set has room
 * for two (36rem, its own width rather than the window's), stacked in a third of
 * the home page's bird row or on a phone; and the note on where the numbers come
 * from at the foot. In the bird row the note goes to the section's `foot`
 * instead, so the row's footnotes line up.
 */
---

<div class="@container flex flex-col gap-6">
  {Astro.slots.has("lead") && <div class="flex flex-col gap-2"><slot name="lead" /></div>}
  <div class="grid gap-x-(--track-gap) gap-y-8 @xl:grid-cols-2">
    <slot />
  </div>
  {
    Astro.slots.has("note") && (
      <p class="type-caption measure">
        <slot name="note" />
      </p>
    )
  }
</div>
