---
/**
 * The head of every Obsar page, on the grid's content track (docs/design.md,
 * "Obsar och statistik", "Grid"): the crumb, the title and the ingress at the
 * measure, then anything page-specific (a year strip). The 40-year page has its
 * title in the band, so `title` is optional.
 *
 * No row of the section's pages: the header's Obsar panel (and the phone menu)
 * already lists them, and repeating them here made the section read like a
 * site of its own (2026-11-15). The crumb leads back to Översikt, which links
 * to every page.
 */
interface Props {
  title?: string
  /** The crumb back to /obsar; off on /obsar itself. */
  crumb?: boolean
  ingress?: string | null | false
}

const { title, crumb = true, ingress } = Astro.props
---

<header class="flex flex-col gap-5 at-text">
  {
    (title || ingress) && (
      <div class="flex measure flex-col gap-4">
        {crumb && (
          <p class="type-meta">
            <a href="/obsar" class="crumb">Obsar</a>
          </p>
        )}
        {title && <h1 class="type-title">{title}</h1>}
        {ingress && <p class="type-ingress text-muted-foreground">{ingress}</p>}
      </div>
    )
  }
  <slot name="after" />
</header>
