---
import Entry from "@/components/site/obsar/Entry.astro"
import RegisterGroup from "@/components/site/obsar/RegisterGroup.astro"
import RegisterSet from "@/components/site/obsar/RegisterSet.astro"
import type { PastSpecies } from "@/lib/past-sightings"
import { speciesHref } from "@/lib/species"
import { formatDate } from "@/lib/stockholm-time"

/**
 * "Förr om åren" (docs/design.md): the kommun's rare and odd birds from earlier
 * years within three days of today, from Artportalen, ranked by the club's
 * prefix (`past-sightings.ts`). A `RegisterSet` like the other bird sections,
 * with no lead (it would only name the birds the lists name): the birds rare
 * here at any time beside the ones rare only in the year they came. The newest
 * year stands in the date column, the bird with its chip, the days under it.
 */
interface Props {
  rare: PastSpecies[]
  scarce: PastSpecies[]
  /** Taxon id → species page slug (`taxonSlugs`). */
  slugs: Map<number, string>
}

const { rare, scarce, slugs } = Astro.props

const day = (date: string) => formatDate(`${date}T12:00:00Z`, "short")
const and = (parts: string[]) =>
  parts.length <= 1 ? parts.join("") : `${parts.slice(0, -1).join(", ")} och ${parts.at(-1)}`
const MAX_DATES = 4
const dates = (bird: PastSpecies) => {
  // The newest year stands in the date column already; the older ones need theirs.
  const shown = bird.sightings
    .slice(0, MAX_DATES)
    .map((one, i) => (i === 0 ? day(one.date) : `${day(one.date)} ${one.year}`))
  const more = bird.sightings.length - shown.length
  return more > 0 ? `${shown.join(", ")} och ${more} år till` : and(shown)
}
const groups = [
  { id: "forr-sallsynta", label: "Sällsynta här", birds: rare },
  { id: "forr-ovanliga", label: "Ovanliga det året", birds: scarce },
].filter((group) => group.birds.length > 0)
---

{
  groups.length > 0 && (
    <RegisterSet>
      {groups.map((group) => (
        <RegisterGroup id={group.id} label={group.label}>
          {group.birds.map((bird) => (
            <Entry
              when={String(bird.sightings[0]?.year ?? "")}
              datetime={bird.sightings[0]?.date}
              title={bird.name}
              href={slugs.has(bird.taxonId) ? speciesHref(slugs.get(bird.taxonId) as string) : null}
              rarity={bird.rarity}
              notes={[dates(bird)]}
            />
          ))}
        </RegisterGroup>
      ))}
      <Fragment slot="note">
        Fynd från Artportalen, tre dagar före eller efter dagens datum. Siffran är artens prefix på klubbens larmlista.
      </Fragment>
    </RegisterSet>
  )
}
