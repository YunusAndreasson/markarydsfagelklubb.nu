---
import Entry from "@/components/site/obsar/Entry.astro"
import Register from "@/components/site/obsar/Register.astro"
import type { PastSpecies } from "@/lib/past-sightings"
import { speciesHref } from "@/lib/species"
import { formatDate } from "@/lib/stockholm-time"

/**
 * "I backspegeln" (docs/design.md): the kommun's rare birds (prefix 0–2) from
 * earlier years within a week of today, from Artportalen, rarest first
 * (`past-sightings.ts`). One list in two columns, with no subheadings: since
 * 2026-11-16 there is only one kind of bird in it. The newest year stands in
 * the date column, the bird with its chip, the days under it.
 */
interface Props {
  birds: PastSpecies[]
  /** Taxon id → species page slug (`taxonSlugs`). */
  slugs: Map<number, string>
}

const { birds, slugs } = Astro.props

const day = (date: string) => formatDate(`${date}T12:00:00Z`, "short")
const and = (parts: string[]) =>
  parts.length <= 1 ? parts.join("") : `${parts.slice(0, -1).join(", ")} och ${parts.at(-1)}`
const MAX_DATES = 4
const dates = (bird: PastSpecies) => {
  // The newest year stands in the date column already; the older ones need theirs,
  // after "även", so "1994: 13 nov, även 16 nov 1986" doesn't read as one span.
  const [newest, ...older] = bird.sightings.slice(0, MAX_DATES)
  if (!newest) return ""
  const earlier = older.map((one) => `${day(one.date)} ${one.year}`)
  const more = bird.sightings.length - 1 - earlier.length
  if (more > 0) earlier.push(`${more} år till`)
  return earlier.length > 0 ? `${day(newest.date)}, även ${and(earlier)}` : day(newest.date)
}
---

{
  birds.length > 0 && (
    <div class="flex flex-col gap-6">
      <Register columns={2}>
        {birds.map((bird) => (
          <Entry
            when={String(bird.sightings[0]?.year ?? "")}
            datetime={bird.sightings[0]?.date}
            title={bird.name}
            href={slugs.has(bird.taxonId) ? speciesHref(slugs.get(bird.taxonId) as string) : null}
            rarity={bird.rarity}
            notes={[dates(bird)]}
          />
        ))}
      </Register>
      <p class="type-meta text-muted-foreground measure leading-relaxed">
        Sällsynta fåglar som setts i kommunen en vecka före eller efter dagens datum tidigare år, enligt Artportalen.
        Siffran är artens prefix på klubbens larmlista.
      </p>
    </div>
  )
}
