---
/**
 * A section's name and, beside it, the one link to the rest of it — "Alla
 * larm", "Hela programmet" (docs/design.md, "Tidskriften"). The size of the
 * heading carries the hierarchy; there is no label above it and no rule.
 *
 * In a narrow box the link always sits under the heading, so every section
 * there reads the same whether or not its name leaves room beside it; in a box
 * of 28rem or more it sits at the far edge. The box is the heading's own
 * (a container query), not the window: a phone, and a third of the home page's
 * bird row, are both narrow (docs/design.md, "Spalterna"). A `note` (a count)
 * sits beside the heading, and the `lead` slot is the short muted line under it
 * that says what the section holds.
 */

interface Props {
  /** For the section's `aria-labelledby`. */
  id: string
  href?: string
  link?: string
  note?: string | null
  /**
   * Keep the link's row height with no link, so two sections side by side
   * (`ObsarPair`) start their lists on one line whether or not each has a link.
   */
  reserveLink?: boolean
}

const { id, href, link, note, reserveLink = false } = Astro.props
---

<div class="@container flex flex-col gap-2">
  <div class="flex flex-col @md:flex-row @md:flex-wrap @md:items-baseline @md:justify-between @md:gap-x-6">
    <div class="flex flex-wrap items-baseline gap-x-3">
      <h2 id={id} class="type-section"><slot /></h2>
      {note && <p class="type-label">{note}</p>}
    </div>
    {
      href && link ? (
        <a href={href} class="action-link">
          {link}
        </a>
      ) : (
        /* The link's box with nothing in it, so the heading sits where a link
           beside it would put it: for sections side by side from lg. */
        reserveLink && (
          <span aria-hidden="true" class="invisible hidden min-h-11 lg:@md:flex">
            &nbsp;
          </span>
        )
      )
    }
  </div>
  {Astro.slots.has("lead") && <p class="text-muted-foreground measure"><slot name="lead" /></p>}
</div>
