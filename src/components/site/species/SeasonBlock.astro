---
import Entry from "@/components/site/obsar/Entry.astro"
import RegisterGroup from "@/components/site/obsar/RegisterGroup.astro"
import RegisterSet from "@/components/site/obsar/RegisterSet.astro"
import { SEASON_NOTE, type ThisWeek } from "@/lib/season"
import { speciesHref } from "@/lib/species"
import { dayOfYearLabel } from "@/lib/species-page"
import { formatDate } from "@/lib/stockholm-time"

/**
 * "Så här års" (docs/design.md, "Så här års"): the birds that usually
 * arrive in the kommun, or leave it, within two weeks of today, from twenty years of
 * Artportalen, and how this year is going. A `RegisterSet` like the other bird
 * sections, with no lead: a sentence would only name the birds the lists name.
 * The usual day stands in the date column. Nothing renders when neither list
 * has a bird.
 */
interface Props {
  week: ThisWeek
  /** Taxon id → species page slug (`taxonSlugs`). */
  slugs: Map<number, string>
  /** The heading's level: 2 on the home page, 2 on /arter too, but a caller may nest it. */
  headingId: string
  /** Its note under the lists; off where the caller sets `SEASON_NOTE` itself (the home page's row). */
  note?: boolean
}

const { week, slugs, headingId, note = true } = Astro.props
const { arriving, leaving } = week

const short = (date: string) => formatDate(`${date}T12:00:00Z`, "short")
---

{
  (arriving.length > 0 || leaving.length > 0) && (
    <RegisterSet>
      {arriving.length > 0 && (
        <RegisterGroup id={`${headingId}-kommer`} label="Brukar komma nu">
          {arriving.map((bird) => (
            <Entry
              when={dayOfYearLabel(bird.day)}
              title={bird.name}
              href={slugs.has(bird.id) ? speciesHref(slugs.get(bird.id) as string) : null}
              notes={[
                bird.thisYear
                  ? bird.kind === "winter"
                    ? `Tillbaka i höst, senast sedd ${short(bird.thisYear)}`
                    : `I år kom den första ${short(bird.thisYear)}`
                  : bird.kind === "winter"
                    ? "Inte sedd igen i höst än"
                    : "Inte sedd i år än",
              ]}
            />
          ))}
        </RegisterGroup>
      )}
      {leaving.length > 0 && (
        <RegisterGroup id={`${headingId}-lamnar`} label="Brukar lämna nu">
          {leaving.map((bird) => (
            <Entry
              when={dayOfYearLabel(bird.day)}
              title={bird.name}
              href={slugs.has(bird.id) ? speciesHref(slugs.get(bird.id) as string) : null}
              notes={[bird.thisYear ? `Senast sedd i år ${short(bird.thisYear)}` : "Inte sedd i år"]}
            />
          ))}
        </RegisterGroup>
      )}
      {note && <Fragment slot="note">{SEASON_NOTE}</Fragment>}
    </RegisterSet>
  )
}
