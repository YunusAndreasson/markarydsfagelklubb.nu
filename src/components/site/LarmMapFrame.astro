---
import type { LarmMapLokal, LarmMapProps } from "@/components/site/larm-map.client"
import MapBox from "@/components/site/MapBox.astro"
import type { LarmPin } from "@/lib/larm-map"
// Leaflet's own sheet first, so map.css overrides it.
import "leaflet/dist/leaflet.css"
import "@/styles/map.css"

/**
 * The larm map's frame (docs/design.md, "Larm på kartan"): the box, sized
 * before the map draws so the page doesn't shift as the tiles arrive, and the
 * text a reader without JavaScript gets instead.
 */

interface Props {
  pins: LarmPin[]
  lokal?: LarmMapLokal | null
  /** What the map shows, for the no-JavaScript line. */
  fallback: string
  /** Aspect and width. */
  class?: string
}

const { pins, lokal = null, fallback, class: className = "" } = Astro.props
const props: LarmMapProps = { pins, lokal }
---

{/* Drawn by larm-map.client.ts when it nears the screen. */}
<MapBox kind="larm" data={props} fallback={fallback} class={className} />

<script>
  import { mountLarmMaps } from "./larm-map.client"

  mountLarmMaps()
</script>
