---
import type { ChartData } from "@/lib/charts/options"

/**
 * A figure in the reading flow (docs/design.md, "Obsar och statistik"): the
 * server's SVG first, the interactive chart over it when it scrolls into view,
 * and a caption that says in words what to see, so the figure reads with no
 * script and to a screen reader.
 *
 * `inset` pads the SVG to where the chart's plot area will be, so the canvas
 * lands on top of it rather than beside it.
 */
interface Props {
  chart: ChartData
  /** Server-drawn SVG; omit for figures whose first paint is the caption alone. */
  fallback?: string
  /** Classes that size the box, e.g. "aspect-[4/3] sm:aspect-[16/7]"; or a fixed height. */
  box?: string
  height?: string
  inset?: string
  /**
   * The series' key, above the box. Plain HTML, so it reads with no script and
   * names each line where end labels would collide.
   */
  legend?: LegendItem[]
  class?: string
}

type LegendItem = { label: string; color: string; kind?: "line" | "band"; weight?: number }

const { chart, fallback, box, height, inset = "0", legend, class: className } = Astro.props
---

<figure class:list={["chart-figure flex flex-col gap-3", className]}>
  {
    legend && legend.length > 0 && (
      <ul class="type-meta text-muted-foreground flex flex-wrap gap-x-5 gap-y-1" aria-hidden="true">
        {legend.map((item) => (
          <li class="flex items-center gap-2">
            {item.kind === "band" ? (
              <span class="inline-block size-3 rounded-[2px]" style={{ background: item.color }} />
            ) : (
              <span
                class="inline-block w-5 rounded-full"
                style={{ background: item.color, height: `${item.weight ?? 2}px` }}
              />
            )}
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  <div
    data-chart
    class:list={["relative w-full", box]}
    style={{ height }}
  >
    {fallback && <div class="chart-fallback absolute" style={{ inset }} set:html={fallback} />}
    {/* Filled by obsar-chart.client.ts when it nears the screen. */}
    <div data-obsar-chart data-props={JSON.stringify(chart)} class="absolute inset-0" aria-hidden="true"></div>
  </div>
  <figcaption class="text-muted-foreground measure-caption leading-relaxed text-pretty">
    <slot />
  </figcaption>
</figure>

<script>
  import { mountObsarCharts } from "./obsar-chart.client"

  mountObsarCharts()
</script>

<style is:global>
  .chart-fallback {
    transition: opacity 200ms ease-out;
  }
  [data-chart][data-ready] .chart-fallback {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-fallback {
      transition: none;
    }
  }
</style>
