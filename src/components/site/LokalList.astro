---
import type { LokalSummary } from "@/lib/lokal"
import { registerLetter } from "@/lib/lokal"
import { formatDate, isoDateTime, stockholmYear } from "@/lib/stockholm-time"

/**
 * The club's lokaler as a register (docs/design.md, "Lokaler"): the index at the
 * back of the book, and also the map's accessible equivalent, carrying every
 * lokal as an ordinary link. In columns of the container's width, since a place
 * name is short; one column of 61 was the page's longest scroll for the least
 * text.
 *
 * A lokal nobody has larmed from prints no tally at all, the way a common bird
 * prints no rarity: the silence is the information.
 */

interface Props {
  lokaler: LokalSummary[]
  /** Alphabetical groups under their letter. Off for a list in another order. */
  letters?: boolean
}

const { lokaler, letters = true } = Astro.props
const thisYear = stockholmYear(new Date())

/** "12 sep." this year, "12 sep. 2025" when it isn't — the site's rule everywhere. */
const lastSeen = (at: string): string => {
  const year = stockholmYear(at)
  const date = formatDate(at, "short")
  return year === thisYear ? date : `${date} ${year}`
}

const groups: { letter: string | null; lokaler: LokalSummary[] }[] = []
for (const lokal of lokaler) {
  const letter = letters ? registerLetter(lokal.name) : null
  const last = groups.at(-1)
  // Without letters each lokal is its own group, so the columns can break anywhere.
  if (last && letter && last.letter === letter) last.lokaler.push(lokal)
  else groups.push({ letter, lokaler: [lokal] })
}
---

<div class="columns-1 gap-x-10 sm:columns-2 lg:columns-3">
  {
    groups.map((group) => (
      <div class:list={["break-inside-avoid", group.letter ? "mb-6" : "mb-3"]}>
        {/* With one column on a phone, a lone "A" above "Agghult/Traryd" tells a
            reader nothing they can't see in the name, so it goes away. */}
        {group.letter && (
          <p class="type-meta text-muted-foreground mb-2 hidden sm:block" aria-hidden="true">
            {group.letter}
          </p>
        )}
        <ul class="flex flex-col gap-3">
          {group.lokaler.map((lokal) => (
            <li class="flex flex-col gap-0.5 break-inside-avoid">
              <a href={`/lokaler/${lokal.slug}`} class="type-item decoration-primary w-fit underline-offset-4 hover:underline">
                {lokal.name}
              </a>
              {lokal.alertCount > 0 && lokal.lastAlertAt && (
                /* On a phone the register is for finding a place; the tallies that
                   matter are in the list of recent ones above it. */
                <p class:list={["type-meta text-muted-foreground flex-wrap gap-x-3", letters ? "hidden sm:flex" : "flex"]}>
                  <span>{lokal.alertCount} larm</span>
                  <span>
                    senast <time datetime={isoDateTime(lokal.lastAlertAt)}>{lastSeen(lokal.lastAlertAt)}</time>
                  </span>
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
