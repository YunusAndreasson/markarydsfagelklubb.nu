---
import type { LokalSummary } from "@/lib/lokal"
import { registerLetter } from "@/lib/lokal"
import type { LokalReports } from "@/lib/lokal-reports"
import { dateParts, formatDate, isoDateTime, yearUnlessThis } from "@/lib/stockholm-time"
import { rapporter } from "@/lib/text"

/**
 * The club's lokaler as a register (docs/design.md, "Lokaler"): the index at the
 * back of the book, and also the map's accessible equivalent, carrying every
 * lokal as an ordinary link. In columns of the container's width, since a place
 * name is short; one column of 61 was the page's longest scroll for the least
 * text.
 *
 * A lokal nobody has larmed from prints no tally at all, the way a common bird
 * prints no rarity: the silence is the information.
 *
 * In the list of recently active lokaler (no letters) each row also names the
 * birds larmed from it lately — the same "Nyss:" line the map's tooltip shows,
 * since this list is that tooltip's accessible twin.
 *
 * `reports` adds Artportalen's last month at each lokal (`lokal-reports.ts`):
 * a count under the larm in the register, and, with `tally="reports"`, the
 * list of the most reported lokaler, which names the species instead.
 */

interface Props {
  lokaler: LokalSummary[]
  /** Alphabetical groups under their letter. Off for a list in another order. */
  letters?: boolean
  /** Each lokal's Artportalen reports this last month, by lokal id. */
  reports?: Map<number, LokalReports>
  /** What a row counts: the larm (the default) or the Artportalen reports. */
  tally?: "larm" | "reports"
}

const { lokaler, letters = true, reports = new Map(), tally = "larm" } = Astro.props
const species = (names: readonly string[]) =>
  names.map((name) => name.toLocaleLowerCase("sv")).join(", ")
const now = new Date()

/** "12 sep" this year, "12 sep 2025" when it isn't — the site's rule everywhere. */
const lastSeen = (at: string): string =>
  dateParts(at, "row", { year: yearUnlessThis(at, now) }).join(" ")

const groups: { letter: string | null; lokaler: LokalSummary[] }[] = []
for (const lokal of lokaler) {
  const letter = letters ? registerLetter(lokal.name) : null
  const last = groups.at(-1)
  // Without letters each lokal is its own group, so the columns can break anywhere.
  if (last && letter && last.letter === letter) last.lokaler.push(lokal)
  else groups.push({ letter, lokaler: [lokal] })
}
---

<div class="columns-1 gap-x-10 sm:columns-2 lg:columns-3">
  {
    groups.map((group) => (
      <div class:list={["break-inside-avoid", group.letter ? "mb-6" : "mb-3"]}>
        {/* With one column on a phone, a lone "A" above "Agghult/Traryd" tells a
            reader nothing they can't see in the name, so it goes away. */}
        {group.letter && (
          <p class="type-label mb-2 hidden sm:block" aria-hidden="true">
            {group.letter}
          </p>
        )}
        <ul class="flex flex-col gap-3">
          {group.lokaler.map((lokal) => {
            const report = reports.get(lokal.id)
            return (
            <li class="flex flex-col gap-0.5 break-inside-avoid">
              <a href={`/lokaler/${lokal.slug}`} class="type-item title-link w-fit">
                {lokal.name}
              </a>
              {tally === "reports" && report && (
                <>
                  <p class="type-label flex flex-wrap gap-x-3">
                    <span>{rapporter(report.count)}</span>
                    <span>
                      senast{" "}
                      <time datetime={report.last}>{lastSeen(report.last)}</time>
                    </span>
                  </p>
                  <p class="type-label">
                    {species(report.species)}
                  </p>
                </>
              )}
              {tally === "larm" && lokal.alertCount > 0 && lokal.lastAlertAt && (
                /* On a phone the register is for finding a place; the tallies that
                   matter are in the list of recent ones above it. */
                <p class:list={["type-label flex-wrap gap-x-3", letters ? "hidden sm:flex" : "flex"]}>
                  <span>{lokal.alertCount} larm</span>
                  <span>
                    senast <time datetime={isoDateTime(lokal.lastAlertAt)}>{lastSeen(lokal.lastAlertAt)}</time>
                  </span>
                </p>
              )}
              {tally === "larm" && letters && report && (
                <p class="type-label hidden sm:block">
                  {rapporter(report.count)} i Artportalen
                </p>
              )}
              {tally === "larm" && !letters && lokal.recentSpecies.length > 0 && (
                <p class="type-label">
                  Nyss: {species(lokal.recentSpecies)}
                </p>
              )}
            </li>
            )
          })}
        </ul>
      </div>
    ))
  }
</div>
