---
import ArticleTile from "@/components/site/ArticleTile.astro"
import type { ArticleTeaser } from "@/lib/public-content"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

/**
 * One row of up to three articles with their photos (docs/design.md,
 * "Tidskriften", "Spalterna"), never a second row; what doesn't fit is the dated
 * list below. From lg the row is a `trio`, so at full width its third tile stands
 * on the aside's line, as the rows below and the sections above do.
 *
 * `splitFeatured` hands over only articles with a photo, so a tile never has
 * a hole where its picture should be.
 *
 * `besideLead`: the first tile is the story beside a lead without a photo
 * (`HomeLead`), shown there from lg. Here it hides from lg and a fourth tile
 * takes its place, so below lg nothing moves. Both copies carry the same
 * view-transition name (`firstTransition`): only one is ever displayed, and an
 * element that isn't rendered takes no part in a transition.
 */

interface Props {
  articles: ArticleTeaser[]
  /** h2 when the tiles are the section, h3 under a section heading. */
  headingLevel?: 2 | 3
  /** The home page names the category; "Mer i Referat" already has. */
  showCategory?: boolean
  besideLead?: boolean
  firstTransition?: string
}

const {
  articles,
  headingLevel = 3,
  showCategory = false,
  besideLead = false,
  firstTransition,
} = Astro.props

// One set per page, shared by every list on it (lib/view-transition.ts).
const taken = takenTransitionNames(Astro.locals)
---

<ol
  class:list={[
    "trio gap-y-10 md:max-lg:grid-cols-3 md:max-lg:gap-x-6",
    // Below md the tiles after the first are rows: closer together, like the list.
    "max-md:gap-y-8",
    besideLead && "lg:[&>li:first-child]:hidden max-lg:[&>li:nth-child(4)]:hidden",
    // Only the story beside the lead: nothing is left for this row from lg.
    besideLead && articles.length === 1 && "lg:hidden",
  ]}
>
  {
    articles.map((article, index) => (
      <ArticleTile
        article={article}
        headingLevel={headingLevel}
        showCategory={showCategory}
        compact={index > 0}
        sizes={
          index > 0
            ? "(min-width: 72rem) 21rem, (min-width: 48rem) 30vw, 7rem"
            : "(min-width: 72rem) 21rem, (min-width: 48rem) 30vw, 100vw"
        }
        transition={besideLead && index === 0 ? firstTransition : transitionName(taken, "artikel", article.id)}
      />
    ))
  }
</ol>
