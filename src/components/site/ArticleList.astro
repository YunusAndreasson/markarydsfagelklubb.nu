---
import MarginDate from "@/components/site/MarginDate.astro"
import Print from "@/components/site/Print.astro"
import type { ArticleTeaser } from "@/lib/public-content"
import { formatDate, isoDateTime, listYear } from "@/lib/stockholm-time"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

/**
 * The dated list: the date in the margin, the title and opening line, and the
 * article's photo as a small 3:2 print on the right (docs/design.md,
 * "Tidskriften"), in the outer margin from lg up ("Uppslaget"). An article
 * without a photo simply has no print — in practice those are short notices,
 * and a grey box would only say "no picture".
 */

interface Props {
  articles: ArticleTeaser[]
  /** h2 on a list page, h3 under a section heading. */
  headingLevel?: 2 | 3
  /**
   * "changes": print the year under the first entry of each year, like turning
   * a notebook's pages. "other-years": only when it isn't this year.
   */
  years?: "changes" | "other-years"
}

const { articles, headingLevel = 2, years = "changes" } = Astro.props
const Heading = headingLevel === 2 ? "h2" : "h3"

const yearLabel = (index: number) => listYear(articles, index, (one) => one.published_at, years)

// One set per page, shared by every list on it (lib/view-transition.ts).
const taken = takenTransitionNames(Astro.locals)
---

<ol class="flex flex-col gap-8">
  {
    articles.map((article, index) => {
      const year = yearLabel(index)
      // Neighbours sharing a photo read as a mistake, so only the first shows it.
      const image = article.image?.src === articles[index - 1]?.image?.src ? null : article.image
      return (
        <li class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 gap-y-1 md:grid-cols-[var(--track-margin)_minmax(0,1fr)_auto] md:gap-x-0 lg:spread">
          <MarginDate
            datetime={isoDateTime(article.published_at)}
            parts={[formatDate(article.published_at, "short"), year]}
            class="lg:in-margin"
          />
          <div class="col-start-1 flex flex-col gap-1 self-baseline md:col-start-2 md:row-start-1 lg:in-text">
            <Heading class="type-item">
              <a href={`/artiklar/${article.slug}`} class="title-link">
                {article.title}
              </a>
            </Heading>
            {article.standfirst && <p class="text-muted-foreground line-clamp-2 leading-relaxed">{article.standfirst}</p>}
          </div>
          {image && (
            /* About as tall as the title and two lines of excerpt, so a row with
               a print keeps the rhythm of a row without. */
            <Print
              href={`/artiklar/${article.slug}`}
              src={image.src}
              srcset={image.srcset}
              sizes="8rem"
              width={image.width}
              height={image.height}
              transition={transitionName(taken, "artikel", article.id)}
              class="col-start-2 row-span-2 row-start-1 w-28 self-start md:col-start-3 md:row-span-1 md:w-38 md:pl-6 lg:in-aside lg:w-32 lg:pl-0"
            />
          )}
        </li>
      )
    })
  }
</ol>
