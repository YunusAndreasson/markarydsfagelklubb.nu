---
import { renderBody } from "@/lib/article-body"
import { mediaFallbackUrl, mediaSrcset } from "@/lib/media"
import type { FullArticle } from "@/lib/public-content"
import { formatDate, isoDateTime, stockholmYear } from "@/lib/stockholm-time"

interface Props {
  article: FullArticle
}

// The article page and the admin's preview render the same thing.
const { article } = Astro.props
const published = article.published_at
---

{/* The notebook's spread (docs/design.md, "Uppslaget"): the title over the
    text track; a cover across the margin and the text; the date and byline in
    the margin beside the text, never in a row of their own; and the outer
    margin, when the page fills it, beside the cover and the text together, in
    view while the text scrolls. On a phone the aside follows the text. */}
<article class="flex flex-col gap-8">
  <header class="spread">
    <div class="in-text flex flex-col gap-4">
      <nav aria-label="Du är här" class="type-meta text-muted-foreground">
        <a href="/artiklar" class="crumb">Artiklar</a>
        {
          article.category && (
            <>
              <span aria-hidden="true"> / </span>
              <a href={`/artiklar/kategori/${article.category.slug}`} class="crumb">
                {article.category.name}
              </a>
            </>
          )
        }
      </nav>
      <h1 class="type-title">{article.title}</h1>
      {article.excerpt && <p class="type-ingress text-muted-foreground">{article.excerpt}</p>}
    </div>
  </header>

  <div class="spread gap-y-8">
    {
      article.cover && (
        <img
          src={mediaFallbackUrl(article.cover)}
          srcset={mediaSrcset(article.cover)}
          sizes="(min-width: 48rem) 45rem, 100vw"
          width={article.cover.width}
          height={article.cover.height}
          alt={article.cover.alt}
          fetchpriority="high"
          class="in-wide h-auto w-full rounded-[4px] lg:row-start-1"
        />
      )
    }

    <div class:list={["in-margin type-meta text-muted-foreground -mt-4 flex flex-col md:mt-0 md:pt-1", article.cover ? "md:row-start-2" : "md:row-start-1"]}>
      {
        published && (
          <time datetime={isoDateTime(published)} class="flex flex-wrap gap-x-1 md:flex-col">
            <span>{formatDate(published, "weekdayName")}</span>
            <span>{formatDate(published, "dayMonth")}</span>
            <span>{stockholmYear(published)}</span>
          </time>
        )
      }
      {article.author_name && <span class="mt-1">Text: {article.author_name}</span>}
    </div>

    <div class:list={["in-text content", article.cover ? "md:row-start-2" : "md:row-start-1"]} set:html={renderBody(article.body_html)} />

    {
      Astro.slots.has("aside") && (
        <div class:list={["in-aside self-stretch max-lg:mt-8", article.cover ? "lg:row-span-2 lg:row-start-1" : "lg:row-start-1"]}>
          <slot name="aside" />
        </div>
      )
    }
  </div>
</article>
