---
import MarginDate from "@/components/site/MarginDate.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import PhotoViewer from "@/components/site/PhotoViewer.astro"
import { photoLink, renderBody } from "@/lib/article-body"
import type { FullArticle } from "@/lib/public-content"
import { formatDate, isoDateTime, stockholmYear } from "@/lib/stockholm-time"
import { liftHero } from "@/lib/teaser"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

interface Props {
  article: FullArticle
}

// The article page and the admin's preview render the same thing.
const { article } = Astro.props
const published = article.published_at
// The photo the lists show opens the article (docs/design.md, "Lupen"), and
// leaves the body so it doesn't print twice.
const { hero, body } = liftHero(article.cover, article.body_html)
// Named before the aside's list asks, so the article's own photo gets the name.
const heroTransition = transitionName(takenTransitionNames(Astro.locals), "artikel", article.id)
// The hero opens in the viewer like a photo in the body.
const heroLink = hero && photoLink(hero.src, hero.srcset, hero.width, hero.height)
---

{/* The notebook's spread (docs/design.md, "Uppslaget"): the title over the
    text track; a cover across the margin and the text; the date and byline in
    the margin beside the text, never in a row of their own; and the outer
    margin, when the page fills it, beside the cover and the text together, in
    view while the text scrolls. On a phone the aside follows the text. */}
<article class="page-stack">
  <PageHeader
    title={article.title}
    crumbs={[
      { href: "/artiklar", label: "Artiklar" },
      ...(article.category ? [{ href: `/artiklar/kategori/${article.category.slug}`, label: article.category.name }] : []),
    ]}
    ingress={article.excerpt}
  />

  <div class="spread gap-y-8" data-photos>
    {
      hero && (
        <figure class:list={[hero.wide ? "in-wide" : "in-text", "flex flex-col gap-2.5 lg:row-start-1"]}>
          <a
            class:list={["photo block cursor-zoom-in rounded-[4px]", hero.wide ? "w-full" : "w-fit max-w-full"]}
            href={heroLink?.href ?? hero.src}
            data-pswp-width={heroLink?.width}
            data-pswp-height={heroLink?.height}
          >
            <img
              src={hero.src}
              srcset={hero.srcset || undefined}
              sizes={hero.wide ? "(min-width: 48rem) 45rem, 100vw" : "(min-width: 40rem) 38rem, 100vw"}
              width={hero.width || undefined}
              height={hero.height || undefined}
              alt={hero.alt}
              fetchpriority="high"
              style={heroTransition}
              class:list={["rounded-[4px]", hero.wide ? "h-auto w-full" : "h-auto max-h-[75svh] w-auto max-w-full"]}
            />
          </a>
          {hero.caption && (
            <figcaption class:list={["type-caption", hero.wide && "at-text measure"]} set:html={hero.caption} />
          )}
        </figure>
      )
    }

    {
      (published || article.author_name) && (
        <MarginDate
          datetime={published && isoDateTime(published)}
          parts={published ? [formatDate(published, "weekdayName"), formatDate(published, "dayMonth"), stockholmYear(published)] : []}
          class:list={["in-margin max-md:-mt-4", hero ? "md:row-start-2" : "md:row-start-1"]}
        >
          {article.author_name && <span>Text: {article.author_name}</span>}
        </MarginDate>
      )
    }

    <div class:list={["in-text content self-baseline", hero ? "md:row-start-2" : "md:row-start-1"]} set:html={renderBody(body)} />

    {
      Astro.slots.has("aside") && (
        <div class:list={["in-aside self-stretch max-lg:mt-8", hero ? "lg:row-span-2 lg:row-start-1" : "lg:row-start-1"]}>
          <slot name="aside" />
        </div>
      )
    }
  </div>
</article>

<PhotoViewer />
