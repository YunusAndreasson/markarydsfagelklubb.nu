---
/**
 * One note in the outer margin: a quiet label and what it says. The label is a
 * heading so a screen reader can move between notes; it is set as meta, since the
 * aside must never outrank the text beside it.
 */
interface Props {
  label: string
  headingLevel?: 2 | 3
}

const { label, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}` as const
---

<section class="flex flex-col gap-1.5">
  <Heading class="type-meta text-muted-foreground">{label}</Heading>
  <div class="flex flex-col gap-1">
    <slot />
  </div>
</section>
