---
import Disclosure from "@/components/site/Disclosure.astro"

/**
 * More larm behind one tap (docs/design.md, "Stora dagar"). The summary starts
 * at the text's edge, over rows whose dates take the margin.
 */

interface Props {
  count: number
}

const { count } = Astro.props
---

<Disclosure label={`Visa ${count} larm till`} openLabel="Visa färre" summaryClass="at-text">
  <slot />
</Disclosure>
