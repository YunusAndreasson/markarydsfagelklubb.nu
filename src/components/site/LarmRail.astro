---
import type { PublicAlert } from "@/lib/alert-dto"
import { alertPhotoSrc, alertPhotoSrcset } from "@/lib/alert-photo"
import { isRare, RARITY_WORTH_SAYING, rarityLabel } from "@/lib/rarity"
import { dayLabel, formatDate, isoDateTime } from "@/lib/stockholm-time"

/**
 * The newest larm photos as a row of prints, the caption under each — a
 * contact sheet of what members have seen (docs/design.md, "Tidskriften").
 *
 * 3:2, the shape of the members' camera photos, cropped by CSS from the feed's
 * files. The first rail was 4:5, which made the bird larger but cut most
 * photos to half their width, and with it heads and tails. Below the
 * breakpoint the row scrolls sideways inside itself, snapping print by print,
 * with no script; the page never scrolls sideways.
 *
 * Only larm with a photo belong here: `splitLarm` picks them and lists the
 * rest beside the rail, so nothing is hidden.
 */

interface Props {
  alerts: PublicAlert[]
  /** The prints' rendered width at each breakpoint, for the browser's choice of file. */
  sizes: string
  /**
   * "five": the home page — a row of five from `lg`, a rail below.
   * "three": under a larm, in the reading column — a row of three from `md`.
   */
  layout: "five" | "three"
}

const { alerts, sizes, layout } = Astro.props
const now = new Date()
---

<ol
  class:list={[
    "-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:scroll-px-6 sm:px-6",
    layout === "five"
      ? "lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0 lg:pb-0"
      : "md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0",
  ]}
>
  {
    alerts.map(
      (alert) =>
        alert.photoUrl && (
          <li
            class:list={[
              "flex w-[64vw] max-w-72 shrink-0 snap-start flex-col gap-3",
              layout === "five" ? "md:w-72 lg:w-auto lg:max-w-none" : "md:w-auto md:max-w-none",
            ]}
          >
            <a href={`/larm/${alert.id}`} tabindex="-1" aria-hidden="true">
              <img
                src={alertPhotoSrc(alert.photoUrl, "480")}
                srcset={alertPhotoSrcset(alert.photoUrl, "feed")}
                sizes={sizes}
                width="480"
                height="320"
                alt=""
                loading="lazy"
                decoding="async"
                class="bg-muted aspect-3/2 w-full rounded-[4px] object-cover"
              />
            </a>
            <div class="flex flex-col gap-0.5">
              <h3 class="flex flex-wrap items-baseline gap-x-2 leading-snug font-semibold text-pretty">
                <a href={`/larm/${alert.id}`} class="decoration-primary underline-offset-4 hover:underline">
                  {alert.species}
                </a>
                {alert.count !== null && alert.count > 1 && (
                  <span class="text-muted-foreground font-normal">{alert.count} ex.</span>
                )}
              </h3>
              {alert.rarity <= RARITY_WORTH_SAYING && (
                <p class:list={["type-meta", isRare(alert.rarity) ? "text-rarity" : "text-muted-foreground"]}>
                  {rarityLabel(alert.rarity)}
                </p>
              )}
              <p class="type-meta text-muted-foreground">{alert.place}</p>
              <p class="type-meta text-muted-foreground">
                <time datetime={isoDateTime(alert.observedAt)}>
                  {dayLabel(alert.observedAt, now)} {formatDate(alert.observedAt, "clock")}
                </time>
              </p>
            </div>
          </li>
        )
    )
  }
</ol>
