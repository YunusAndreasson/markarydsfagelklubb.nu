---
import LarmTitle from "@/components/site/LarmTitle.astro"
import Print from "@/components/site/Print.astro"
import type { PublicAlert } from "@/lib/alert-dto"
import { alertPhotoSrc, alertPhotoSrcset } from "@/lib/alert-photo"
import { isRare, RARITY_WORTH_SAYING, rarityLabel } from "@/lib/rarity"
import { dayLabel, formatDate, isoDateTime } from "@/lib/stockholm-time"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

/**
 * The newest larm photos as a row of prints, the caption under each — a
 * contact sheet of what members have seen (docs/design.md, "Tidskriften").
 *
 * 3:2, the shape of the members' camera photos, cropped by CSS from the feed's
 * files. The first rail was 4:5, which made the bird larger but cut most
 * photos to half their width, and with it heads and tails. Below the
 * breakpoint the row scrolls sideways inside itself, snapping print by print,
 * with no script; the page never scrolls sideways.
 *
 * Only larm with a photo belong here: `latestPrints` or `splitLarm` picks them.
 * On a Gran band `surface-gran` recolours it through the tokens.
 */

interface Props {
  alerts: PublicAlert[]
  /** The prints' rendered width at each breakpoint, for the browser's choice of file. */
  sizes: string
  /**
   * "five": the home page — a row of five from `lg`, a rail below.
   * "three": under a larm, in the reading column — a row of three from `md`.
   * "few": one or two prints, beside the home page band's sentence from `md`.
   */
  layout: "five" | "three" | "few"
  /** Species and when only, for the home page's band; the place is one tap away. */
  brief?: boolean
  /** h3 under a section heading (the default); h2 where the rail is the section's only list. */
  headingLevel?: 2 | 3
}

const { alerts, sizes, layout, brief = false, headingLevel = 3 } = Astro.props
const now = new Date()

// One set per page, shared by every list on it (lib/view-transition.ts).
const taken = takenTransitionNames(Astro.locals)
---

<ol
  class:list={[
    // `relative`: the containing block for the prints' sr-only text, so the scroll
    // clips it. Without it that text sat at its static place far off to the right
    // and made the whole page scroll sideways on a phone (1166 px at 390).
    "relative -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:scroll-px-6 sm:px-6",
    layout === "five" && "lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0 lg:pb-0",
    layout === "three" && "md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0",
    layout === "few" && "md:mx-0 md:overflow-visible md:px-0 md:pb-0",
  ]}
>
  {
    alerts.map(
      (alert) =>
        alert.photoUrl && (
          <li
            class:list={[
              "flex w-[64vw] max-w-72 shrink-0 snap-start flex-col gap-3",
              layout === "five" && "md:w-72 lg:w-auto lg:max-w-none",
              layout === "three" && "md:w-auto md:max-w-none",
              layout === "few" && "md:w-44",
            ]}
          >
            <Print
              href={`/larm/${alert.id}`}
              src={alertPhotoSrc(alert.photoUrl, "480")}
              srcset={alertPhotoSrcset(alert.photoUrl, "feed")}
              sizes={sizes}
              width={480}
              height={320}
              transition={transitionName(taken, "larm", alert.id)}
            />
            <div class="flex flex-col gap-0.5">
              <LarmTitle
                species={alert.species}
                count={alert.count}
                rarity={alert.rarity}
                href={`/larm/${alert.id}`}
                level={headingLevel}
                word={false}
              />
              {alert.rarity <= RARITY_WORTH_SAYING && (
                <p class:list={["type-meta", isRare(alert.rarity) ? "text-rarity" : "text-muted-foreground"]}>
                  {rarityLabel(alert.rarity)}
                </p>
              )}
              {!brief && <p class="type-label">{alert.place}</p>}
              <p class="type-label">
                <time datetime={isoDateTime(alert.observedAt)}>
                  {dayLabel(alert.observedAt, now)} {formatDate(alert.observedAt, "clock")}
                </time>
              </p>
            </div>
          </li>
        )
    )
  }
</ol>
