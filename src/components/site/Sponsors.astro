---
import balkheds from "@/assets/sponsors/balkheds.webp"
import derome from "@/assets/sponsors/derome.webp"
import gransbygden from "@/assets/sponsors/gransbygden.webp"
import sparbank from "@/assets/sponsors/sparbank.webp"
import { cn } from "@/lib/utils"

/**
 * The club's sponsors as a credit line, "Sponsrad av" and their logos
 * (docs/design.md, "Sponsorer"). Same sponsors, order and links as the
 * WordPress sidebar.
 *
 * The logos arrive in four styles: three white for WordPress's black sidebar,
 * one blue on a white box. Each file here is an alpha mask of the logo's ink
 * (trimmed, at most 72 px tall), so CSS paints all four in one token colour,
 * the same in both themes, and the site's colour stays on what it is for.
 * Heights are set by eye so the four weigh the same: equal height made the bold
 * wordmarks shout, equal area made the bank's thin serif disappear.
 *
 * `rel="sponsored"` is how search engines are told a link was paid for.
 */

interface Props {
  class?: string
}

const SPONSORS = [
  {
    name: "Markaryds Sparbank",
    href: "https://www.markarydssparbank.se/",
    logo: sparbank,
    rem: 1.625,
  },
  { name: "Balkheds", href: "https://balkheds.se/", logo: balkheds, rem: 1.5 },
  { name: "Gränsbygden", href: "https://www.gransbygden.se/", logo: gransbygden, rem: 1.625 },
  {
    name: "Derome",
    href: "https://www.derome.se/handla-online/kontakt/hitta-till-oss/dbi-markaryd",
    logo: derome,
    rem: 1.125,
  },
]

const mask = (src: string) => `url(${src}) center / contain no-repeat`

const { class: className } = Astro.props
---

<aside aria-label="Sponsorer" class={cn("flex flex-wrap items-center gap-x-8 gap-y-2", className)}>
  <p class="type-meta text-muted-foreground w-full md:w-auto">Sponsrad av</p>
  <ul class="grid grid-cols-2 items-center gap-x-6 md:flex md:gap-x-8">
    {
      SPONSORS.map((sponsor) => (
        <li>
          <a href={sponsor.href} rel="sponsored" class="group flex min-h-11 w-fit items-center">
            <span class="sr-only">{sponsor.name}</span>
            <span
              aria-hidden="true"
              class="bg-muted-foreground group-hover:bg-foreground block"
              style={`height: ${sponsor.rem}rem; aspect-ratio: ${sponsor.logo.width} / ${sponsor.logo.height}; -webkit-mask: ${mask(sponsor.logo.src)}; mask: ${mask(sponsor.logo.src)}`}
            />
          </a>
        </li>
      ))
    }
  </ul>
</aside>
