---
import Print from "@/components/site/Print.astro"
import type { ArticleTeaser } from "@/lib/public-content"
import { formatDate, isoDateTime, yearUnlessThis } from "@/lib/stockholm-time"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

/**
 * A few articles in the outer margin (docs/design.md, "Uppslaget"): a small
 * print, the date and the title, one line each, so the aside stays shorter than
 * a screen and can stay in view beside the text. Neighbours never share a photo.
 * An article without one leaves the print's place empty, never a grey box, so
 * every title starts at the same edge.
 */
interface Props {
  articles: ArticleTeaser[]
}

const { articles } = Astro.props
const now = new Date()

// One set per page, shared by every list on it (lib/view-transition.ts).
const taken = takenTransitionNames(Astro.locals)
---

<ol class="flex flex-col gap-4">
  {
    articles.map((article, index) => {
      const image = article.image?.src === articles[index - 1]?.image?.src ? null : article.image
      return (
        <li class="grid grid-cols-[5.5rem_minmax(0,1fr)] items-start gap-x-3">
          {image ? (
            <Print
              href={`/artiklar/${article.slug}`}
              src={image.src}
              srcset={image.srcset}
              sizes="5.5rem"
              width={image.width}
              height={image.height}
              transition={transitionName(taken, "artikel", article.id)}
              class="self-start"
            />
          ) : (
            <span aria-hidden="true" />
          )}
          <div class="flex flex-col">
            <time datetime={isoDateTime(article.published_at)} class="type-label">
              {formatDate(article.published_at, "short")}
              {yearUnlessThis(article.published_at, now) && ` ${yearUnlessThis(article.published_at, now)}`}
            </time>
            <a href={`/artiklar/${article.slug}`} class="type-item-aside title-link">
              {article.title}
            </a>
          </div>
        </li>
      )
    })
  }
</ol>
