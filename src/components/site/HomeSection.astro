---
import SectionHeading from "@/components/site/SectionHeading.astro"

/**
 * One section of the home page (docs/design.md, "Startsidan"). Every section
 * lies on the same spread, so the page reads as one notebook rather than a stack
 * of differently built blocks:
 *
 * - the heading starts at the container's left edge, where the content starts
 *   (a register's dates, the tiles, the year's figures), and its one "all of it"
 *   link sits at the far edge, the same on every section;
 * - text goes on the text track (dates in the margin beside it), next steps go in
 *   the outer margin (`Aside`), and only pictures (photos, the jubilee chart) may
 *   take the full width;
 * - the space between sections is this component's, never the page's.
 */
interface Props {
  id: string
  title: string
  href?: string
  link?: string
}

const { id, title, href, link } = Astro.props
---

<section aria-labelledby={id} class="spread mt-16 gap-y-6 md:mt-24 md:gap-y-8">
  <div class="in-full">
    <SectionHeading id={id} href={href} link={link}>{title}</SectionHeading>
  </div>
  <slot />
</section>
