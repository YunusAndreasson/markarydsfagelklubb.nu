---
import ArticleList from "@/components/site/ArticleList.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Pager from "@/components/site/Pager.astro"
import { encodeCursor } from "@/lib/keyset"
import type { ArticlePage } from "@/lib/public-content"

interface Props {
  heading: string
  /** Where "Äldre" and "Nyare" link to: /artiklar or a category's page. */
  basePath: string
  categories: { slug: string; name: string }[]
  /** The category being shown, or null for all. */
  currentCategory: string | null
  page: ArticlePage
  /** The archive at the foot: every year with articles. */
  years?: number[]
  currentYear?: number
}

const {
  heading,
  basePath,
  categories,
  currentCategory,
  page,
  years = [],
  currentYear,
} = Astro.props
const link = (param: "fore" | "efter", cursor: Parameters<typeof encodeCursor>[0]) =>
  `${basePath}?${new URLSearchParams({ [param]: encodeCursor(cursor) })}`
const tab = (active: boolean) => (active ? "page" : undefined)
---

<div class="page-stack">
  <PageHeader title={heading}>
    {
      categories.length > 0 && (
        /* One row that scrolls sideways on a phone, where wrapping took three
           rows of 44 px targets above the first article. The page's heading
           names the current category, so an off-screen tab loses nothing. */
        <nav slot="after" aria-label="Kategorier" class="-mx-4 overflow-x-auto px-4 sm:-mx-6 sm:px-6 md:mx-0 md:overflow-visible md:px-0">
          <ul class="flex w-max gap-x-5 md:w-auto md:flex-wrap">
            <li>
              <a href="/artiklar" aria-current={tab(currentCategory === null)} class="nav-link whitespace-nowrap">
                Alla
              </a>
            </li>
            {categories.map((category) => (
              <li>
                <a
                  href={`/artiklar/kategori/${category.slug}`}
                  aria-current={tab(currentCategory === category.slug)}
                  class="nav-link whitespace-nowrap"
                >
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </PageHeader>

  {
    page.articles.length === 0 ? (
      <EmptyNote>Här finns inga artiklar ännu.</EmptyNote>
    ) : (
      <ArticleList articles={page.articles} headingLevel={2} years="changes" />
    )
  }

  <Pager
    label="Fler artiklar"
    links={[
      page.newer && { href: link("efter", page.newer), label: "Nyare artiklar", rel: "prev" },
      page.older && { href: link("fore", page.older), label: "Äldre artiklar", rel: "next" },
    ]}
  />

  {
    years.length > 0 && (
      <nav aria-labelledby="arkiv" class="flex flex-col gap-2 at-text">
        <h2 id="arkiv" class="type-section">Arkiv</h2>
        <ul class="flex flex-wrap gap-x-5">
          {years.map((year) => (
            <li>
              <a href={`/artiklar/ar/${year}`} aria-current={tab(currentYear === year)} class="nav-link tabular-nums">
                {year}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>
