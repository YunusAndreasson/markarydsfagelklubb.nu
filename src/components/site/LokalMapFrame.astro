---
import LokalMap from "@/components/site/LokalMap"
import type { LokalPin } from "@/lib/lokal"
import type { MapPoint } from "@/lib/lokal-points"
import "@/styles/map.css"

/**
 * The lokal map's frame: the box it fills. Leaflet's runtime DOM is styled by
 * `src/styles/map.css`, imported here and by `LarmMapFrame.astro` so it ships
 * only with the pages that draw a map, never with `global.css`.
 *
 * The box is sized before hydration and carries the muted background, so the
 * tiles fade in rather than pushing the register down the page.
 */

interface Props {
  pins: LokalPin[]
  /** A still of one place, on a lokal's own page. */
  still?: boolean
  /** A lokal's numbered places. */
  points?: MapPoint[]
  /** Tailwind aspect and width; the map is the loud thing on /lokaler and a picture on a lokal page. */
  class?: string
}

const { pins, still = false, points, class: className = "" } = Astro.props
---

<div class:list={["bg-muted relative overflow-hidden rounded-[4px]", className]}>
  <LokalMap pins={pins} still={still} points={points} client:visible />
  <noscript>
    <p class="text-muted-foreground absolute inset-0 flex items-center justify-center p-6 text-center">
      Kartan behöver JavaScript. Alla lokaler står i listan här under.
    </p>
  </noscript>
</div>
