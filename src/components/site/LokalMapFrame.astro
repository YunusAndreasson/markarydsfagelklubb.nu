---
import type { LokalMapProps } from "@/components/site/lokal-map.client"
import MapBox from "@/components/site/MapBox.astro"
import type { LokalPin } from "@/lib/lokal"
import type { MapPoint } from "@/lib/lokal-points"
// Leaflet's own sheet first, so map.css overrides it.
import "leaflet/dist/leaflet.css"
import "@/styles/map.css"

/**
 * The lokal map's frame: the box it fills. Leaflet's runtime DOM is styled by
 * `src/styles/map.css`, imported here and by `LarmMapFrame.astro` so it ships
 * only with the pages that draw a map, never with `global.css`.
 *
 * The box is sized before the map draws and carries the muted background, so the
 * tiles fade in rather than pushing the register down the page.
 *
 * `isolate` keeps Leaflet's panes (z-index 400–1000) inside the frame. Without
 * it they stack against the header (z-20) and cover its open menu.
 */

interface Props {
  pins: LokalPin[]
  /** A still of one place, on a lokal's own page. */
  still?: boolean
  /** A lokal's numbered places. */
  points?: MapPoint[]
  /** What a reader without JavaScript reads in the map's place. */
  fallback?: string
  /** Tailwind aspect and width; the map is the loud thing on /lokaler and a picture on a lokal page. */
  class?: string
}

const {
  pins,
  still = false,
  points,
  fallback = "Kartan behöver JavaScript. Alla lokaler står i listan här under.",
  class: className = "",
} = Astro.props
const props: LokalMapProps = { pins, still, points: points ?? [] }
---

{/* Drawn by lokal-map.client.ts when it nears the screen. */}
<MapBox kind="lokal" data={props} fallback={fallback} class={className} />

<script>
  import { mountLokalMaps } from "./lokal-map.client"

  mountLokalMaps()
</script>
