---
import { publicEventKindLabel } from "@/lib/event-kind"
import {
  deadlineInstant,
  eventStatus,
  eventStatusLabel,
  signupOpen,
  summaryBesideDeadline,
} from "@/lib/event-status"
import type { EventSummary } from "@/lib/public-content"
import { formatDate, isoDateTime } from "@/lib/stockholm-time"

/**
 * One event per row, in the same field-notebook shape as a larm: when it is in
 * the margin, then what it is, then what kind and where (docs/design.md).
 *
 * Two things differ from the larm row, both because the programme is read
 * forwards. The weekday is spelled out, since that is how the club writes its
 * programme ("Lördag 21 februari – Ugglespaning") and how a member decides
 * whether they can come. And no year is printed: the month heading above the
 * list already carries it, so repeating it in the margin would be noise.
 *
 * The date is what a member scans for here, so unlike every other list it is set
 * in ink, with "I dag" or "Pågår" under it when that is the answer. Since
 * Uppslaget (2026-11-14) the day of the month is set large in Alegreya, as on a
 * calendar page: the one list on the site whose content really is dates. On a
 * phone the date keeps a narrow column of its own, so the eye runs down the days.
 */

interface Props {
  events: EventSummary[]
  /** h2 on a month page, h3 under a month heading. */
  headingLevel?: 2 | 3
}

const { events, headingLevel = 2 } = Astro.props
const Heading = headingLevel === 2 ? "h2" : "h3"
const now = new Date()
---

<ol class="flex flex-col gap-7">
  {
    events.map((event) => {
      const kind = publicEventKindLabel(event.kind)
      const status = eventStatusLabel(eventStatus(event, now))
      const deadline = event.signup_deadline && signupOpen(event, now) ? event.signup_deadline : null
      // Not the deadline twice: it has its own line below.
      const summary = event.summary ? summaryBesideDeadline(event.summary, Boolean(deadline)) : ""
      return (
        <li class="margined gap-x-3 max-md:grid-cols-[4.25rem_minmax(0,1fr)] md:gap-x-0">
          <p class="type-meta text-muted-foreground flex flex-col md:in-margin">
            <time datetime={isoDateTime(event.starts_at)} class="flex flex-col">
              <span>{formatDate(event.starts_at, "weekdayName")}</span>
              <span class="font-display text-foreground text-[2.25rem] leading-[1.05] font-bold tabular-nums lining-nums">
                {formatDate(event.starts_at, "day")}
              </span>
              {/* Month and time on one line where the margin is 7rem; stacked in the
                  phone's 4.25rem, where "nov 18:30" wrapped but "jan 08:00" didn't. */}
              <span class="flex md:gap-x-[0.3em] max-md:flex-col">
                <span>{formatDate(event.starts_at, "monthShort")}</span>{" "}
                {!event.all_day && <span>{formatDate(event.starts_at, "clock")}</span>}
              </span>
            </time>
            {status && <span class="text-primary mt-0.5 font-semibold">{status}</span>}
          </p>
          <div class="measure flex flex-col gap-1 pt-[1.15rem] md:in-text">
            <Heading class="type-item">
              <a href={`/kalender/${event.slug}`} class="decoration-primary underline-offset-4 hover:underline">
                {event.title}
              </a>
            </Heading>
            {(kind || event.place) && (
              <p class="text-muted-foreground flex flex-wrap gap-x-3 leading-relaxed">
                {kind && <span>{kind}</span>}
                {event.place && <span>{event.place}</span>}
              </p>
            )}
            {summary && <p class="text-muted-foreground line-clamp-2 leading-relaxed">{summary}</p>}
            {deadline && (
              <p class="text-foreground leading-relaxed font-medium">
                Anmälan senast {formatDate(deadlineInstant(deadline), "dayMonth")}
              </p>
            )}
          </div>
        </li>
      )
    })
  }
</ol>
