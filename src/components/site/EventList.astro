---
import MarginDate from "@/components/site/MarginDate.astro"
import { publicEventKindLabel } from "@/lib/event-kind"
import {
  deadlineInstant,
  eventStatus,
  eventStatusLabel,
  signupOpen,
  summaryBesideDeadline,
} from "@/lib/event-status"
import type { EventSummary } from "@/lib/public-content"
import { dateParts, formatDate, isoDateTime } from "@/lib/stockholm-time"

/**
 * One event per row, in the same field-notebook shape as a larm: when it is in
 * the margin, then what it is, then what kind and where (docs/design.md).
 *
 * Two things differ from the larm row, both because the programme is read
 * forwards. The weekday is spelled out, since that is how the club writes its
 * programme ("Lördag 21 februari – Ugglespaning") and how a member decides
 * whether they can come. And no year is printed: the month heading above the
 * list already carries it, so repeating it in the margin would be noise.
 *
 * The date is a `MarginDate` like every other list's (docs/design.md,
 * "Spalterna"): weekday, "27 nov", the time, with "I dag" or "Pågår" under it in
 * ink when that is the answer. Until 2026-11-17 the day of the month was set
 * large in Alegreya and the date in ink, the one list with a date of its own
 * look; the user asked why the programme's dates and the articles' differed, and
 * they no longer do.
 */

interface Props {
  events: EventSummary[]
  /** h2 on a month page, h3 under a month heading. */
  headingLevel?: 2 | 3
}

const { events, headingLevel = 2 } = Astro.props
const Heading = headingLevel === 2 ? "h2" : "h3"
const now = new Date()
---

<ol class="flex flex-col gap-7">
  {
    events.map((event) => {
      const kind = publicEventKindLabel(event.kind)
      const status = eventStatusLabel(eventStatus(event, now))
      const deadline = event.signup_deadline && signupOpen(event, now) ? event.signup_deadline : null
      // Not the deadline twice: it has its own line below.
      const summary = event.summary ? summaryBesideDeadline(event.summary, Boolean(deadline)) : ""
      return (
        <li class="margined gap-y-1">
          <MarginDate
            datetime={isoDateTime(event.starts_at)}
            parts={dateParts(event.starts_at, "row", {
              weekday: true,
              time: event.all_day ? null : formatDate(event.starts_at, "clock"),
            })}
            class="md:in-margin"
          >
            {status && <span class="text-foreground font-semibold">{status}</span>}
          </MarginDate>
          <div class="measure flex flex-col gap-1 md:in-text">
            <Heading class="type-item">
              <a href={`/kalender/${event.slug}`} class="title-link">
                {event.title}
              </a>
            </Heading>
            {(kind || event.place) && (
              <p class="type-label flex flex-wrap gap-x-3">
                {kind && <span>{kind}</span>}
                {event.place && <span>{event.place}</span>}
              </p>
            )}
            {summary && <p class="text-muted-foreground line-clamp-2 leading-relaxed">{summary}</p>}
            {deadline && (
              <p class="text-foreground leading-relaxed font-medium">
                Anmälan senast {formatDate(deadlineInstant(deadline), "dayMonth")}
              </p>
            )}
          </div>
        </li>
      )
    })
  }
</ol>
