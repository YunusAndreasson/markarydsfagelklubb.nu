---
import LarmTitle from "@/components/site/LarmTitle.astro"
import MarginDate from "@/components/site/MarginDate.astro"
import Print from "@/components/site/Print.astro"
import type { PublicAlert } from "@/lib/alert-dto"
import { ANONYMOUS_OBSERVER } from "@/lib/alert-observer"
import { alertPhotoSrc, alertPhotoSrcset } from "@/lib/alert-photo"
import { dateParts, formatDate, isoDateTime, listYear } from "@/lib/stockholm-time"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

/**
 * One larm per row, in the shape of a field-notebook entry: when it was seen
 * in the margin, then what was seen, then where, then who (docs/design.md).
 *
 * Every row carries the club's rarity number as a chip, the way the app does
 * (`RarityChip.astro`). The word beside it appears only from "Ovanlig" up, and
 * takes colour only when the bird is genuinely rare.
 */

interface Props {
  alerts: PublicAlert[]
  /** h2 on the larm page, h3 under a section heading on the home page. */
  headingLevel?: 2 | 3
  /** "changes": print the year when it changes. "other-years": only when it isn't this one. */
  years?: "changes" | "other-years"
  /**
   * Show the photos, as /larm does: from `md` up each at the end of the text
   * track beside its caption, a captioned print (docs/design.md, "Linjalen"), so
   * the species keep one edge, the photos line up like a contact strip and the
   * log stays scannable; full width under the row on a phone. Cropped to 3:2 to
   * keep the rhythm — a larm's own page shows the photo whole. `false` shows
   * none, as the lokal pages and the home page's "Övriga larm" do.
   */
  photos?: boolean
  /**
   * Show the coarse place. False on a lokal's own page under "På lokalen",
   * where the heading has already said where these larm came from and the
   * place ladder would print "Nära Reningsdammarna" on Rallvägen's page —
   * true, since the two are neighbours, and a flat contradiction to read.
   */
  place?: boolean
  /**
   * One line per larm — date and time, then species, place and observer in a
   * row — for the home page's "Övriga larm" under the photo rail, where full
   * notebook rows would outweigh the photos they sit beneath.
   */
  compact?: boolean
  /** The margin holds only the clock, under a heading that has named the day (/larm). */
  clockOnly?: boolean
}

const {
  alerts,
  headingLevel = 2,
  years = "changes",
  photos = true,
  place = true,
  compact = false,
  clockOnly = false,
} = Astro.props

const yearLabel = (index: number) => listYear(alerts, index, (one) => one.observedAt, years)

// One set per page, shared by every list on it (lib/view-transition.ts).
const taken = takenTransitionNames(Astro.locals)
---

{/* gap-9 leaves room between rows that carry a print; without prints the rows
    read as one list at gap-6 (a lokal's "Larm på lokalen" stood apart). */}
<ol class:list={["flex flex-col", compact ? "gap-4" : photos ? "gap-9" : "gap-6"]}>
  {
    alerts.map((alert, index) => {
      const year = yearLabel(index)
      const print = photos && alert.photoUrl ? alert.photoUrl : null
      return (
        <li class="margined gap-y-1">
          <MarginDate
            datetime={isoDateTime(alert.observedAt)}
            parts={
              clockOnly
                ? [formatDate(alert.observedAt, "clock")]
                : dateParts(alert.observedAt, "row", { year, time: formatDate(alert.observedAt, "clock") })
            }
            inline={compact}
            class="md:in-margin"
          />
          {/* The caption first, at the text's edge like every row's, and the print
              after it at the end of the text track (docs/design.md, "Linjalen"):
              the species run down one edge whether or not a larm has a photo. */}
          <div class:list={["md:in-text", print && "grid gap-x-5 gap-y-2 md:grid-cols-[minmax(0,1fr)_minmax(0,15rem)]"]}>
            <div class:list={["flex min-w-0", compact ? "flex-wrap items-baseline gap-x-3" : "flex-col gap-1"]}>
              <LarmTitle
                species={alert.species}
                count={alert.count}
                rarity={alert.rarity}
                href={`/larm/${alert.id}`}
                level={headingLevel}
              />
              <p class="type-label flex flex-wrap gap-x-3">
                {place && <span>{alert.place}</span>}
                <span>{alert.observer ?? ANONYMOUS_OBSERVER}</span>
                {compact && alert.photoUrl && <span>Foto</span>}
              </p>
            </div>
            {print && (
              <Print
                href={`/larm/${alert.id}`}
                src={alertPhotoSrc(print, "480")}
                srcset={alertPhotoSrcset(print, "feed")}
                sizes="(min-width: 48rem) 15rem, 100vw"
                width={480}
                height={320}
                transition={transitionName(taken, "larm", alert.id)}
                class="self-start"
              />
            )}
          </div>
        </li>
      )
    })
  }
</ol>
