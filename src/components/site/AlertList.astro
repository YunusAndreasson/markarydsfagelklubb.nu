---
import type { PublicAlert } from "@/lib/alert-dto"
import { ANONYMOUS_OBSERVER } from "@/lib/alert-observer"
import { alertPhotoSrc, alertPhotoSrcset } from "@/lib/alert-photo"
import { isRare, RARITY_WORTH_SAYING, rarityLabel } from "@/lib/rarity"
import { formatDate, isoDateTime, stockholmYear } from "@/lib/stockholm-time"

/**
 * One larm per row, in the shape of a field-notebook entry: when it was seen
 * in the margin, then what was seen, then where, then who (docs/design.md).
 *
 * The rarity word appears only when a bird is unusual, and takes colour only
 * when it is genuinely rare — 191 of the first 238 larm were "Allmän" or
 * "Ganska allmän", so printing that on every row would be noise that never
 * means anything. This way the page stays quiet and a rarity announces itself.
 */

interface Props {
  alerts: PublicAlert[]
  /** h2 on the larm page, h3 under a section heading on the home page. */
  headingLevel?: 2 | 3
  /** "changes": print the year when it changes. "other-years": only when it isn't this one. */
  years?: "changes" | "other-years"
  /**
   * Show the photos, as /larm does: in a column of their own on the right from
   * `md` up, so the photos line up like a contact strip and the log stays
   * scannable; full width under the row on a phone. Cropped to 3:2 to keep the
   * rhythm — a larm's own page shows the photo whole. `false` shows none, as
   * the lokal pages and the home page's "Övriga larm" do.
   */
  photos?: boolean
  /**
   * Show the coarse place. False on a lokal's own page under "På lokalen",
   * where the heading has already said where these larm came from and the
   * place ladder would print "Nära Reningsdammarna" on Rallvägen's page —
   * true, since the two are neighbours, and a flat contradiction to read.
   */
  place?: boolean
  /**
   * One line per larm — date and time, then species, place and observer in a
   * row — for the home page's "Övriga larm" under the photo rail, where full
   * notebook rows would outweigh the photos they sit beneath.
   */
  compact?: boolean
  /** The margin holds only the clock, under a heading that has named the day (/larm). */
  clockOnly?: boolean
}

const {
  alerts,
  headingLevel = 2,
  years = "changes",
  photos = true,
  place = true,
  compact = false,
  clockOnly = false,
} = Astro.props
const Heading = headingLevel === 2 ? "h2" : "h3"
const thisYear = stockholmYear(new Date())

const yearLabel = (index: number): number | null => {
  const alert = alerts[index]
  if (!alert) return null
  const year = stockholmYear(alert.observedAt)
  if (years === "other-years") return year === thisYear ? null : year
  const previous = alerts[index - 1]
  return previous && stockholmYear(previous.observedAt) === year ? null : year
}
---

<ol class:list={["flex flex-col", compact ? "gap-4" : "gap-9"]}>
  {
    alerts.map((alert, index) => {
      const year = yearLabel(index)
      const rare = isRare(alert.rarity)
      return (
        <li class:list={["grid gap-y-1", photos ? "md:grid-cols-[7rem_minmax(0,1fr)_18rem]" : "md:grid-cols-[7rem_minmax(0,38rem)]"]}>
          <p
            class:list={[
              "type-meta text-muted-foreground flex flex-wrap gap-x-2",
              compact ? "md:pt-[0.125rem]" : "md:flex-col md:gap-x-0 md:pt-[0.25rem]",
            ]}
          >
            <time datetime={isoDateTime(alert.observedAt)} class:list={["flex flex-wrap gap-x-2", !compact && "md:flex-col"]}>
              {!clockOnly && <span>{formatDate(alert.observedAt, "short")}</span>}
              {!clockOnly && year !== null && <span>{year}</span>}
              <span>{formatDate(alert.observedAt, "clock")}</span>
            </time>
          </p>
          <div
            class:list={[
              "flex min-w-0",
              compact ? "flex-wrap items-baseline gap-x-3" : "flex-col gap-1",
              photos && "md:pr-6",
            ]}
          >
            <Heading
              class:list={[
                "flex flex-wrap items-baseline gap-x-2",
                "type-item",
              ]}
            >
              <a href={`/larm/${alert.id}`} class="decoration-primary underline-offset-4 hover:underline">
                {alert.species}
              </a>
              {alert.count !== null && alert.count > 1 && (
                <span class="text-muted-foreground font-sans text-base font-normal">{alert.count} ex.</span>
              )}
              {alert.rarity <= RARITY_WORTH_SAYING && (
                <span class:list={["type-meta font-sans", rare ? "text-rarity" : "text-muted-foreground"]}>
                  {rarityLabel(alert.rarity)}
                </span>
              )}
            </Heading>
            <p class="text-muted-foreground flex flex-wrap gap-x-3 leading-relaxed">
              {place && <span>{alert.place}</span>}
              <span>{alert.observer ?? ANONYMOUS_OBSERVER}</span>
              {compact && alert.photoUrl && <span>Foto</span>}
            </p>
          </div>
          {photos && alert.photoUrl && (
            <img
              src={alertPhotoSrc(alert.photoUrl, "480")}
              srcset={alertPhotoSrcset(alert.photoUrl, "feed")}
              sizes="(min-width: 48rem) 18rem, 100vw"
              alt={`Foto av ${alert.species}`}
              loading="lazy"
              decoding="async"
              class="bg-muted mt-2 aspect-3/2 w-full rounded-[4px] object-cover md:col-start-3 md:row-start-1 md:mt-0"
            />
          )}
        </li>
      )
    })
  }
</ol>
