---
export const prerender = false

import AlertList from "@/components/site/AlertList.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import LarmFold from "@/components/site/LarmFold.astro"
import LarmMapFrame from "@/components/site/LarmMapFrame.astro"
import SourceNote from "@/components/site/obsar/SourceNote.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import RarityNote from "@/components/site/RarityNote.astro"
import Section from "@/components/site/Section.astro"
import ArrivalFigure from "@/components/site/species/ArrivalFigure.astro"
import YearFigure from "@/components/site/species/YearFigure.astro"
import SiteLayout from "@/layouts/site.astro"
import { dayOfYear } from "@/lib/artportalen/aggregate"
import { seasonWindow, typicalDays, weeksTotal } from "@/lib/artportalen/taxa"
import { toLarmPins } from "@/lib/larm-map"
import { obsarStore, store } from "@/lib/obsar-data"
import { listPublicSpecies, listSpeciesAlerts } from "@/lib/public-alerts"
import { loadNavigation } from "@/lib/public-content"
import { buildSpecies, findBySpelling, findSpecies, speciesHref } from "@/lib/species"
import {
  arrivalFigure,
  arrivalSentence,
  countWord,
  leadSentence,
  weekOfDay,
  yearSentence,
} from "@/lib/species-page"
import { formatDate, stockholmYear, toStockholmInputValue } from "@/lib/stockholm-time"
import { capitalize } from "@/lib/text"
import { missingNote, ratioPhrase, unusualNote, weeksBefore, yearTotals } from "@/lib/year-watch"

/**
 * One bird (docs/design.md, "Arter"): a field-guide entry for Markaryds
 * kommun. When it comes and when in the year it is seen, from Artportalen's
 * history in KV (`artportalen/taxa.ts`); what the members have larmed, with
 * their photos and a still map, from the app (`public-alerts.ts`).
 *
 * Either source can be missing — a bird only Artportalen has seen, one only
 * a member has larmed, or KV not built yet — and the page shows what there is.
 */

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })
const slug = Astro.params.slug ?? ""

const kv = obsarStore()
const [navigation, names, index, allTime, app] = await Promise.all([
  loadNavigation(db),
  kv ? store.readNames(kv).catch(() => null) : null,
  kv ? store.readTaxa(kv).catch(() => null) : null,
  kv ? store.readAllTime(kv).catch(() => null) : null,
  listPublicSpecies(),
])

const taxa = Object.entries(names ?? {}).map(([id, one]) => ({ id: Number(id), ...one }))
const species = buildSpecies(taxa, app.ok ? app.value : [])
const bird = findSpecies(slug, species)
if (!bird) {
  const spelled = findBySpelling(slug, species)
  if (spelled) return Astro.redirect(speciesHref(spelled.slug), 301)
  return new Response(null, { status: 404 })
}

const now = new Date()
const thisYear = stockholmYear(now)
const today = dayOfYear(toStockholmInputValue(now).slice(0, 10))
const entry = bird.taxonId !== null ? (index?.taxa[bird.taxonId] ?? null) : null
const ever =
  bird.taxonId !== null ? allTime?.taxa.find((one) => one.id === bird.taxonId) : undefined
const typical = entry && index ? typicalDays(entry, seasonWindow(index.years, thisYear)) : null
// The strip of first sightings only says "when it comes" for a summer bird; a
// winter guest's first report of a year is in January, wherever it was.
const figure =
  entry && typical?.kind === "summer" && typical.arrival
    ? arrivalFigure(entry, thisYear, typical.arrival)
    : null
const weeks = entry ? weeksTotal(entry) : null
const yearsSeen = entry ? Object.keys(entry.years).length : 0
// The index fills from this year backwards, a few years a night, so the count
// of years only holds once it reaches back to the bird's first report.
const historyComplete =
  ever !== undefined &&
  index?.years[0] !== undefined &&
  index.years[0] <= Number(ever.first.slice(0, 4))

const larm = bird.appId !== null ? await listSpeciesAlerts(bird.appId) : null
const alerts = larm?.ok ? larm.value : []
const pins = toLarmPins(alerts)
const SHOWN = 8
// "I år" against the last twenty (docs/design.md, "Året så här långt").
const window = index ? seasonWindow(index.years, thisYear) : []
const missing = entry ? missingNote(entry, window, thisYear, today) : null
const before = weeksBefore(today)
const unusual =
  entry && index
    ? unusualNote(entry, window, thisYear, before, yearTotals(index, [...window, thisYear], before))
    : null

const everYears = ever
  ? { first: Number(ever.first.slice(0, 4)), last: Number(ever.last.slice(0, 4)) }
  : null
const lead = typical ? leadSentence(typical, window.length, everYears, thisYear, weeks ?? []) : null
const date = (value: string) => formatDate(`${value}T12:00:00Z`, "long")
---

<SiteLayout
  title={bird.name}
  description={`${bird.name} (${bird.sci}) i Markaryds kommun: när den brukar komma, när på året den syns och var den har larmats.`}
  menu={navigation.menu}
>
  <article class="page-stack">
    <PageHeader
      title={bird.name}
      crumbs={[{ href: "/obsar/markarydslistan?ordning=a-o", label: "Markarydslistan" }]}
      latin={bird.sci}
      ingress={lead}
      asideLabel="I kommunen"
      wide
    >
      {
        (ever || bird.alertCount > 0 || bird.rarity !== null) && (
          <Fragment slot="aside">
            {bird.rarity !== null && <RarityNote level={bird.rarity} />}
            {ever && (
              <AsideNote label="Första fyndet">
                <p>{date(ever.first)}</p>
              </AsideNote>
            )}
            {ever && (
              <AsideNote label="Senaste fyndet">
                <p>{date(ever.last)}</p>
              </AsideNote>
            )}
            {ever && (
              <AsideNote label="Rapporter i Artportalen">
                <p>
                  {ever.reports.toLocaleString("sv-SE")}
                  {historyComplete && yearsSeen > 0 && (
                    <span class="text-muted-foreground"> under {yearsSeen === 1 ? "ett år" : `${yearsSeen} år`}</span>
                  )}
                </p>
              </AsideNote>
            )}
            {missing && (
              <AsideNote label="I år">
                <p>
                  Inte rapporterad än.{" "}
                  <span class="text-muted-foreground">
                    Brukar vara sedd vid den här tiden, {missing.byNow} av {missing.of} år.
                  </span>
                </p>
              </AsideNote>
            )}
            {unusual && (
              <AsideNote label="I år">
                <p>
                  {capitalize(ratioPhrase(unusual.ratio))}.{" "}
                  <span class="text-muted-foreground">
                    {unusual.count} hittills, brukar vara {unusual.expected} vid den här tiden.
                  </span>
                </p>
              </AsideNote>
            )}
            {alerts.length > 0 && (
              <AsideNote label="Larmad">
                <p>
                  <a href="#larm" class="link">{alerts.length === 1 ? "En gång" : `${alerts.length} gånger`}</a>
                </p>
              </AsideNote>
            )}
          </Fragment>
        )
      }
    </PageHeader>

    {/* The sections start at the margin's edge, in line with the logo, as on the home
        page: a species page has nothing for the margin. Captions keep the measure. */}
    {
      entry && figure && typical?.arrival && (
        <Section id="nar" title="När den kommer" wide>
          <ArrivalFigure figure={figure} sentence={arrivalSentence(entry, typical.arrival, thisYear)} headingId="nar" />
        </Section>
      )
    }

    {
      weeks && weeks.some((one) => one > 0) && (
        <Section id="aret" title="Över året" wide>
          <YearFigure weeks={weeks} now={weekOfDay(today)} sentence={yearSentence(weeks)} headingId="aret" />
        </Section>
      )
    }

    {
      !ever && bird.alertCount > 0 && (
        <EmptyNote wide>
          {bird.name} har aldrig rapporterats i Markaryds kommun i Artportalen, men den har larmats i appen
          {bird.alertCount > 1 ? ` ${countWord(bird.alertCount)} gånger` : ""}.
        </EmptyNote>
      )
    }

    {
      alerts.length > 0 ? (
        <Section id="larm" title="Larm" layout="spread" wide>
          <div class="in-wide flex flex-col gap-6">
            <AlertList alerts={alerts.slice(0, SHOWN)} headingLevel={3} years="other-years" />
            {alerts.length > SHOWN && (
              <LarmFold count={alerts.length - SHOWN}>
                <AlertList alerts={alerts.slice(SHOWN)} headingLevel={3} years="other-years" photos={false} compact />
              </LarmFold>
            )}
          </div>
          {pins.length > 0 && (
            /* Beside the list, from its first row. Each larm's photo is in its
               own row, as on /larm, rather than in a rail that repeated them. */
            <div class="in-aside flex flex-col gap-2 lg:row-start-2">
              <LarmMapFrame
                pins={pins}
                fallback={`Kartan behöver JavaScript. Platserna står vid varje larm.`}
                class="aspect-square w-full"
              />
              <p class="type-caption">Platserna där arten har larmats.</p>
            </div>
          )}
        </Section>
      ) : (
        // Only when the read worked: a failed one isn't "no larm".
        larm?.ok && (
          <EmptyNote wide>
            {bird.name} har inte larmats ännu. <a href="/larm" class="link">Se alla larm</a>.
          </EmptyNote>
        )
      )
    }

    {entry && <SourceNote fetchedAt={index?.fetchedAt} wide />}
  </article>
</SiteLayout>
