---
export const prerender = false

import ArticleList from "@/components/site/ArticleList.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Pager from "@/components/site/Pager.astro"
import SearchForm from "@/components/site/SearchForm.astro"
import Section from "@/components/site/Section.astro"
import SubpageList from "@/components/site/SubpageList.astro"
import SiteLayout from "@/layouts/site.astro"
import { decodeCursor, encodeCursor } from "@/lib/keyset"
import { listPublicLokaler } from "@/lib/public-alerts"
import { listPublishedArticles, loadNavigation, searchPages } from "@/lib/public-content"
import { matchesName, normaliseSearchQuery } from "@/lib/search"
import { SEARCH_SHORTCUTS } from "@/lib/site-menu"

/**
 * Search (docs/design.md, "Sök"): articles, pages and lokaler, from a plain GET
 * form with no script. Lokaler and pages come first and are few, since someone
 * typing a place or "medlemskap" wants that one page; articles follow, newest
 * first, as every list on the site runs.
 */

const ARTICLE_PAGE = 20
const SHORTCUTS = [...SEARCH_SHORTCUTS, { label: "Artikelarkivet", href: "/artiklar" }]
const OTHER_LIMIT = 8

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const params = Astro.url.searchParams
const query = normaliseSearchQuery(params.get("q"))
const before = decodeCursor(params.get("fore"))
const after = decodeCursor(params.get("efter"))
// Later pages of articles don't repeat the short lists above them.
const firstPage = !before && !after

const [navigation, articles, pageRows, lokaler] = await Promise.all([
  loadNavigation(db),
  query ? listPublishedArticles(db, { limit: ARTICLE_PAGE, search: query, before, after }) : null,
  query && firstPage ? searchPages(db, query, OTHER_LIMIT) : [],
  query && firstPage ? listPublicLokaler() : ({ ok: true, value: [] } as const),
])
// A firewall in front of the database refuses text that looks like an attack, and
// a visitor's odd query shouldn't cost them the page. The read has logged it.
const failed = Boolean(query) && (!articles || !pageRows || !lokaler.ok)

const pages = (pageRows ?? []).flatMap((row) => {
  const node = navigation.tree.byId.get(row.id)
  return node ? [{ ...row, path: node.path }] : []
})
const foundLokaler = lokaler.ok
  ? lokaler.value.filter((lokal) => matchesName(lokal.name, query)).slice(0, OTHER_LIMIT)
  : []
const found = articles?.articles ?? []
const nothing =
  !failed &&
  query !== "" &&
  found.length === 0 &&
  pages.length === 0 &&
  foundLokaler.length === 0 &&
  firstPage

/** "En träff", "12 träffar", or "Fler än 28 träffar" when the articles go on past this page. */
const total = found.length + pages.length + foundLokaler.length
const hits = articles?.older
  ? `Fler än ${total} träffar`
  : total === 1
    ? "En träff"
    : `${total} träffar`

const link = (param: "fore" | "efter", cursor: Parameters<typeof encodeCursor>[0]) =>
  `/sok?${new URLSearchParams({ q: query, [param]: encodeCursor(cursor) })}`
---

<SiteLayout title={query ? `Sök: ${query}` : "Sök"} description="Sök bland Markaryds Fågelklubbs artiklar, sidor och fågellokaler." menu={navigation.menu}>
  <div class="page-stack">
    <PageHeader title="Sök">
      <Fragment slot="after">
        <SearchForm value={query} autoFocus={!query} class="measure" />
        {query && firstPage && !failed && !nothing && <p class="type-label">{hits} på ”{query}”.</p>}
      </Fragment>
    </PageHeader>

    {
      !query && (
        <section aria-labelledby="sok-genvagar" class="flex measure flex-col gap-2 at-text">
          <h2 id="sok-genvagar" class="type-label">Eller gå direkt till</h2>
          <ul class="flex flex-wrap gap-x-6">
            {SHORTCUTS.map((shortcut) => (
              <li>
                <a href={shortcut.href} class="action-link">
                  {shortcut.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      failed && (
        <EmptyNote>Sökningen gick inte att genomföra. Prova med andra ord, eller ladda om sidan om en stund.</EmptyNote>
      )
    }

    {
      nothing && (
        <EmptyNote>
          Ingen träff på ”{query}”. Prova ett annat ord eller färre ord. Fynd finns under{" "}
          <a href="/larm" class="link">Larm</a> och i <a href="/artiklar" class="link">artikelarkivet</a>.
        </EmptyNote>
      )
    }

    {
      foundLokaler.length > 0 && (
        <Section id="traff-lokaler" title="Fågellokaler">
          <SubpageList pages={foundLokaler.map((lokal) => ({ href: `/lokaler/${lokal.slug}`, title: lokal.name }))} />
        </Section>
      )
    }

    {
      pages.length > 0 && (
        <Section id="traff-sidor" title="Sidor">
          <SubpageList pages={pages.map((page) => ({ href: page.path, title: page.title, description: page.description }))} />
        </Section>
      )
    }

    {
      found.length > 0 && (
        <Section id="traff-artiklar" title="Artiklar" dated>
          <ArticleList articles={found} headingLevel={3} years="changes" />
        </Section>
      )
    }

    <Pager
      label="Fler träffar"
      links={[
        articles?.newer && { href: link("efter", articles.newer), label: "Nyare träffar", rel: "prev" },
        articles?.older && { href: link("fore", articles.older), label: "Äldre träffar", rel: "next" },
      ]}
    />
  </div>
</SiteLayout>
