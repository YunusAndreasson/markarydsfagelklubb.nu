---
export const prerender = false

import AlertList from "@/components/site/AlertList.astro"
import AppLinks from "@/components/site/AppLinks.astro"
import LarmFold from "@/components/site/LarmFold.astro"
import SiteLayout from "@/layouts/site.astro"
import { decodeAlertCursor, encodeAlertCursor } from "@/lib/alert-keyset"
import { digestDay, pageOfDays, speciesCount } from "@/lib/larm-digest"
import { listPublicAlerts } from "@/lib/public-alerts"
import { loadNavigation } from "@/lib/public-content"
import { dayHeading } from "@/lib/stockholm-time"

/**
 * A page is whole days (`pageOfDays`), so it reads more rows than it may show.
 * Photos only load for what is on screen: a busy day's folded rows carry none.
 */
const PAGE_SIZE = 80
const MAX_DAYS = 4

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const params = Astro.url.searchParams
const pagingNewer = params.has("efter") && !params.has("fore")
const [navigation, page] = await Promise.all([
  loadNavigation(db),
  listPublicAlerts({
    limit: PAGE_SIZE,
    before: decodeAlertCursor(params.get("fore")),
    after: decodeAlertCursor(params.get("efter")),
  }),
])
if (!page.ok) return new Response(null, { status: 500 })

const { alerts } = page.value
const { days, older, newer } = pageOfDays(page.value, pagingNewer ? "newer" : "older", MAX_DAYS)
const now = new Date()
const link = (param: "fore" | "efter", cursor: Parameters<typeof encodeAlertCursor>[0]) =>
  `/larm?${new URLSearchParams({ [param]: encodeAlertCursor(cursor) })}`
---

<SiteLayout
  title="Larm"
  description="Fynd som medlemmarna larmat om i Markaryds Fågelklubbs app."
  menu={navigation.menu}
>
  <div class="flex flex-col gap-10">
    <header class="flex flex-col gap-3 md:pl-[7rem]">
      <h1 class="type-title">Larm</h1>
      <p class="type-ingress text-muted-foreground max-w-prose">
        Fynd som medlemmarna larmat om i klubbens app. Platsen är ungefärlig.
      </p>
      <AppLinks sentence={false} />
    </header>

    {
      alerts.length === 0 ? (
        params.has("fore") || params.has("efter") ? (
          <p class="text-muted-foreground max-w-prose md:pl-[7rem]">
            Det finns inga fler larm åt det hållet. <a href="/larm" class="link">Till de senaste larmen</a>
          </p>
        ) : (
          <p class="text-muted-foreground max-w-prose md:pl-[7rem]">
            Inga larm ännu. Larmen skickas från klubbens app och syns sedan här.
          </p>
        )
      ) : (
        days.map((day, index) => {
          const { highlights, rest } = digestDay(day.items)
          const count = speciesCount(day.items)
          return (
            <section aria-labelledby={`dag-${index}`} class="flex flex-col gap-6">
              <div class="flex flex-wrap items-baseline gap-x-3 md:pl-[7rem]">
                <h2 id={`dag-${index}`} class="type-section">{dayHeading(day.day, now)}</h2>
                {rest.length > 0 && (
                  <p class="type-meta text-muted-foreground">
                    {day.items.length} larm om {count} {count === 1 ? "art" : "arter"}
                  </p>
                )}
              </div>
              <AlertList alerts={highlights} headingLevel={3} clockOnly />
              {rest.length > 0 && (
                <LarmFold count={rest.length}>
                  <AlertList alerts={rest} headingLevel={3} clockOnly compact photos={false} />
                </LarmFold>
              )}
            </section>
          )
        })
      )
    }

    {
      (older || newer) && (
        <nav aria-label="Fler larm" class="flex flex-wrap gap-x-8 gap-y-2 md:pl-[7rem]">
          {newer && (
            <a
              href={link("efter", newer)}
              class="link flex min-h-11 items-center font-medium"
            >
              Nyare larm
            </a>
          )}
          {older && (
            <a
              href={link("fore", older)}
              class="link flex min-h-11 items-center font-medium"
            >
              Äldre larm
            </a>
          )}
        </nav>
      )
    }
  </div>
</SiteLayout>
