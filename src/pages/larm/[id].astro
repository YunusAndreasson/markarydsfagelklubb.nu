---
export const prerender = false

import AlertList from "@/components/site/AlertList.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import LarmMapFrame from "@/components/site/LarmMapFrame.astro"
import LarmRail from "@/components/site/LarmRail.astro"
import PhotoViewer from "@/components/site/PhotoViewer.astro"
import RarityChip from "@/components/site/RarityChip.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import SiteLayout from "@/layouts/site.astro"
import { ANONYMOUS_OBSERVER } from "@/lib/alert-observer"
import { alertPhotoSrc, alertPhotoSrcset } from "@/lib/alert-photo"
import { splitLarm } from "@/lib/front-page"
import { osmLink, toLarmPins } from "@/lib/larm-map"
import { listPublicAlerts, loadPublicAlert } from "@/lib/public-alerts"
import { loadNavigation } from "@/lib/public-content"
import { isRare, rarityLabel } from "@/lib/rarity"
import { formatDate, isoDateTime, stockholmYear } from "@/lib/stockholm-time"
import { transitionName } from "@/lib/view-transition"

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const { db } = Astro.locals
const id = Astro.params.id ?? ""
if (!db || !UUID.test(id)) return new Response(null, { status: 404 })

const [navigation, alert] = await Promise.all([loadNavigation(db), loadPublicAlert(id)])
if (!alert.ok) return new Response(null, { status: 500 })
if (!alert.value) return new Response(null, { status: 404 })

const larm = alert.value

// "Fler larm": the newest three with a photo as prints; with no photos among
// them, the newest three as rows. It is a pointer onwards, not the log — that
// is /larm — so photo-less larm newer than the prints aren't listed here, as
// they are on the home page. Never this larm itself. A failure costs the
// section.
const recent = await listPublicAlerts({ limit: 12 })
const { prints, plain } = splitLarm(
  (recent.ok ? recent.value.alerts : []).filter((other) => other.id !== larm.id),
  3
)

const observed = larm.observedAt
const title =
  larm.count !== null && larm.count > 1 ? `${larm.species} ${larm.count} ex.` : larm.species
// The place ladder writes "Nära Hualtet" for a blurred place, and "vid Nära
// Hualtet" isn't Swedish: such a place takes no preposition of its own.
const where = larm.place.startsWith("Nära ") ? `nära ${larm.place.slice(5)}` : `vid ${larm.place}`
// The map: the fynd where it was reported, and the lokal its place names as a
// ring beside it. No map when there is neither (a protected species, or a larm
// that came without a position).
const pins = toLarmPins([larm])
const mapLokal =
  larm.lokal && larm.lokal.latitude !== null && larm.lokal.longitude !== null
    ? { name: larm.lokal.name, latitude: larm.lokal.latitude, longitude: larm.lokal.longitude }
    : null
const hasMap = pins.length > 0 || mapLokal !== null
const fallback = larm.position
  ? "Kartan behöver JavaScript. Länken under öppnar platsen i OpenStreetMap."
  : `Kartan behöver JavaScript. Larmet kom ${where}.`
// Named before the rail's photos ask (lib/view-transition.ts).
Astro.locals.transitionNames ??= new Set()
const photoTransition = transitionName(Astro.locals.transitionNames, "larm", larm.id)
---

<SiteLayout
  title={title}
  description={`${larm.species} ${where}, ${formatDate(observed, "long")}.`}
  image={larm.photoUrl ? alertPhotoSrc(larm.photoUrl, "960") : undefined}
  type="article"
  menu={navigation.menu}
>
  <div class="flex flex-col gap-16">
    <article class="flex flex-col gap-8">
      <header class="spread">
        {/* The scientific name belongs to the species, so it sits under it, as
            in a field guide, rather than among the facts about this larm. */}
        <div class="in-text flex flex-col gap-4">
          <nav aria-label="Du är här" class="type-meta text-muted-foreground">
            <a href="/larm" class="crumb">Larm</a>
          </nav>
          <div class="flex flex-col gap-2">
            <h1 class="type-title">
              {larm.species}
              {larm.count !== null && larm.count > 1 && (
                <span class="text-muted-foreground font-normal">{larm.count} ex.</span>
              )}
            </h1>
            {larm.scientificName && <p class="text-muted-foreground text-lg italic">{larm.scientificName}</p>}
          </div>
        </div>
      </header>

      {/* The member's photo across the margin and the text, and the facts of the
          sighting beside it in the outer margin (docs/design.md, "Uppslaget"):
          when, how rare, where (ink, the fact a reader acts on), who. On a phone
          the photo comes first, since it is why a reader opened the larm, and
          the facts and the map follow it. Without a photo the facts take
          the text track, with nothing beside them. */}
      <div class="spread gap-y-6">
        {
          larm.photoUrl && (
            /* object-contain, not cover: the feed crops to keep its rhythm, but
               here the member's photo is shown whole, portrait or landscape, and
               the box reserves the space so nothing shifts as it loads. */
            <div class="in-wide aspect-3/2 w-full lg:row-start-1" data-photos>
              {/* A link to the largest file, opened in the viewer (docs/design.md,
                  "Lupen"); its height comes from the photo once it has loaded. */}
              <a href={alertPhotoSrc(larm.photoUrl, "1600")} class="photo block size-full cursor-zoom-in rounded-[4px]" data-pswp-width="1600">
                <img
                  src={alertPhotoSrc(larm.photoUrl, "960")}
                  srcset={alertPhotoSrcset(larm.photoUrl, "detail")}
                  sizes="(min-width: 48rem) 45rem, 100vw"
                  alt={`Foto av ${larm.species}`}
                  decoding="async"
                  style={photoTransition}
                  class="h-full w-full rounded-[4px] object-contain object-left-top"
                />
              </a>
            </div>
          )
        }
        <div class:list={["flex flex-col gap-5", larm.photoUrl ? "in-aside lg:row-start-1" : "in-text"]}>
          <AsideNote label="Sett">
            <time datetime={isoDateTime(observed)} class="leading-snug">
              {formatDate(observed, "weekday")} {stockholmYear(observed)}, {formatDate(observed, "clock")}
            </time>
          </AsideNote>
          <AsideNote label="Raritet">
            <p class="flex items-center gap-2">
              <RarityChip level={larm.rarity} />
              <span class:list={[isRare(larm.rarity) && "text-rarity font-medium"]} aria-hidden="true">{rarityLabel(larm.rarity)}</span>
            </p>
          </AsideNote>
          <AsideNote label="Plats">
            {larm.lokal ? (
              <a href={`/lokaler/${larm.lokal.slug}`} class="text-lg leading-snug font-medium decoration-primary w-fit underline-offset-4 hover:underline">
                {larm.place}
              </a>
            ) : (
              <p class="text-lg leading-snug font-medium">{larm.place}</p>
            )}
          </AsideNote>
          {hasMap && (
            /* The fynd is the facts' picture: square beside a photo, a still
               strip in the text track without one. */
            <div class="flex flex-col gap-2">
              <LarmMapFrame
                pins={pins}
                lokal={mapLokal}
                fallback={fallback}
                class={larm.photoUrl ? "aspect-square w-full" : "aspect-2/1 w-full"}
              />
              {larm.position && (
                <a href={osmLink(larm.position)} class="link type-meta flex min-h-11 w-fit items-center" rel="noopener">
                  Öppna platsen i OpenStreetMap
                </a>
              )}
            </div>
          )}
          <AsideNote label="Rapporterat av">
            <p>{larm.observer ?? ANONYMOUS_OBSERVER}</p>
          </AsideNote>
          <p class="text-muted-foreground text-sm leading-relaxed">
            {larm.position && "Kartan visar platsen som angavs i larmet. "}Larmet skickades i klubbens app{" "}
            <time datetime={isoDateTime(larm.sentAt)}>{formatDate(larm.sentAt, "dateTime")}</time>.
          </p>
        </div>
      </div>
    </article>

    {
      (prints.length > 0 || plain.length > 0) && (
        <section aria-labelledby="fler" class="spread gap-y-6">
          <div class="in-wide flex flex-col gap-6">
            {/* Over a list its heading starts where the text does; over the prints, with them. */}
            <div class:list={[prints.length === 0 && "at-text"]}>
              <SectionHeading id="fler" href="/larm" link="Alla larm">
                Fler larm
              </SectionHeading>
            </div>
            {prints.length > 0 ? (
              <LarmRail alerts={prints} layout="three" sizes="(min-width: 48rem) 14rem, 64vw" />
            ) : (
              <AlertList alerts={plain} headingLevel={3} years="other-years" photos={false} />
            )}
          </div>
        </section>
      )
    }
  </div>
  {larm.photoUrl && <PhotoViewer />}
</SiteLayout>
