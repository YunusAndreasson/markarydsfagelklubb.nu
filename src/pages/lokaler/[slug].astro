---
export const prerender = false

import AlertList from "@/components/site/AlertList.astro"
import Aside from "@/components/site/Aside.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import LarmFold from "@/components/site/LarmFold.astro"
import LokalMapFrame from "@/components/site/LokalMapFrame.astro"
import LokalPoints from "@/components/site/LokalPoints.astro"
import Register from "@/components/site/obsar/Register.astro"
import SightingEntries from "@/components/site/obsar/SightingEntries.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Section from "@/components/site/Section.astro"
import SiteLayout from "@/layouts/site.astro"
import { toPin } from "@/lib/lokal"
import { ACTIVE_DAYS } from "@/lib/lokal-alerts"
import { type MapPoint, splitForLokal } from "@/lib/lokal-points"
import { REPORT_KM, reportsByLokal } from "@/lib/lokal-reports"
import { obsarStore, store } from "@/lib/obsar-data"
import { loadPublicLokal } from "@/lib/public-alerts"
import { listLokalPoints, loadNavigation } from "@/lib/public-content"
import { isValidSlug } from "@/lib/slug"
import { countWord } from "@/lib/species-page"
import { dayLabel } from "@/lib/stockholm-time"
import { rapporter } from "@/lib/text"

/**
 * One lokal: where it is, what the club says about it, and the larm from it
 * (docs/roadmap.md, F5).
 *
 * The larm come under two headings on purpose. "På lokalen" is the app's own
 * rule — within 300 m, or named by the reporter — so the site never claims a
 * bird was somewhere the app doesn't. "I närheten" is the rest of the three
 * kilometres that D1's place ladder already labels with this lokal's name, so
 * a larm the feed calls "Nära Hualtet" can be found on Hualtet's page.
 * `lokal-alerts.ts` owns the rule; this page only lays it out.
 */

const { slug } = Astro.params
const { db } = Astro.locals
if (!db || !slug || !isValidSlug(slug)) return new Response(null, { status: 404 })

const kv = obsarStore()
const [navigation, found, recent] = await Promise.all([
  loadNavigation(db),
  loadPublicLokal(slug),
  kv ? store.readRecent(kv) : null,
])
if (!found.ok) return new Response(null, { status: 500 })
if (!found.value) return new Response(null, { status: 404 })

/**
 * How many nearby larm the page shows.
 *
 * "På lokalen" is printed whole: it is what the page is about, and it is the
 * number the register promises ("29 larm"), so a reader who follows the link
 * must find all of them. "I närheten" is context and is long — 3 km around
 * Markaryd tätort holds 60 or more larm, and the same ones appear on every
 * lokal in town — so it stops at a dozen, the same page size /larm uses.
 */
const NEAR_LIMIT = 12

const { lokal, at, near, directory } = found.value
const pointRows = await listLokalPoints(db, lokal.id)
const { own, partOf } = splitForLokal(pointRows, lokal.id)
const slugs = new Map(directory.map((entry) => [entry.id, entry.slug]))
const practical = own.filter((point) => point.kind === "practical")
const places = own.filter((point) => point.kind !== "practical")
const parent = partOf ? directory.find((entry) => entry.id === partOf.location_id) : undefined
const mapPoints = own.flatMap((point): MapPoint[] => {
  if (point.number === null || point.latitude === null || point.longitude === null) return []
  const linked = point.linked_location_id === null ? undefined : slugs.get(point.linked_location_id)
  return [
    {
      number: point.number,
      name: point.name,
      latitude: point.latitude,
      longitude: point.longitude,
      href: linked ? `/lokaler/${linked}` : `#plats-${point.number}`,
    },
  ]
})
const nearShown = near.slice(0, NEAR_LIMIT)

// Artportalen's last month here: reports within a kilometre that are nearer to
// this lokal than to any other (lokal-reports.ts). Newest first, a dozen shown.
const reports = reportsByLokal(recent?.sightings ?? [], directory).get(lokal.id) ?? []
const REPORTS_SHOWN = 12
const reportsShown = reports.slice(0, REPORTS_SHOWN)
const newestReport = reports[0] ?? null
const newestAt = at[0] ?? null
const newestNear = near[0] ?? null
/** The newest in full; the whole history stays here, a tap away. */
const AT_SHOWN = 6
// What the app holds on this lokal, or failing that what the club's map said of it.
const description = lokal.description?.trim() || partOf?.note || null

// The dot means the same here as on the map: a larm from this lokal inside the
// fortnight. Worked out from the larm already on the page rather than fetched
// again — `at` is newest first.
const lastAlertAt = at[0]?.sentAt ?? null
const active =
  lastAlertAt !== null && Date.now() - Date.parse(lastAlertAt) <= ACTIVE_DAYS * 86_400_000
// The still on its own page shows no tooltip, so it needs no "Nyss:" line.
const pin = toPin({ ...lokal, alertCount: at.length, lastAlertAt, active, recentSpecies: [] })
---

<SiteLayout
  title={lokal.name}
  description={description ?? `Larm från ${lokal.name} i Markaryds kommun.`}
  menu={navigation.menu}
>
  <article class="page-stack">
    <PageHeader
      title={lokal.name}
      crumbs={[
        { href: "/lokaler", label: "Fågellokaler" },
        ...(parent ? [{ href: `/lokaler/${parent.slug}`, label: parent.name }] : []),
      ]}
      ingress={description}
    />

    {/* The map is the page's subject: across the whole spread when it has the
        club's numbered places, else a still in the text track. */}
    {pin && (
      mapPoints.length > 0 ? (
        <LokalMapFrame pins={[pin]} points={mapPoints} fallback="Kartan behöver JavaScript. Platserna på lokalen står i listan längre ner." class="aspect-square sm:aspect-3/2 lg:aspect-[21/9]" />
      ) : (
        <div class="spread">
          <LokalMapFrame pins={[pin]} still fallback="Kartan behöver JavaScript." class="in-text aspect-2/1" />
        </div>
      )
    )}

    {/* The lokal's notes in the text, and what members have seen here in the
        outer margin (docs/design.md, "Uppslaget"), with a jump to the larm. */}
    <div class="spread">
      <div class="in-wide page-stack">
        {practical.length > 0 && (
          <Section id="bra-att-veta" title="Bra att veta" dated>
            <LokalPoints points={practical} slugs={slugs} />
          </Section>
        )}

        {places.length > 0 && (
          <Section id="platser" title="Platser på lokalen" dated>
            <LokalPoints points={places} slugs={slugs} />
          </Section>
        )}

        {at.length === 0 && near.length === 0 && (
          <EmptyNote>
            Inga larm har skickats härifrån ännu. <a href="/larm" class="link">Se alla larm</a>.
          </EmptyNote>
        )}

        {at.length > 0 && (
          <Section id="pa-lokalen" title="Larm på lokalen" dated>
            <AlertList alerts={at.slice(0, AT_SHOWN)} headingLevel={3} years="other-years" photos={false} place={false} />
            {at.length > AT_SHOWN && (
              <LarmFold count={at.length - AT_SHOWN}>
                <AlertList alerts={at.slice(AT_SHOWN)} headingLevel={3} years="other-years" photos={false} place={false} compact />
              </LarmFold>
            )}
          </Section>
        )}

        {reports.length > 0 && (
          <Section id="artportalen" title="Rapporterat i Artportalen">
            <Fragment slot="lead">
              Rapporter från högst {REPORT_KM === 1 ? "en kilometer" : `${REPORT_KM} km`} bort, de senaste{" "}
              {recent?.days ?? 30}&nbsp;dagarna.
              {reports.length > REPORTS_SHOWN && ` Här är de ${countWord(REPORTS_SHOWN)} senaste av ${reports.length}.`}{" "}
              Artnamnet leder till rapporten.
            </Fragment>
            <Register columns={2}>
              <SightingEntries sightings={reportsShown} brief who />
            </Register>
          </Section>
        )}

        {near.length > 0 && (
          <Section id="i-narheten" title="I närheten" dated>
            <Fragment slot="lead">
              {near.length > NEAR_LIMIT
                ? `De ${countWord(NEAR_LIMIT)} senaste larmen inom tre kilometer från lokalen.`
                : "Larm inom tre kilometer från lokalen."}
            </Fragment>
            <AlertList alerts={nearShown} headingLevel={3} years="other-years" photos={false} compact />
          </Section>
        )}
      </div>

      {(newestAt || newestReport || newestNear || parent) && (
        /* A summary with a way to the lists below, so from lg up only: on a
           narrower screen the lists themselves follow the text. */
        <Aside label="Om lokalen" class="max-lg:hidden">
          {newestAt && (
            <AsideNote label="Larm på lokalen">
              <p>
                {at.length} larm, senast {newestAt.species.toLocaleLowerCase("sv")}{" "}
                {dayLabel(newestAt.observedAt)}
              </p>
              <a href="#pa-lokalen" class="action-link">
                Se larmen
              </a>
            </AsideNote>
          )}
          {newestReport && (
            <AsideNote label="I Artportalen">
              <p>
                {rapporter(reports.length)}, senast {newestReport.name.toLocaleLowerCase("sv")}{" "}
                {dayLabel(newestReport.start)}
              </p>
              <a href="#artportalen" class="action-link">
                Se rapporterna
              </a>
            </AsideNote>
          )}
          {newestNear && (
            <AsideNote label="Inom tre kilometer">
              <p>
                Senast {newestNear.species.toLocaleLowerCase("sv")} {dayLabel(newestNear.observedAt)}
              </p>
              <a href="#i-narheten" class="action-link">
                I närheten
              </a>
            </AsideNote>
          )}
          {parent && (
            <AsideNote label="Del av">
              <a href={`/lokaler/${parent.slug}`} class="action-link">
                {parent.name}
              </a>
            </AsideNote>
          )}
        </Aside>
      )}
    </div>
  </article>
</SiteLayout>
