---
export const prerender = false

import LokalList from "@/components/site/LokalList.astro"
import LokalMapFrame from "@/components/site/LokalMapFrame.astro"
import SiteLayout from "@/layouts/site.astro"
import { toPin } from "@/lib/lokal"
import { listPublicLokaler } from "@/lib/public-alerts"
import { loadNavigation } from "@/lib/public-content"

/**
 * The club's lokaler: the map, then the register (docs/roadmap.md, F5).
 *
 * The map is the one loud thing on the page, as the lead photo is on the home
 * page. The register under it is not a second copy for its own sake — it is
 * the map's keyboard and screen-reader equivalent, which is why the island
 * marks itself `aria-hidden`.
 */

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const [navigation, lokaler] = await Promise.all([loadNavigation(db), listPublicLokaler()])
if (!lokaler.ok) return new Response(null, { status: 500 })

const pins = lokaler.value.map(toPin).filter((pin) => pin !== null)
// Where it has happened lately, newest first: usually what a visitor came for.
const active = lokaler.value
  .filter((lokal) => lokal.active && lokal.lastAlertAt)
  .sort((a, b) => ((a.lastAlertAt ?? "") < (b.lastAlertAt ?? "") ? 1 : -1))
---

<SiteLayout
  title="Fågellokaler"
  description="Fågellokaler i Markaryds kommun, med larmen därifrån."
  menu={navigation.menu}
>
  <div class="flex flex-col gap-10">
    <header class="flex flex-col gap-3 md:pl-[7rem]">
      <h1 class="type-title">Fågellokaler</h1>
      <p class="type-ingress text-muted-foreground max-w-prose">
        Platserna där klubben skådar i Markaryds kommun. En större grön prick på kartan betyder att
        någon har larmat därifrån de senaste två veckorna.
      </p>
    </header>

    {
      /* The kommun is about as wide as it is tall (19 km by 18), so a wide
         frame doesn't show more of it — it just zooms out until Laholm and
         Osby are on screen and the club's own ground is a patch in the middle.
         Near-square on a phone, 3:2 on a desktop. */
      pins.length > 0 && <LokalMapFrame pins={pins} class="aspect-square md:aspect-3/2" />
    }

    {
      lokaler.value.length === 0 ? (
        <p class="text-muted-foreground max-w-prose md:pl-[7rem]">
          Inga fågellokaler är upplagda ännu. De läggs till i appen och syns sedan här.
        </p>
      ) : (
        <>
          {active.length > 0 && (
            <section aria-labelledby="lokaler-aktiva" class="flex flex-col gap-5">
              <h2 id="lokaler-aktiva" class="type-section">Larmat senaste två veckorna</h2>
              <LokalList lokaler={active} letters={false} />
            </section>
          )}
          <section aria-labelledby="lokaler-alla" class="flex flex-col gap-5">
            <h2 id="lokaler-alla" class="type-section">Alla lokaler</h2>
            <LokalList lokaler={lokaler.value} />
          </section>
        </>
      )
    }
  </div>
</SiteLayout>
