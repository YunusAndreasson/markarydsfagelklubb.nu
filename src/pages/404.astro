---
import SiteLayout from "@/layouts/site.astro"

// Prerendered: it renders at build time without the database, so it has the
// club's name and a way home but no menu.
---

<SiteLayout title="Sidan hittades inte" menu={[]}>
  <div class="flex max-w-[38rem] flex-col gap-5 md:ml-[7rem]">
    <h1 class="type-title">Sidan hittades inte</h1>
    <p class="type-ingress text-muted-foreground">
      Adressen kan vara fel, eller så har sidan flyttats. Klubbens nyheter finns bland artiklarna.
    </p>
    <p class="flex flex-wrap gap-x-8">
      <a href="/" class="text-primary flex min-h-11 items-center font-medium underline underline-offset-4">Till startsidan</a>
      <a href="/artiklar" class="text-primary flex min-h-11 items-center font-medium underline underline-offset-4">Alla artiklar</a>
    </p>
  </div>
</SiteLayout>
