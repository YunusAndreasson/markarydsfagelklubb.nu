---
import PageHeader from "@/components/site/PageHeader.astro"
import SearchForm from "@/components/site/SearchForm.astro"
import SiteLayout from "@/layouts/site.astro"

// Prerendered: it renders at build time without the database, so the menu
// is the layout's fixed top level (FALLBACK_MENU), not the page tree's.
---

<SiteLayout title="Sidan hittades inte" menu={[]}>
  <PageHeader
    title="Sidan hittades inte"
    ingress="Adressen kan vara felstavad, eller så har sidan flyttats. Sök efter det du letar efter:"
  >
    <Fragment slot="after">
      <SearchForm class="measure" />
      <p class="flex flex-wrap gap-x-8">
        <a href="/" class="action-link">Till startsidan</a>
        <a href="/artiklar" class="action-link">Alla artiklar</a>
      </p>
    </Fragment>
  </PageHeader>
</SiteLayout>
