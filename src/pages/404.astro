---
import { buttonVariants } from "@/components/ui/button"
import BaseLayout from "@/layouts/base.astro"
---

<BaseLayout title="Sidan hittades inte · Markaryds Fågelklubb">
  <main class="mx-auto flex min-h-svh w-full max-w-2xl flex-col justify-center gap-6 px-4 py-12 sm:px-6">
    <p class="text-muted-foreground text-sm font-medium">404</p>
    <h1 class="text-3xl font-semibold tracking-tight text-balance">Sidan hittades inte</h1>
    <p class="text-muted-foreground max-w-prose leading-7">
      Sidan kan ha flyttats eller tagits bort.
    </p>
    <div>
      <a class={buttonVariants({ variant: "outline" })} href="/">Till startsidan</a>
    </div>
  </main>
</BaseLayout>
