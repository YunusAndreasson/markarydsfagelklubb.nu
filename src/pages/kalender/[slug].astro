---
export const prerender = false

import Aside from "@/components/site/Aside.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import Body from "@/components/site/Body.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import EventList from "@/components/site/EventList.astro"
import MarginDate from "@/components/site/MarginDate.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Pager from "@/components/site/Pager.astro"
import SiteLayout from "@/layouts/site.astro"
import { publicEventKindLabel } from "@/lib/event-kind"
import {
  monthKey,
  monthTitle as monthLabel,
  monthRange,
  parseMonthKey,
  shiftMonth,
} from "@/lib/event-month"
import {
  deadlineInstant,
  eventStatus,
  eventStatusLabel,
  signupOpen,
  summaryBesideDeadline,
  telHref,
} from "@/lib/event-status"
import type { MenuEntry } from "@/lib/page-tree"
import { formatPhone } from "@/lib/phone"
import {
  type EventSummary,
  type FullEvent,
  listEventsInMonth,
  loadNavigation,
  loadPublishedEvent,
} from "@/lib/public-content"
import { isValidSlug } from "@/lib/slug"
import {
  dateParts,
  formatDate,
  isoDateTime,
  stockholmMonthKey,
  stockholmYear,
} from "@/lib/stockholm-time"

/**
 * One segment under /kalender is either a month — /kalender/2026-10 — or an
 * event. The month shape is checked first, and `parseEventForm` refuses to
 * give an event a name of that shape, so the two can never collide.
 */

const slug = Astro.params.slug ?? ""
const { db } = Astro.locals
if (!db || !isValidSlug(slug)) return new Response(null, { status: 404 })

const month = parseMonthKey(slug)
let events: EventSummary[] = []
let event: FullEvent | null = null
let previous = ""
let next = ""
let menu: MenuEntry[] = []

if (month) {
  const [navigation, found] = await Promise.all([
    loadNavigation(db),
    listEventsInMonth(db, monthRange(month)),
  ])
  if (!found) return new Response(null, { status: 500 })
  events = found
  previous = monthKey(shiftMonth(month, -1))
  next = monthKey(shiftMonth(month, 1))
  menu = navigation.menu
} else {
  const [navigation, found] = await Promise.all([loadNavigation(db), loadPublishedEvent(db, slug)])
  if (found === "error") {
    return new Response(null, { status: 500 })
  }
  if (!found) return new Response(null, { status: 404 })
  event = found
  menu = navigation.menu
}

const monthTitle = month ? monthLabel(slug) : ""
const kind = event ? publicEventKindLabel(event.kind) : null
const eventMonth = event ? stockholmMonthKey(event.starts_at) : ""

// An end is only worth printing when it says something new. On the start's
// own day it joins the clock as a range, "18:30–21:00", the way Swedish writes
// it; past that day it gets a line of its own, "till 2 nov. 16:00".
const sameDay =
  event?.ends_at && formatDate(event.ends_at, "long") === formatDate(event.starts_at, "long")
const startClock = event && !event.all_day ? formatDate(event.starts_at, "clock") : null
const endClock = event?.ends_at && !event.all_day ? formatDate(event.ends_at, "clock") : null
const clockLabel =
  startClock && sameDay && endClock && endClock !== startClock
    ? `${startClock}–${endClock}`
    : startClock
const untilLabel =
  !event?.ends_at || sameDay
    ? null
    : event.all_day
      ? formatDate(event.ends_at, "dayMonth")
      : `${formatDate(event.ends_at, "dayMonth")} ${endClock}`

const now = new Date()
const statusLabel = event ? eventStatusLabel(eventStatus(event, now)) : null
const open = event ? signupOpen(event, now) : false
const deadlineLabel = event?.signup_deadline
  ? formatDate(deadlineInstant(event.signup_deadline), "dayMonth")
  : null
// The ingress without a closing "Föranmälan senast …": the aside says when.
const lead =
  event?.summary && event
    ? summaryBesideDeadline(
        event.summary,
        Boolean(deadlineLabel) && eventStatus(event, now) !== "past"
      )
    : ""
const phoneHref = event?.contact_phone ? telHref(event.contact_phone) : null
const hasContact = Boolean(event?.contact_name || event?.contact_phone)

const title = month ? `${monthTitle} · Program` : `${event?.title} · Program`
const description = month
  ? `Markaryds Fågelklubbs program i ${monthTitle.toLowerCase()}.`
  : event?.summary || undefined
---

<SiteLayout title={title} description={description} menu={menu}>
  {
    month && (
      <div class="page-stack">
        <PageHeader title={monthTitle} crumbs={[{ href: "/kalender", label: "Program" }]} />

        {events.length === 0 ? <EmptyNote>Inga aktiviteter den här månaden.</EmptyNote> : <EventList events={events} />}

        <Pager
          label="Fler månader"
          links={[
            { href: `/kalender/${previous}`, label: monthLabel(previous), rel: "prev" },
            { href: `/kalender/${next}`, label: monthLabel(next), rel: "next" },
          ]}
        />
      </div>
    )
  }

  {
    event && (
      /* The notebook's spread (docs/design.md, "Uppslaget"): the date in the
         margin, the club's own words in the text, and the facts a member acts
         on in the outer margin: where, until when, and whom to call. On a
         phone those facts follow the date, before the text, which is where a
         member standing in a car park looks for the number. */
      <article class="page-stack">
        <PageHeader
          title={event.title}
          crumbs={[
            { href: "/kalender", label: "Program" },
            { href: `/kalender/${eventMonth}`, label: monthLabel(eventMonth) },
          ]}
          ingress={lead}
        />

        <div class="spread gap-y-8">
          <MarginDate
            datetime={isoDateTime(event.starts_at)}
            parts={dateParts(event.starts_at, "page", {
              weekday: true,
              year: stockholmYear(event.starts_at),
              time: clockLabel,
            })}
            class="in-margin max-lg:-order-1"
          >
            {untilLabel && <span>till {untilLabel}</span>}
            {statusLabel && <span class="text-foreground font-semibold">{statusLabel}</span>}
            {kind && <span>{kind}</span>}
          </MarginDate>

          <div class="in-text flex flex-col gap-6 self-baseline">
            {event.body_html && <Body html={event.body_html} />}
            <a href="/kalender" class="action-link">
              Hela programmet
            </a>
          </div>

          {/* The same test as the Anmälan note's, or a past event with only a
              deadline would get an empty, labelled aside. */}
          {(event.place ||
            hasContact ||
            ((deadlineLabel || (event.registration_url && open)) && eventStatus(event, now) !== "past")) && (
            <Aside label="Kort om dagen">
              {event.place && (
                <AsideNote label="Plats">
                  <p>{event.place}</p>
                </AsideNote>
              )}
              {(deadlineLabel || (event.registration_url && open)) && eventStatus(event, now) !== "past" && (
                <AsideNote label="Anmälan">
                  {deadlineLabel && open && <p>Senast {deadlineLabel}</p>}
                  {deadlineLabel && !open && <p class="text-muted-foreground">Sista anmälningsdag var {deadlineLabel}.</p>}
                  {event.registration_url && open && (
                    <a href={event.registration_url} class="action-link">
                      Anmäl dig
                    </a>
                  )}
                </AsideNote>
              )}
              {hasContact && (
                <AsideNote label={deadlineLabel && open ? "Anmäl dig till" : "Kontakt"}>
                  {event.contact_name && <p>{event.contact_name}</p>}
                  {event.contact_phone &&
                    (phoneHref ? (
                      <a href={phoneHref} class="action-link">
                        {formatPhone(event.contact_phone)}
                      </a>
                    ) : (
                      <p>{formatPhone(event.contact_phone)}</p>
                    ))}
                </AsideNote>
              )}
            </Aside>
          )}
        </div>
      </article>
    )
  }
</SiteLayout>
