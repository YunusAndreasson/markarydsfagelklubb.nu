---
export const prerender = false

import EventList from "@/components/site/EventList.astro"
import SiteLayout from "@/layouts/site.astro"
import { groupByMonth, monthKey, monthOf, shiftMonth } from "@/lib/event-month"
import { listUpcomingEvents, loadNavigation } from "@/lib/public-content"
import { formatDate, startOfStockholmDay } from "@/lib/stockholm-time"

/**
 * The programme. Upcoming events, grouped under the month they fall in, with
 * a way back into the months that have been. A grid was considered and
 * dropped (docs/roadmap.md, F3): the club runs a couple of events a month, so
 * a month grid would be mostly empty squares, and it reads badly at 360 px.
 */

const UPCOMING_LIMIT = 40

const { db } = Astro.locals
if (!db) return new Response(null, { status: 503 })

// From the start of today, so a morning excursion is still in the programme
// while the members are out on it.
const now = new Date()
const [navigation, events] = await Promise.all([
  loadNavigation(db),
  listUpcomingEvents(db, { limit: UPCOMING_LIMIT, from: startOfStockholmDay(now) }),
])
if (!events) return new Response("Programmet kunde inte läsas just nu.", { status: 503 })

const months = groupByMonth(events)
const previousMonth = monthKey(shiftMonth(monthOf(now), -1))
const heading = (key: string) => {
  const label = formatDate(`${key}-01T12:00:00Z`, "month")
  return label.charAt(0).toUpperCase() + label.slice(1)
}
---

<SiteLayout
  title="Program"
  description="Exkursioner, möten och resor med Markaryds Fågelklubb."
  menu={navigation.menu}
>
  <div class="flex flex-col gap-10">
    <header class="flex flex-col gap-5 md:pl-[7rem]">
      <h1 class="type-title">Program</h1>
      <p class="type-ingress text-muted-foreground max-w-[38rem]">
        Klubbens exkursioner, möten och resor. Alla är välkomna, även den som inte är medlem.
      </p>
      <p class="text-muted-foreground max-w-[38rem]">
        <a href="/kalender.ics" class="text-primary underline underline-offset-4">
          Prenumerera på programmet
        </a>
        {" "}så dyker det upp i din egen kalender, och nya datum kommer med av sig själva.
      </p>
    </header>

    {
      months.length === 0 && (
        <p class="text-muted-foreground max-w-[38rem] md:pl-[7rem]">
          Inget är inlagt framåt just nu. Titta in igen, eller läs vad klubben har gjort under
          <a href="/artiklar" class="text-primary underline underline-offset-4"> Artiklar</a>.
        </p>
      )
    }

    {
      months.map((group) => (
        <section aria-labelledby={`manad-${group.key}`} class="flex flex-col gap-6">
          <h2 id={`manad-${group.key}`} class="text-lg font-semibold md:pl-[7rem]">
            {heading(group.key)}
          </h2>
          <EventList events={group.events} headingLevel={3} />
        </section>
      ))
    }

    {/* The link says what it does, not just where it goes: a bare month name
        at the foot of the page reads as a stray heading. */}
    <nav aria-label="Tidigare i programmet" class="md:pl-[7rem]">
      <a href={`/kalender/${previousMonth}`} class="text-primary flex min-h-11 w-fit items-center font-medium underline underline-offset-4">
        Tidigare i programmet
      </a>
    </nav>
  </div>
</SiteLayout>
