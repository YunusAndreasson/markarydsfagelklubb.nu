---
export const prerender = false

import AsideNote from "@/components/site/AsideNote.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import EventList from "@/components/site/EventList.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Section from "@/components/site/Section.astro"
import SiteLayout from "@/layouts/site.astro"
import { groupByMonth, monthTitle } from "@/lib/event-month"
import { latestEventStartBefore, listUpcomingEvents, loadNavigation } from "@/lib/public-content"
import { startOfStockholmDay, stockholmMonthKey } from "@/lib/stockholm-time"

/**
 * The programme. Upcoming events, grouped under the month they fall in, with
 * a way back into the months that have been. A grid was considered and
 * dropped (docs/roadmap.md, F3): the club runs a couple of events a month, so
 * a month grid would be mostly empty squares, and it reads badly at 360 px.
 */

const UPCOMING_LIMIT = 40

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

// From the start of today, so a morning excursion is still in the programme
// while the members are out on it.
const today = startOfStockholmDay(new Date())
const [navigation, events, latestPast] = await Promise.all([
  loadNavigation(db),
  listUpcomingEvents(db, { limit: UPCOMING_LIMIT, from: today }),
  latestEventStartBefore(db, today),
])
if (!events) return new Response(null, { status: 500 })

const months = groupByMonth(events)
// The month of the newest past event, which may well be this one: an earlier event
// this month has left the list above, and last month's page wouldn't show it.
const earlierMonth = latestPast ? stockholmMonthKey(latestPast) : null
---

<SiteLayout
  title="Program"
  description="Exkursioner, möten och resor med Markaryds Fågelklubb."
  menu={navigation.menu}
>
  <div class="page-stack">
    {/* The ways to keep up sit in the outer margin, beside the title
        (docs/design.md, "Uppslaget"). From lg they hang beside the months
        rather than set the header's height: the title is short, and a header as
        tall as the notes left a gap above the first month. The months never
        use the aside track. */}
    <PageHeader title="Program" ingress="Exkursioner, möten och resor." asideLabel="Följ programmet" hang={months.length > 0}>
      <Fragment slot="aside">
        <AsideNote label="I din kalender" kind="note">
          <p class="text-muted-foreground">
            <a href="/kalender.ics" class="link">Prenumerera på programmet</a>, så hamnar det i kalendern i din mobil
            eller dator, och ändringar kommer med automatiskt.
          </p>
        </AsideNote>
        {
          earlierMonth && (
            <AsideNote label="Det som har varit" kind="note">
              {/* The link says what it does: a bare month name reads as a stray heading. */}
              <a href={`/kalender/${earlierMonth}`} class="action-link">
                Tidigare i programmet
              </a>
            </AsideNote>
          )
        }
      </Fragment>
    </PageHeader>

    {
      months.length === 0 && (
        <EmptyNote>
          Inget nytt är inlagt i programmet ännu. Om tidigare exkursioner kan du läsa under{" "}
          <a href="/artiklar" class="link">Artiklar</a>.
        </EmptyNote>
      )
    }

    {
      months.map((group) => (
        <Section id={`manad-${group.key}`} title={monthTitle(group.key)} dated>
          <EventList events={group.events} headingLevel={3} />
        </Section>
      ))
    }
  </div>
</SiteLayout>
