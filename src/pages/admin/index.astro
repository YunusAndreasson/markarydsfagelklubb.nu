---
export const prerender = false

import AdminLayout from "@/layouts/admin.astro"

// Server-rendered on every request, through the middleware's per-request
// Supabase client. A placeholder: sign-in and the admin gate are step 2.
const { user } = Astro.locals
---

<AdminLayout title="Översikt">
  <div class="flex max-w-prose flex-col gap-3">
    <h1 class="text-2xl font-semibold tracking-tight">Administration</h1>
    <p class="text-muted-foreground leading-7">
      {user ? `Inloggad som ${user.email ?? user.id}.` : "Inte inloggad."}{" "}
      Inloggning och redigering kommer i nästa steg.
    </p>
  </div>
</AdminLayout>
