---
export const prerender = false

import PublishBadge from "@/components/admin/PublishBadge.astro"
import { buttonVariants } from "@/components/ui/button"
import AdminLayout from "@/layouts/admin.astro"
import { listArticles } from "@/lib/admin-content"
import { publishStateOf } from "@/lib/publish-state"

// Only the administrator reaches this page: the middleware redirects everyone
// else to /admin/login.
const { supabase } = Astro.locals
if (!supabase) return new Response(null, { status: 503 })

const now = new Date()
const { data: articles, error } = await listArticles(supabase)
if (error) console.error(`mafk-web: list articles failed — ${error.message}`)

const waiting = (articles ?? []).filter((article) => publishStateOf(article, now) !== "published")
const recent = (articles ?? []).slice(0, 5)
---

<AdminLayout title="Översikt">
  <div class="flex flex-col gap-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">Översikt</h1>
      <div class="flex flex-wrap gap-2">
        <a href="/admin/sidor/ny" class={buttonVariants({ variant: "outline", className: "h-11" })}>Ny sida</a>
        <a href="/admin/artiklar/ny" class={buttonVariants({ className: "h-11" })}>Ny artikel</a>
      </div>
    </div>

    {
      waiting.length > 0 && (
        <section aria-labelledby="waiting" class="flex flex-col gap-3">
          <h2 id="waiting" class="text-lg font-semibold">Utkast och schemalagda</h2>
          <ul class="flex flex-col divide-y rounded-2xl border">
            {waiting.map((article) => (
              <li class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
                <a href={`/admin/artiklar/${article.id}`} class="font-medium underline-offset-4 hover:underline">
                  {article.title}
                </a>
                <PublishBadge status={article.status} publishedAt={article.published_at} now={now} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="recent" class="flex flex-col gap-3">
      <h2 id="recent" class="text-lg font-semibold">Senaste artiklarna</h2>
      {
        recent.length === 0 ? (
          <p class="text-muted-foreground">Inga artiklar ännu.</p>
        ) : (
          <ul class="flex flex-col divide-y rounded-2xl border">
            {recent.map((article) => (
              <li class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
                <a href={`/admin/artiklar/${article.id}`} class="font-medium underline-offset-4 hover:underline">
                  {article.title}
                </a>
                <PublishBadge status={article.status} publishedAt={article.published_at} now={now} />
              </li>
            ))}
          </ul>
        )
      }
      <a href="/admin/artiklar" class="text-primary w-fit text-sm underline-offset-4 hover:underline">
        Alla artiklar
      </a>
    </section>
  </div>
</AdminLayout>
