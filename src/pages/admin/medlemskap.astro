---
export const prerender = false

import { Alert, AlertDescription } from "@/components/ui/alert"
import { Button } from "@/components/ui/button"
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
  FieldLegend,
  FieldSet,
} from "@/components/ui/field"
import { Input } from "@/components/ui/input"
import AdminLayout from "@/layouts/admin.astro"
import { loadMembershipSettings, saveMembershipSettings, WRITE_MESSAGES } from "@/lib/admin-content"
import type { FieldErrors } from "@/lib/content-form"
import { type MembershipInput, parseMembershipForm } from "@/lib/membership"

// The fees and payment details printed on the Klubben page and the join page
// (src/lib/membership.ts). One row, so this is a single form with no list.
const { supabase } = Astro.locals
if (!supabase) return new Response(null, { status: 503 })

let errors: FieldErrors = {}
let formError: string | null = null
let submitted: Record<string, string> | null = null

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const parsed = parseMembershipForm(form)
  if (parsed.ok) {
    const result = await saveMembershipSettings(supabase, parsed.value)
    if (result.ok) return Astro.redirect("/admin/medlemskap?sparad=1", 303)
    formError = WRITE_MESSAGES.failed
  } else {
    errors = parsed.errors
  }
  // Keep what was typed on screen while the errors are fixed.
  submitted = Object.fromEntries(
    [...form.entries()].map(([name, value]) => [name, typeof value === "string" ? value : ""])
  )
}

const { data: saved, error } = await loadMembershipSettings(supabase)
if (error) console.error(`mafk-web: load membership settings failed — ${error.message}`)

const value = (name: keyof MembershipInput): string =>
  submitted ? (submitted[name] ?? "") : saved ? String(saved[name]) : ""
const invalid = (name: keyof MembershipInput) => (errors[name] ? true : undefined)
---

<AdminLayout title="Medlemskap">
  <div class="flex max-w-2xl flex-col gap-6">
    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-semibold tracking-tight">Medlemskap</h1>
      <p class="text-muted-foreground leading-7">
        Avgifterna och betalningsuppgifterna visas på sidan Klubben och på sidan för nya medlemmar.
        Byt årtal och avgifter här när ett nytt år börjar, så stämmer båda sidorna.
        <a href="/om-foreningen/medlemskap" class="text-foreground underline underline-offset-4">Visa sidan för nya medlemmar</a>
      </p>
    </div>

    {Astro.url.searchParams.has("sparad") && <Alert><AlertDescription>Sparat.</AlertDescription></Alert>}
    {
      (formError || error || (!saved && !submitted)) && (
        <Alert variant="destructive">
          <AlertDescription>{formError ?? "Uppgifterna kunde inte läsas just nu."}</AlertDescription>
        </Alert>
      )
    }

    <form method="POST" class="flex flex-col gap-8">
      <FieldSet>
        <FieldLegend>Avgifter</FieldLegend>
        <FieldGroup>
          <Field data-invalid={invalid("year")}>
            <FieldLabel htmlFor="year">År</FieldLabel>
            <Input id="year" name="year" inputMode="numeric" value={value("year")} className="h-11 max-w-32" required aria-invalid={invalid("year")} />
            <FieldDescription>Avgiften gäller ett kalenderår. Sidan skriver ”Avgift {value("year") || "2027"}”.</FieldDescription>
            <FieldError>{errors.year}</FieldError>
          </Field>
          <div class="grid gap-6 sm:grid-cols-3">
            <Field data-invalid={invalid("fee_adult")}>
              <FieldLabel htmlFor="fee_adult">Vuxen, kr</FieldLabel>
              <Input id="fee_adult" name="fee_adult" inputMode="numeric" value={value("fee_adult")} className="h-11" required aria-invalid={invalid("fee_adult")} />
              <FieldError>{errors.fee_adult}</FieldError>
            </Field>
            <Field data-invalid={invalid("fee_youth")}>
              <FieldLabel htmlFor="fee_youth">Ungdom, kr</FieldLabel>
              <Input id="fee_youth" name="fee_youth" inputMode="numeric" value={value("fee_youth")} className="h-11" required aria-invalid={invalid("fee_youth")} />
              <FieldError>{errors.fee_youth}</FieldError>
            </Field>
            <Field data-invalid={invalid("fee_family")}>
              <FieldLabel htmlFor="fee_family">Familjemedlem, kr</FieldLabel>
              <Input id="fee_family" name="fee_family" inputMode="numeric" value={value("fee_family")} className="h-11" required aria-invalid={invalid("fee_family")} />
              <FieldError>{errors.fee_family}</FieldError>
            </Field>
          </div>
          <Field data-invalid={invalid("youth_max_age")}>
            <FieldLabel htmlFor="youth_max_age">Ungdom till och med ålder</FieldLabel>
            <Input id="youth_max_age" name="youth_max_age" inputMode="numeric" value={value("youth_max_age")} className="h-11 max-w-32" required aria-invalid={invalid("youth_max_age")} />
            <FieldDescription>Sidan skriver ”Ungdom, t.o.m. {value("youth_max_age") || "20"} år”. En familjemedlem bor med en vuxen medlem och får inget eget Cinclus.</FieldDescription>
            <FieldError>{errors.youth_max_age}</FieldError>
          </Field>
        </FieldGroup>
      </FieldSet>

      <FieldSet>
        <FieldLegend>Betalning</FieldLegend>
        <FieldGroup>
          <Field data-invalid={invalid("swish")}>
            <FieldLabel htmlFor="swish">Swishnummer</FieldLabel>
            <Input id="swish" name="swish" inputMode="numeric" value={value("swish")} className="h-11 max-w-56" aria-invalid={invalid("swish")} />
            <FieldDescription>Visas som du skriver det, till exempel 123 267 61 61.</FieldDescription>
            <FieldError>{errors.swish}</FieldError>
          </Field>
          <Field data-invalid={invalid("bankgiro")}>
            <FieldLabel htmlFor="bankgiro">Bankgiro</FieldLabel>
            <Input id="bankgiro" name="bankgiro" value={value("bankgiro")} className="h-11 max-w-56" aria-invalid={invalid("bankgiro")} />
            <FieldError>{errors.bankgiro}</FieldError>
          </Field>
        </FieldGroup>
      </FieldSet>

      <FieldSet>
        <FieldLegend>Dit nya medlemmar skickar sin adress</FieldLegend>
        <FieldDescription>
          Oftast kassören. När klubben har en egen adress som kassor@markarydsfagelklubb.nu byter du
          bara e-postadressen här.
        </FieldDescription>
        <FieldGroup>
          <Field data-invalid={invalid("contact_name")}>
            <FieldLabel htmlFor="contact_name">Namn</FieldLabel>
            <Input id="contact_name" name="contact_name" value={value("contact_name")} className="h-11" aria-invalid={invalid("contact_name")} />
            <FieldError>{errors.contact_name}</FieldError>
          </Field>
          <Field data-invalid={invalid("contact_email")}>
            <FieldLabel htmlFor="contact_email">E-post</FieldLabel>
            <Input id="contact_email" name="contact_email" type="email" value={value("contact_email")} className="h-11" aria-invalid={invalid("contact_email")} />
            <FieldError>{errors.contact_email}</FieldError>
          </Field>
          <Field data-invalid={invalid("contact_phone")}>
            <FieldLabel htmlFor="contact_phone">Telefon (för samtal och sms)</FieldLabel>
            <Input id="contact_phone" name="contact_phone" type="tel" value={value("contact_phone")} className="h-11 max-w-56" aria-invalid={invalid("contact_phone")} />
            <FieldError>{errors.contact_phone}</FieldError>
          </Field>
        </FieldGroup>
      </FieldSet>

      <div>
        <Button type="submit" className="h-11">Spara</Button>
      </div>
    </form>
  </div>
</AdminLayout>
