---
export const prerender = false

import { Alert, AlertDescription } from "@/components/ui/alert"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import AdminLayout from "@/layouts/admin.astro"
import { hideAlert, listAdminAlerts, showAlert } from "@/lib/admin-alerts"
import { WRITE_MESSAGES } from "@/lib/admin-content"
import { ANONYMOUS_OBSERVER } from "@/lib/alert-observer"
import { formatDate } from "@/lib/stockholm-time"

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const { supabase, user } = Astro.locals
if (!supabase) return new Response(null, { status: 503 })

let formError: string | null = null

// State changes are POSTs, never GETs.
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const id = String(form.get("id") ?? "")
  const intent = form.get("intent")

  if (!UUID.test(id)) {
    formError = WRITE_MESSAGES.failed
  } else {
    const result =
      intent === "show"
        ? await showAlert(supabase, id)
        : await hideAlert(
            supabase,
            id,
            String(form.get("reason") ?? "").slice(0, 200),
            user?.id ?? null
          )
    if (result.ok)
      return Astro.redirect(`/admin/larm?${intent === "show" ? "visad" : "dold"}=1`, 303)
    formError = WRITE_MESSAGES.failed
  }
}

const alerts = await listAdminAlerts(supabase)
const hiddenCount = (alerts ?? []).filter((alert) => alert.hidden).length
---

<AdminLayout title="Larm" wide>
  <div class="flex max-w-4xl flex-col gap-6">
    <h1 class="text-2xl font-semibold tracking-tight">Larm</h1>
    <p class="text-muted-foreground leading-7">
      Larmen kommer från appen och visas på webbplatsen automatiskt. Här kan du dölja ett enskilt
      larm — om en medlem ber om det, om arten är skyddsklassad, eller om något blivit fel. Ett dolt
      larm försvinner från webbplatsen inklusive bilden, men finns kvar i appen.
    </p>

    {Astro.url.searchParams.has("dold") && (
      <Alert><AlertDescription>Larmet är dolt på webbplatsen.</AlertDescription></Alert>
    )}
    {Astro.url.searchParams.has("visad") && (
      <Alert><AlertDescription>Larmet visas igen.</AlertDescription></Alert>
    )}
    {(formError || !alerts) && (
      <Alert variant="destructive">
        <AlertDescription>{formError ?? "Larmen kunde inte läsas just nu."}</AlertDescription>
      </Alert>
    )}

    {alerts && alerts.length > 0 && (
      <p class="text-muted-foreground text-sm">
        Visar de {alerts.length} senaste larmen. {hiddenCount === 0 ? "Inget av dem är dolt." : `${hiddenCount} av dem är dolda.`}
      </p>
    )}

    <ul class="flex flex-col divide-y rounded-2xl border">
      {(alerts ?? []).map((alert) => (
        <li class="flex flex-col gap-2 p-3">
          <div class="flex flex-wrap items-baseline gap-x-3">
            <a href={`/larm/${alert.id}`} class="font-medium underline-offset-4 hover:underline">
              {alert.species}
            </a>
            {alert.count !== null && alert.count > 1 && (
              <span class="text-muted-foreground text-sm">{alert.count} ex.</span>
            )}
            <span class="text-muted-foreground text-sm">{alert.place}</span>
            <span class="text-muted-foreground text-sm">{alert.observer ?? ANONYMOUS_OBSERVER}</span>
            <span class="text-muted-foreground text-sm tabular-nums">
              {formatDate(alert.observedAt, "dateTime")}
            </span>
            {alert.photoUrl && <span class="text-muted-foreground text-sm">Med foto</span>}
          </div>

          {alert.hidden ? (
            <form method="POST" class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="id" value={alert.id} />
              <span class="text-destructive text-sm">
                Dolt{alert.reason && ` — ${alert.reason}`}
              </span>
              <Button type="submit" name="intent" value="show" variant="outline" className="h-11">
                Visa igen
              </Button>
            </form>
          ) : (
            <form method="POST" class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="id" value={alert.id} />
              <label class="sr-only" for={`reason-${alert.id}`}>Anledning</label>
              <Input
                id={`reason-${alert.id}`}
                name="reason"
                placeholder="Anledning (valfritt)"
                maxLength={200}
                className="h-11 min-w-48 flex-1"
              />
              <Button type="submit" name="intent" value="hide" variant="destructive" className="h-11">
                Dölj
              </Button>
            </form>
          )}
        </li>
      ))}
      {alerts && alerts.length === 0 && (
        <li class="text-muted-foreground p-3 text-sm">Inga larm ännu.</li>
      )}
    </ul>
  </div>
</AdminLayout>
