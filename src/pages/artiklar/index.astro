---
export const prerender = false

import ArticleIndex from "@/components/site/ArticleIndex.astro"
import SiteLayout from "@/layouts/site.astro"
import { decodeCursor } from "@/lib/keyset"
import {
  listArticleYears,
  listPublicCategories,
  listPublishedArticles,
  loadNavigation,
} from "@/lib/public-content"

const PAGE_SIZE = 20

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const params = Astro.url.searchParams
const [navigation, categories, years, page] = await Promise.all([
  loadNavigation(db),
  listPublicCategories(db),
  listArticleYears(db, new Date()),
  listPublishedArticles(db, {
    limit: PAGE_SIZE,
    before: decodeCursor(params.get("fore")),
    after: decodeCursor(params.get("efter")),
  }),
])
if (!page) return new Response(null, { status: 500 })
---

<SiteLayout title="Artiklar" description="Nyheter och exkursionsreferat från Markaryds Fågelklubb." menu={navigation.menu}>
  <ArticleIndex heading="Artiklar" basePath="/artiklar" categories={categories} currentCategory={null} page={page} years={years} />
</SiteLayout>
