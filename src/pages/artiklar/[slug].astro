---
export const prerender = false

import ArticleView from "@/components/site/ArticleView.astro"
import Aside from "@/components/site/Aside.astro"
import AsideArticles from "@/components/site/AsideArticles.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import SiteLayout from "@/layouts/site.astro"
import { withoutPhoto } from "@/lib/front-page"
import { listPublishedArticles, loadNavigation, loadPublishedArticle } from "@/lib/public-content"
import { isValidSlug } from "@/lib/slug"
import { pickTeaserImage, teaserText } from "@/lib/teaser"

const { db } = Astro.locals
const slug = Astro.params.slug ?? ""
if (!db || !isValidSlug(slug)) return new Response(null, { status: 404 })

const [navigation, article] = await Promise.all([
  loadNavigation(db),
  loadPublishedArticle(db, slug),
])
if (article === "error") return new Response(null, { status: 500 })
if (!article) return new Response(null, { status: 404 })

// "Mer i <kategori>" in the outer margin (docs/design.md, "Uppslaget"): the newest
// three others in the same category, a print and a title each, beside the text on a
// wide screen and after it on a phone.
const related =
  article.category_id === null
    ? null
    : await listPublishedArticles(db, { limit: 4, categoryId: article.category_id })
const ownPhoto = pickTeaserImage(article.cover, article.body_html)?.src
const more = withoutPhoto(
  (related?.articles ?? []).filter((other) => other.id !== article.id),
  ownPhoto
).slice(0, 3)
---

<SiteLayout
  title={article.title}
  description={article.excerpt || teaserText(article.body_html, article.title) || undefined}
  image={pickTeaserImage(article.cover, article.body_html)?.src}
  type="article"
  menu={navigation.menu}
>
  <ArticleView article={article}>
    {
      article.category && more.length > 0 && (
        <Aside slot="aside" label={`Mer i ${article.category.name}`} first={false}>
          <AsideNote label={`Mer i ${article.category.name}`} kind="note">
            <AsideArticles articles={more} />
            <a href={`/artiklar/kategori/${article.category.slug}`} class="action-link">
              Alla i {article.category.name}
            </a>
          </AsideNote>
        </Aside>
      )
    }
  </ArticleView>
</SiteLayout>
