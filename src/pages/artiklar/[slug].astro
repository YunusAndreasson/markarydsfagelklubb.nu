---
export const prerender = false

import ArticleList from "@/components/site/ArticleList.astro"
import ArticleTiles from "@/components/site/ArticleTiles.astro"
import ArticleView from "@/components/site/ArticleView.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import SiteLayout from "@/layouts/site.astro"
import { splitFeatured } from "@/lib/front-page"
import { listPublishedArticles, loadNavigation, loadPublishedArticle } from "@/lib/public-content"
import { isValidSlug } from "@/lib/slug"

const { db } = Astro.locals
const slug = Astro.params.slug ?? ""
if (!db || !isValidSlug(slug)) return new Response(null, { status: 404 })

const [navigation, article] = await Promise.all([
  loadNavigation(db),
  loadPublishedArticle(db, slug),
])
if (article === "error") return new Response("Artikeln kunde inte läsas just nu.", { status: 503 })
if (!article) return new Response(null, { status: 404 })

// "Mer i <kategori>": the newest three others in the same category that have
// a photo, as tiles; when none of the six has one, the newest three as a list.
const related =
  article.category_id === null
    ? null
    : await listPublishedArticles(db, { limit: 7, categoryId: article.category_id })
const others = (related?.articles ?? []).filter((other) => other.id !== article.id)
const { tiles } = splitFeatured(others, 3)
const more = tiles.length > 0 ? [] : others.slice(0, 3)
---

<SiteLayout title={article.title} description={article.excerpt || undefined} menu={navigation.menu}>
  <div class="flex flex-col gap-16">
    <ArticleView article={article} />

    {
      article.category && (tiles.length > 0 || more.length > 0) && (
        <section aria-labelledby="mer" class="flex flex-col gap-8">
          <SectionHeading id="mer">Mer i {article.category.name}</SectionHeading>
          {tiles.length > 0 ? (
            <ArticleTiles articles={tiles} headingLevel={3} />
          ) : (
            <ArticleList articles={more} headingLevel={3} years="other-years" />
          )}
        </section>
      )
    }
  </div>
</SiteLayout>
