---
import EmailLink from "@/components/site/EmailLink.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import SiteLayout from "@/layouts/site.astro"

// Prerendered, like the 404: when the database is what failed, this page can't
// depend on it. Astro serves it for any route that answers 500.
---

<SiteLayout title="Något gick fel" menu={[]} canonical={false}>
  <PageHeader
    title="Sidan kunde inte hämtas just nu"
    ingress="Felet ligger hos oss. Ladda om sidan om en stund. Larmen finns också i klubbens app."
  >
    <p slot="after" class="flex flex-wrap gap-x-8">
      <a href="/" class="action-link">Till startsidan</a>
      <EmailLink address="webmaster@markarydsfagelklubb.nu" label="Kontakta webbansvarig" class="action-link" />
    </p>
  </PageHeader>
</SiteLayout>
