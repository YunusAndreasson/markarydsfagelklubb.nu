---
export const prerender = false

import ChartFigure from "@/components/site/charts/ChartFigure.astro"
import Entry from "@/components/site/obsar/Entry.astro"
import MarginGroup from "@/components/site/obsar/MarginGroup.astro"
import NotReady from "@/components/site/obsar/NotReady.astro"
import ObsarHeader from "@/components/site/obsar/ObsarHeader.astro"
import ObsarSection from "@/components/site/obsar/ObsarSection.astro"
import Register from "@/components/site/obsar/Register.astro"
import SourceNote from "@/components/site/obsar/SourceNote.astro"
import SiteLayout from "@/layouts/site.astro"
import { linesSvg } from "@/lib/charts/svg"
import { ink } from "@/lib/charts/theme"
import { registerLetter } from "@/lib/lokal"
import { obsarStore, store } from "@/lib/obsar-data"
import { accumulation, arter, FOUNDED, shortDay } from "@/lib/obsar-stats"
import { listPublicSpecies } from "@/lib/public-alerts"
import { loadNavigation } from "@/lib/public-content"
import { buildSpecies, speciesHref, speciesLink } from "@/lib/species"
import { stockholmYear } from "@/lib/stockholm-time"

/**
 * Markarydslistan (docs/design.md, "Obsar och statistik"): every species ever
 * reported in the kommun, with the date it was first seen, grouped by the
 * decade it joined the list. The newest additions come first, because that is
 * what a member checks.
 */

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })
const kv = obsarStore()
const [navigation, allTime, names] = await Promise.all([
  loadNavigation(db),
  kv ? store.readAllTime(kv) : null,
  kv ? store.readNames(kv) : null,
])
const thisYear = stockholmYear(new Date())

/**
 * Two orders of the one list (docs/design.md, "Arter"): the order the birds
 * came, by decade, which is the list's own story; and A–Ö, the way to find a
 * bird and its page, with the club's rarity chip and the larm count. A plain
 * link switches between them, so it works with no script.
 */
const byName = Astro.url.searchParams.get("ordning") === "a-o"
// Both orders print the same row as the species register: the bird's name,
// its prefix on the club's list, and its page. A failed read of the app's
// list costs only the chips and the larm counts.
const app = await listPublicSpecies()
const species = buildSpecies(
  Object.entries(names ?? {}).map(([id, one]) => ({ id: Number(id), ...one })),
  app.ok ? app.value : []
).filter((one) => one.taxonId !== null)
const refOf = new Map(species.map((one) => [one.taxonId as number, one]))
const lastYear = new Map((allTime?.taxa ?? []).map((one) => [one.id, Number(one.last.slice(0, 4))]))
/** A long-gone bird says so; the larm count follows. Nothing else, so the rows stay light. */
const notesFor = (taxonId: number) => {
  const ref = refOf.get(taxonId)
  const last = lastYear.get(taxonId)
  return [
    last !== undefined && last < thisYear - 5 && `Senast sedd ${last}`,
    ref && ref.alertCount > 0 && (ref.alertCount === 1 ? "1 larm" : `${ref.alertCount} larm`),
  ]
}
const titleOf = (taxonId: number, fallback: string) => refOf.get(taxonId)?.name ?? fallback
const hrefOf = (taxonId: number, fallback: string) => {
  const ref = refOf.get(taxonId)
  return ref ? speciesHref(ref.slug) : speciesLink(fallback)
}
const firstSeen = new Map((allTime?.taxa ?? []).map((one) => [one.id, one.first]))
const letters = new Map<string, typeof species>()
for (const one of species) {
  const letter = registerLetter(one.name)
  letters.set(letter, [...(letters.get(letter) ?? []), one])
}

const taxa = (allTime?.taxa ?? [])
  .map((one) => ({
    ...one,
    name: names?.[one.id]?.name ?? "Okänd art",
    sci: names?.[one.id]?.sci ?? "",
  }))
  .sort((a, b) => a.first.localeCompare(b.first) || a.name.localeCompare(b.name, "sv"))
const newest = taxa.slice(-6).reverse()
const firstYear = taxa[0] ? Number(taxa[0].first.slice(0, 4)) : thisYear
const grown = allTime ? accumulation(allTime, firstYear, thisYear) : []
const atFounding = grown.find((one) => one.year === FOUNDED - 1)?.total ?? 0
const decadesOf = new Map<number, typeof taxa>()
for (const one of taxa) {
  const decade = Math.floor(Number(one.first.slice(0, 4)) / 10) * 10
  decadesOf.set(decade, [...(decadesOf.get(decade) ?? []), one])
}
const notSeenSince = taxa.filter((one) => Number(one.last.slice(0, 4)) < thisYear - 20).length

const fallback =
  grown.length > 1 &&
  linesSvg({
    width: 600,
    height: 240,
    step: true,
    lines: [{ values: grown.map((one) => one.total), color: ink.gran, width: 2.5 }],
  })
---

<SiteLayout
  title="Markarydslistan"
  description="Alla fågelarter som någonsin rapporterats i Markaryds kommun, med datum när de först sågs."
  menu={navigation.menu}
>
  <article class="flex flex-col gap-12">
    <ObsarHeader
      title="Markarydslistan"
      ingress={allTime &&
        `${arter(taxa.length)} har rapporterats i Markaryds kommun sedan ${firstYear}. När klubben bildades ${FOUNDED} var listan ${atFounding} arter lång.`}
    />

    {
      allTime && (
        <nav aria-label="Ordning" class="at-text type-meta flex flex-wrap items-center gap-x-5">
          <span class="text-muted-foreground">Ordning:</span>
          <a
            href="/obsar/markarydslistan"
            aria-current={byName ? undefined : "page"}
            class="text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:decoration-primary flex min-h-11 items-center underline-offset-[0.5em] aria-[current=page]:underline aria-[current=page]:decoration-2"
          >
            I den ordning de kom
          </a>
          <a
            href="/obsar/markarydslistan?ordning=a-o"
            aria-current={byName ? "page" : undefined}
            class="text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:decoration-primary flex min-h-11 items-center underline-offset-[0.5em] aria-[current=page]:underline aria-[current=page]:decoration-2"
          >
            A–Ö
          </a>
        </nav>
      )
    }

    {
      allTime && byName && (
        <>
          <p class="type-meta text-muted-foreground at-text measure">
            Året vid varje art är när den först sågs i kommunen. Siffran är artens prefix på klubbens
            larmlista. Varje art har en egen sida.
          </p>
          {[...letters].map(([letter, list]) => (
            <MarginGroup id={`bokstav-${letter.toLocaleLowerCase("sv")}`} label={letter}>
              <Register>
                {list.map((one) => {
                  const first = one.taxonId !== null ? firstSeen.get(one.taxonId) : undefined
                  return (
                    <Entry
                      when={first?.slice(0, 4) ?? ""}
                      datetime={first}
                      title={one.name}
                      href={speciesHref(one.slug)}
                      sci={one.sci}
                      rarity={one.rarity}
                      notes={notesFor(one.taxonId as number)}
                    />
                  )
                })}
              </Register>
            </MarginGroup>
          ))}
        </>
      )
    }

    {!allTime && <NotReady href="https://www.artportalen.se/List/Top/Species/F%C3%A5glar/Total/Kommun/Markaryd/AnySite/OrderByDate/Desc" />}

    {
      allTime && !byName && (
        <>
          <ObsarSection id="nyast" title="Senast på listan">
            <Register>
              {newest.map((one) => (
                <Entry
                  when={one.first.slice(0, 4)}
                  datetime={one.first}
                  title={titleOf(one.id, one.name)}
                  href={hrefOf(one.id, one.name)}
                  sci={one.sci}
                  rarity={refOf.get(one.id)?.rarity}
                  notes={[`Först sedd ${shortDay(one.first)}`]}
                />
              ))}
            </Register>
          </ObsarSection>

          {fallback && (
            <ObsarSection id="vaxer" title="Så har listan vuxit">
              <ChartFigure
                chart={{ kind: "accumulation", data: { points: grown, founded: FOUNDED } }}
                fallback={fallback}
                box="aspect-[4/3] sm:aspect-[16/7]"
                inset="16px 16px 28px 40px"
              >
                Antal kända arter i kommunen vid varje års slut. Varje trappsteg är en ny art.
                {notSeenSince > 0 && ` ${arter(notSeenSince)} på listan har inte rapporterats på över tjugo år.`}
              </ChartFigure>
            </ObsarSection>
          )}

          {[...decadesOf].map(([decade, list]) => (
            <MarginGroup id={`d-${decade}`} label={`${decade}-talet`} note={`${list.length} nya`}>
              <Register>
                {list.map((one) => (
                  <Entry
                    when={one.first.slice(0, 4)}
                    datetime={one.first}
                    title={titleOf(one.id, one.name)}
                    href={hrefOf(one.id, one.name)}
                    sci={one.sci}
                    rarity={refOf.get(one.id)?.rarity}
                    notes={notesFor(one.id)}
                  />
                ))}
              </Register>
            </MarginGroup>
          ))}
        </>
      )
    }

    <SourceNote fetchedAt={allTime?.fetchedAt} />
  </article>
</SiteLayout>
