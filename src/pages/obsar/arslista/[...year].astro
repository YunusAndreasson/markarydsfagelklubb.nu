---
export const prerender = false

import ChartFigure from "@/components/site/charts/ChartFigure.astro"
import Entry from "@/components/site/obsar/Entry.astro"
import MarginGroup from "@/components/site/obsar/MarginGroup.astro"
import NotReady from "@/components/site/obsar/NotReady.astro"
import Register from "@/components/site/obsar/Register.astro"
import SourceNote from "@/components/site/obsar/SourceNote.astro"
import YearStrip from "@/components/site/obsar/YearStrip.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Section from "@/components/site/Section.astro"
import SiteLayout from "@/layouts/site.astro"
import { obsarStore, store } from "@/lib/obsar-data"
import { arter, byArrivalMonth, monthName, parseYearParam, shortDay } from "@/lib/obsar-stats"
import { loadNavigation } from "@/lib/public-content"
import { stockholmYear } from "@/lib/stockholm-time"

/**
 * Årslistan (docs/design.md, "Obsar och statistik"): a year's species in the
 * order they arrived, dated in the margin like a notebook, with the year's
 * rhythm as a heatmap of the most reported species. Every year back to the
 * first record has one, which Artportalen's list needed a New Year edit for.
 */

const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })
const thisYear = stockholmYear(new Date())
const kv = obsarStore()
const [navigation, history] = await Promise.all([
  loadNavigation(db),
  kv ? store.readHistory(kv) : null,
])
const years = history?.years.map((one) => one.year) ?? []
const year = parseYearParam(Astro.params.year, years, thisYear)
if (year === null) return new Response(null, { status: 404 })
// This year lives at the plain URL; its own year URL would be a second copy.
if (year === thisYear && Astro.params.year) return Astro.redirect("/obsar/arslista", 301)
const stats = kv ? await store.readYear(kv, year) : null

const months = stats ? byArrivalMonth(stats.species) : []
/** The heatmap keeps to the 40 most reported species, so each row is readable. */
const rhythm = stats
  ? stats.species
      .toSorted((a, b) => b.reports - a.reports)
      .slice(0, 40)
      .sort((a, b) => a.first.localeCompare(b.first))
  : []
const isCurrent = year === thisYear
const title = `Årslistan ${year}`

import { speciesLink } from "@/lib/species"
import { rapporter } from "@/lib/text"
---

<SiteLayout
  title={title}
  description={`Arterna som rapporterats i Markaryds kommun ${year}, i den ordning de kom, från Artportalen.`}
  menu={navigation.menu}
>
  <article class="page-stack">
    <PageHeader
      crumbs={[{ href: "/obsar", label: "Obsar" }]}
      title={title}
      ingress={stats &&
        `${isCurrent ? "Hittills i år har" : `Under ${year} rapporterades`} ${arter(stats.speciesCount)}${isCurrent ? " rapporterats" : ""} i kommunen, i ${rapporter(stats.reports)}. Här i den ordning de först sågs.`}
    >
      {years.length > 1 && <YearStrip slot="after" years={years} current={year} base="/obsar/arslista" latest={thisYear} label="Årslistan" />}
    </PageHeader>

    {!stats && <NotReady href="https://www.artportalen.se/List/Top/Species/F%C3%A5glar/2026/Kommun/Markaryd/AnySite/OrderByDate/Desc" />}

    {
      stats && rhythm.length >= 5 && (
        <Section id="rytm" title="Årets rytm">
          <ChartFigure
            chart={{ kind: "phenology", data: { species: rhythm.map((one) => ({ name: one.name, weeks: one.weeks })) } }}
            height={`${rhythm.length * 18 + 40}px`}
          >
            De {rhythm.length} mest rapporterade arterna vecka för vecka, i den ordning de kom. Varje rad är mörkast den vecka
            arten rapporterades mest. Stannfåglarna syns hela året, flyttfåglarna bara mellan ankomst och flytt.
          </ChartFigure>
        </Section>
      )
    }

    {
      months.map((group) => (
        <MarginGroup id={`m-${group.month}`} label={monthName(group.month, true)} note={`${group.species.length} nya`}>
          <Register>
            {group.species.map((one) => (
              <Entry
                when={shortDay(one.first)}
                datetime={one.first}
                title={one.name}
                href={speciesLink(one.name)}
                sci={one.sci}
                notes={[one.reports === 1 ? rapporter(1) : `${rapporter(one.reports)}, senast ${shortDay(one.last)}`]}
              />
            ))}
          </Register>
        </MarginGroup>
      ))
    }

    <SourceNote fetchedAt={stats?.fetchedAt} />
  </article>
</SiteLayout>
