---
export const prerender = false

import { renderSVG } from "uqr"
import SiteLayout from "@/layouts/site.astro"
import { renderBody } from "@/lib/article-body"
import {
  addressMailto,
  addressSms,
  EXAMPLE_NAME,
  loadMembership,
  swishLink,
  swishMessage,
  telHref,
} from "@/lib/membership"
import { resolvePath } from "@/lib/page-tree"
import { loadNavigation, loadPageBody } from "@/lib/public-content"

// How to join (docs/design.md, "Klubben"), the target of the header's "Bli
// medlem". Everything a newcomer needs is on this one page, in the order they
// do it: what it costs, pay, write your name, send your address. The numbers
// come from membership_settings (/admin/medlemskap); the page's own row in
// /admin gives the meta description and, if there ever is any, extra text at
// the end.
const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const [navigation, membership] = await Promise.all([loadNavigation(db), loadMembership(db)])
const node = resolvePath(navigation.tree, ["om-foreningen", "medlemskap"])
if (!node) return new Response(null, { status: 404 })

const page = await loadPageBody(db, node.id)
if (page === "error") return new Response(null, { status: 500 })
if (!page) return new Response(null, { status: 404 })

const m = membership
const fees = m
  ? [
      { label: "Vuxen", amount: m.fee_adult, note: "Med Cinclus" },
      { label: `Ungdom, t.o.m. ${m.youth_max_age} år`, amount: m.fee_youth, note: "Med Cinclus" },
      {
        label: "Familjemedlem",
        amount: m.fee_family,
        note: "Bor med en vuxen medlem och delar hushållets Cinclus",
      },
    ]
  : []
// One code for every fee: the amount is left for the payer, the message is
// started for them. Black on white in both themes, because that is what a
// camera reads most reliably.
const qrTarget = m ? swishLink(m.swish, { year: m.year }) : null
const qrSvg = qrTarget ? renderSVG(qrTarget, { border: 2, ecc: "M" }) : null
const mailto = m?.contact_email ? addressMailto(m.contact_email, m.year) : null
const sms = m?.contact_phone ? addressSms(m.contact_phone, m.year) : null
const tel = m?.contact_phone ? telHref(m.contact_phone) : null
const recipient = m?.contact_name || "kassören"
// The pitch is the join page's own; the page's `description` is its one line
// in Klubben's list ("Vad det kostar och hur du betalar …"), and the meta
// description, where a plain summary serves better.
const PITCH =
  "Som medlem får du programbladet Cinclus med årets program, och du stöttar klubbens fågelskydd i Markaryds kommun."
const linkClass = "link flex min-h-11 w-fit items-center font-medium"
---

<SiteLayout
  title="Bli medlem"
  description={page.description || "Så blir du medlem i Markaryds Fågelklubb."}
  menu={navigation.menu}
>
  <article class="flex flex-col gap-12">
    <header class="grid gap-y-4 md:grid-cols-[7rem_minmax(0,38rem)]">
      <nav aria-label="Du är här" class="type-meta text-muted-foreground md:col-start-2">
        <a href="/om-foreningen" class="crumb">Klubben</a>
      </nav>
      <h1 class="type-title md:col-start-2">Bli medlem</h1>
      <p class="type-ingress text-muted-foreground md:col-start-2">{PITCH}</p>
    </header>

    {
      !m && (
        <p class="text-muted-foreground max-w-prose md:ml-[7rem]">
          Avgifterna kunde inte hämtas just nu. Ladda om sidan om en stund, eller fråga någon av{" "}
          <a href="/om-foreningen/kontaktpersoner" class="link">
            kontaktpersonerna
          </a>
          .
        </p>
      )
    }

    {
      m && (
        <section aria-labelledby="avgift" class="grid gap-y-2 md:grid-cols-[7rem_minmax(0,38rem)]">
          <h2 id="avgift" class="type-meta text-muted-foreground md:pt-[0.9rem] md:pr-4">
            Avgift {m.year}
          </h2>
          <div class="flex flex-col gap-3">
            <table class="w-full border-collapse">
              <caption class="sr-only">Medlemsavgifter {m.year}</caption>
              <tbody>
                {fees.map((fee) => {
                  const pay = swishLink(m.swish, { year: m.year, amount: fee.amount })
                  return (
                    <tr class="border-b align-baseline">
                      <th scope="row" class="py-3 pr-4 text-left font-normal">
                        <span class="type-item block">{fee.label}</span>
                        <span class="text-muted-foreground block leading-snug">{fee.note}</span>
                      </th>
                      <td class="py-3 text-right text-lg font-semibold whitespace-nowrap tabular-nums">{fee.amount} kr</td>
                      {/* On a phone, open Swish with this amount; a computer has the QR code below. */}
                      {pay && (
                        <td class="hidden py-3 pl-4 text-right pointer-coarse:table-cell">
                          <a href={pay} class="link inline-flex min-h-11 items-center font-medium">
                            Swisha<span class="sr-only"> {fee.amount} kr</span>
                          </a>
                        </td>
                      )}
                    </tr>
                  )
                })}
              </tbody>
            </table>
            <p class="text-muted-foreground">Avgiften gäller kalenderåret {m.year}.</p>
          </div>
        </section>
      )
    }

    {
      m && (
        <section aria-labelledby="sa-blir-du-medlem" class="grid gap-y-2 md:grid-cols-[7rem_minmax(0,38rem)]">
          <h2 id="sa-blir-du-medlem" class="type-meta text-muted-foreground md:pt-[0.3rem] md:pr-4">
            Så blir du medlem
          </h2>
          <div class="flex flex-col gap-8">
            {/* role="list": Safari drops the list from the accessibility tree once list-style is none. */}
            <ol role="list" class="flex flex-col gap-8">
              <li class="grid grid-cols-[1.75rem_minmax(0,1fr)]">
                <span aria-hidden="true" class="text-lg font-semibold tabular-nums">1</span>
                <div class="flex flex-col gap-1">
                  {m.swish ? (
                    <p class="text-lg leading-relaxed">
                      Swisha avgiften till <span class="font-semibold whitespace-nowrap tabular-nums">{m.swish}</span><span class="hidden pointer-coarse:inline">, eller tryck på Swisha vid din avgift</span>.
                    </p>
                  ) : (
                    <p class="text-lg leading-relaxed">Betala avgiften till klubbens bankgiro.</p>
                  )}
                  {m.bankgiro && (
                    <p class="text-muted-foreground leading-relaxed">
                      {m.swish ? "Du kan också betala till bankgiro " : "Bankgiro "}
                      <span class="whitespace-nowrap">{m.bankgiro}</span>.
                    </p>
                  )}
                  {qrSvg && (
                    <figure class="mt-4 hidden items-end gap-4 pointer-fine:flex">
                      <div role="img" aria-label="QR-kod som öppnar Swish med klubbens nummer" class="w-40 shrink-0 overflow-hidden rounded-[4px] [&_svg]:block [&_svg]:size-full" set:html={qrSvg} />
                      <figcaption class="text-muted-foreground max-w-48 text-sm leading-snug">
                        Skanna med mobilens kamera, så öppnas Swish med numret och meddelandet ifyllt.
                      </figcaption>
                    </figure>
                  )}
                </div>
              </li>
              <li class="grid grid-cols-[1.75rem_minmax(0,1fr)]">
                <span aria-hidden="true" class="text-lg font-semibold tabular-nums">2</span>
                <div class="flex flex-col gap-1">
                  <p class="text-lg leading-relaxed">Skriv ditt namn och ”medlem {m.year}” i meddelandet.</p>
                  <p class="text-muted-foreground leading-relaxed">Till exempel: {swishMessage(m.year, EXAMPLE_NAME)}</p>
                </div>
              </li>
              <li class="grid grid-cols-[1.75rem_minmax(0,1fr)]">
                <span aria-hidden="true" class="text-lg font-semibold tabular-nums">3</span>
                <div class="flex flex-col gap-1">
                  <p class="text-lg leading-relaxed">Skicka din postadress till {recipient}, så att Cinclus kommer fram.</p>
                  {(mailto || sms) && (
                    <>
                      <p class="flex flex-wrap gap-x-6">
                        {mailto && <a href={mailto} class={linkClass}>Skicka e-post</a>}
                        {sms && <a href={sms} class={linkClass}>Skicka sms</a>}
                      </p>
                      <p class="text-muted-foreground leading-relaxed">Meddelandet är redan skrivet, du fyller bara i namn och adress.</p>
                    </>
                  )}
                </div>
              </li>
            </ol>
            <p class="text-lg leading-relaxed">Sedan är du medlem. Cinclus med årets program kommer i brevlådan i mitten av januari.</p>
          </div>
        </section>
      )
    }

    {page.body_html && <div class="content md:ml-[7rem]" set:html={renderBody(page.body_html)} />}

    {
      m && (m.contact_name || tel || m.contact_email) && (
        <section aria-labelledby="fragor" class="grid gap-y-1 md:grid-cols-[7rem_minmax(0,38rem)]">
          <h2 id="fragor" class="type-meta text-muted-foreground md:pt-[0.3rem] md:pr-4">
            Frågor
          </h2>
          <div class="flex flex-col gap-1">
            {m.contact_name && <p class="text-lg">{m.contact_name}</p>}
            <p class="flex flex-wrap gap-x-6">
              {tel && <a href={tel} class={linkClass}>{m.contact_phone}</a>}
              {m.contact_email && <a href={`mailto:${m.contact_email}`} class={linkClass}>{m.contact_email}</a>}
            </p>
          </div>
        </section>
      )
    }
  </article>
</SiteLayout>
