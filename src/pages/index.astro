---
import { buttonVariants } from "@/components/ui/button"
import BaseLayout from "@/layouts/base.astro"

// Prerendered, zero client JS. A placeholder until the first public pages land.
---

<BaseLayout
  title="Markaryds Fågelklubb"
  description="Markaryds Fågelklubbs nya webbplats är under uppbyggnad."
>
  <main class="mx-auto flex min-h-svh w-full max-w-2xl flex-col justify-center gap-6 px-4 py-12 sm:px-6">
    <p class="text-primary text-sm font-medium">Under uppbyggnad</p>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Markaryds Fågelklubb
    </h1>
    <p class="text-muted-foreground max-w-prose text-lg leading-8 text-pretty">
      Vi bygger en ny webbplats för klubben. Till dess finns allt som vanligt på den nuvarande
      sidan.
    </p>
    <div>
      <a class={buttonVariants({ size: "lg" })} href="https://www.markarydsfagelklubb.nu">
        Till markarydsfagelklubb.nu
      </a>
    </div>
  </main>
</BaseLayout>
