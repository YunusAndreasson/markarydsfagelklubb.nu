---
export const prerender = false

import AppLinks from "@/components/site/AppLinks.astro"
import ArticleList from "@/components/site/ArticleList.astro"
import ArticleTiles from "@/components/site/ArticleTiles.astro"
import LarmBand from "@/components/site/LarmBand.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import Sponsors from "@/components/site/Sponsors.astro"
import SiteLayout from "@/layouts/site.astro"
import { linkPhones } from "@/lib/article-body"
import { eventStatus, eventStatusLabel } from "@/lib/event-status"
import { buildDayList, latestPrints, pickLead, splitFeatured, withoutPhoto } from "@/lib/front-page"
import { listPublicAlerts } from "@/lib/public-alerts"
import { listPublishedArticles, listUpcomingEvents, loadNavigation } from "@/lib/public-content"
import { formatDate, isoDateTime, startOfStockholmDay } from "@/lib/stockholm-time"
import { isHeroWorthy } from "@/lib/teaser"

// The club's day and magazine (docs/design.md, "Larmbandet", "Tidskriften"): one
// sentence and the newest larm photos on the spruce band, the page's one block of larm;
// the newest article as the lead, on a wide photo when it has one, with the
// programme beside it; then three more articles with their photos and the rest as a
// dated list. front-page.ts decides what goes where; this file only lays it out.

// One read serves the day list and the rail. Far above the
// busiest day so far (43 larm), and it reaches back past a day of photo-less
// reports for the rail.
const LARM_WINDOW = 200
const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const now = new Date()
const [navigation, page, larm, upcoming] = await Promise.all([
  loadNavigation(db),
  listPublishedArticles(db, { limit: 10 }),
  listPublicAlerts({ limit: LARM_WINDOW }),
  listUpcomingEvents(db, { limit: 3, from: startOfStockholmDay(now) }),
])
const { lead, rest } = pickLead(page?.articles ?? [])
const leadImage = lead?.image && isHeroWorthy(lead.image) ? lead.image : null
const { tiles, list } = splitFeatured(withoutPhoto(rest, leadImage?.src), 3)
// A larm failure costs the section, never the home page.
const alerts = larm.ok ? larm.value.alerts : []
const dayList = buildDayList(alerts, now)
const prints = latestPrints(alerts, 5, now)
// The same for the programme: nothing at all when it is empty.
const events = upcoming ?? []
---

<SiteLayout menu={navigation.menu} image={leadImage?.src}>
  <LarmBand slot="band" list={dayList} prints={prints} now={now} />

  <h1 class="sr-only">Markaryds Fågelklubb</h1>

  {/* The sponsors, twice, one shown at a time (docs/design.md, "Sponsorer"):
      from md up a credit line over the lead, as a magazine credits a sponsor
      beside its masthead; on a phone, where it would push the lead photo off
      the first screen, after the lead and the programme. */}
  <Sponsors class="hidden md:-mt-8 md:mb-4 md:flex md:justify-end" />

  {
    !lead && (
      <p class="text-muted-foreground max-w-prose md:pl-[7rem]">
        {page ? "Här kommer klubbens nyheter att synas." : "Nyheterna kunde inte hämtas just nu. Ladda om sidan om en stund."}
      </p>
    )
  }

  <div class="flex flex-col gap-6 md:gap-8 lg:grid lg:grid-cols-[7rem_minmax(0,38rem)_minmax(0,1fr)] lg:gap-x-0 lg:gap-y-8">
    {
      lead && leadImage && (
        /* The photo repeats the headline's link, so it is hidden from the
           accessibility tree and kept out of the tab order. */
        <a href={`/artiklar/${lead.slug}`} tabindex="-1" aria-hidden="true" class="-mx-4 block sm:mx-0 lg:col-span-3">
          <img
            src={leadImage.src}
            srcset={leadImage.srcset || undefined}
            sizes="(min-width: 64rem) 61rem, 100vw"
            width={leadImage.width}
            height={leadImage.height}
            alt=""
            fetchpriority="high"
            class="bg-muted aspect-3/2 w-full object-cover sm:rounded-[4px] md:aspect-3/1"
          />
        </a>
      )
    }

    {
      lead && (
        <article class="grid gap-y-3 md:grid-cols-[7rem_minmax(0,38rem)] lg:col-span-2">
          <p class="type-meta text-muted-foreground flex flex-wrap items-center gap-x-3 md:flex-col md:items-start md:gap-y-1.5 md:pt-[0.9rem]">
            <time datetime={isoDateTime(lead.published_at)} class="flex flex-wrap gap-x-1 md:flex-col">
              <span>{formatDate(lead.published_at, "weekdayName")}</span>
              <span>{formatDate(lead.published_at, "dayMonth")}</span>
            </time>
            {lead.category && (
              <a href={`/artiklar/kategori/${lead.category.slug}`} class="crumb">
                {lead.category.name}
              </a>
            )}
          </p>
          <div class="flex flex-col gap-4">
            <h2 class="type-display">
              <a href={`/artiklar/${lead.slug}`} class="decoration-primary underline-offset-[0.12em] hover:underline hover:decoration-4">
                {lead.title}
              </a>
            </h2>
            {lead.excerpt && <p class="type-ingress text-muted-foreground max-w-[38rem]">{lead.excerpt}</p>}
            {lead.opening.paragraphs.length > 0 && (
              <div class="content" set:html={linkPhones(lead.opening.paragraphs.map((paragraph) => `<p>${paragraph}</p>`).join(""))} />
            )}
            {lead.opening.more && (
              <a href={`/artiklar/${lead.slug}`} class="link flex min-h-11 w-fit items-center font-medium">
                Läs hela artikeln
              </a>
            )}
          </div>
        </article>
      )
    }

    {/* The rail beside the headline: what members use, quieter than what they read. */}
    <div class="flex flex-col gap-8 md:pl-[7rem] lg:col-start-3 lg:pt-[0.9rem] lg:pl-10">
      {
        events.length > 0 && (
          <section aria-labelledby="narmast" class="flex flex-col gap-3">
            <h2 id="narmast" class="type-meta text-muted-foreground">Närmast i programmet</h2>
            <ol class="flex flex-col gap-3">
              {events.map((event) => {
                const status = eventStatusLabel(eventStatus(event, now))
                return (
                  <li class="flex flex-col">
                    <time datetime={isoDateTime(event.starts_at)} class:list={["type-meta", status ? "text-primary font-semibold" : "text-muted-foreground"]}>
                      {status ?? formatDate(event.starts_at, "weekday")}
                      {!status && !event.all_day && ` ${formatDate(event.starts_at, "clock")}`}
                    </time>
                    <a href={`/kalender/${event.slug}`} class="decoration-primary inline-block py-0.5 leading-snug font-medium text-pretty underline-offset-4 hover:underline">
                      {event.title}
                    </a>
                  </li>
                )
              })}
            </ol>
            <a href="/kalender" class="link flex min-h-11 w-fit items-center font-medium">
              Hela programmet
            </a>
          </section>
        )
      }
      <section aria-labelledby="appen" class="flex flex-col gap-1">
        <h2 id="appen" class="type-meta text-muted-foreground">Få larmen direkt i mobilen</h2>
        <AppLinks sentence={false} />
      </section>
    </div>
  </div>

  <Sponsors class="mt-12 md:hidden" />

  {
    (tiles.length > 0 || list.length > 0) && (
      <section aria-labelledby="artiklar" class="mt-16 flex flex-col gap-10 md:mt-24">
        <SectionHeading id="artiklar" href="/artiklar" link="Alla artiklar">
          Fler artiklar
        </SectionHeading>
        {tiles.length > 0 && <ArticleTiles articles={tiles} headingLevel={3} showCategory />}
        {list.length > 0 && <ArticleList articles={list.slice(0, 6)} headingLevel={3} years="other-years" />}
      </section>
    )
  }
</SiteLayout>
