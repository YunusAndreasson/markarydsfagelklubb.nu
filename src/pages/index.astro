---
export const prerender = false

import AppLinks from "@/components/site/AppLinks.astro"
import ArticleList from "@/components/site/ArticleList.astro"
import ArticleTiles from "@/components/site/ArticleTiles.astro"
import Aside from "@/components/site/Aside.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import EmptyNote from "@/components/site/EmptyNote.astro"
import EventList from "@/components/site/EventList.astro"
import HomeLead from "@/components/site/HomeLead.astro"
import LarmBand from "@/components/site/LarmBand.astro"
import BirdRow from "@/components/site/obsar/BirdRow.astro"
import JubileeBand from "@/components/site/obsar/JubileeBand.astro"
import Section from "@/components/site/Section.astro"
import Sponsors from "@/components/site/Sponsors.astro"
import SiteLayout from "@/layouts/site.astro"
import {
  arrangeArticles,
  buildDayList,
  latestPrints,
  pickLead,
  withoutPhoto,
} from "@/lib/front-page"
import { obsarStore, store } from "@/lib/obsar-data"
import { PAST_SHOWN, pickPast, windowMonths } from "@/lib/past-sightings"
import { listPublicAlerts, listSpeciesRarity } from "@/lib/public-alerts"
import { listPublishedArticles, listUpcomingEvents, loadNavigation } from "@/lib/public-content"
import { thisWeek } from "@/lib/season"
import { buildSpecies, taxonSlugs } from "@/lib/species"
import { startOfStockholmDay, stockholmYear, toStockholmInputValue } from "@/lib/stockholm-time"
import { websiteNode } from "@/lib/structured-data"
import { isHeroWorthy } from "@/lib/teaser"
import { takenTransitionNames, transitionName } from "@/lib/view-transition"

// The club's day and magazine, then the kommun's birds (docs/design.md,
// "Larmbandet", "Tidskriften", "Uppslaget", "Spalterna"). The club's own: one
// sentence and the newest larm photos on the spruce band, the page's one block of
// larm; the newest article as the lead, beside its photo, or beside the next story
// when it has none; the programme as a section of its own; three more articles
// with their photos and the rest as a dated list. Then the kommun's records from
// Artportalen: one row of time (this year, this season, earlier years around this
// date) and the jubilee band's forty years to close. front-page.ts decides what
// goes where; this file only lays it out.

// One read serves the day list and the rail. Far above the
// busiest day so far (43 larm), and it reaches back past a day of photo-less
// reports for the rail.
const LARM_WINDOW = 200
const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const now = new Date()
// The kommun's birds and the jubilee band read the statistics store
// (docs/design.md, "Obsar och statistik"); like larm, a failure costs the
// section, never the page.
const kv = obsarStore()
const thisYear = stockholmYear(now)
const today = toStockholmInputValue(now).slice(0, 10)
const [
  navigation,
  page,
  larm,
  upcoming,
  history,
  allTime,
  yearStats,
  recent,
  season,
  names,
  pastMonths,
  clubRarity,
] = await Promise.all([
  loadNavigation(db),
  listPublishedArticles(db, { limit: 10 }),
  listPublicAlerts({ limit: LARM_WINDOW }),
  listUpcomingEvents(db, { limit: 3, from: startOfStockholmDay(now) }),
  kv ? store.readHistory(kv).catch(() => null) : null,
  kv ? store.readAllTime(kv).catch(() => null) : null,
  kv ? store.readYear(kv, thisYear).catch(() => null) : null,
  kv ? store.readRecent(kv).catch(() => null) : null,
  kv ? store.readSeason(kv).catch(() => null) : null,
  kv ? store.readNames(kv).catch(() => null) : null,
  // "I backspegeln": one or two month keys, joined to the club's prefixes.
  kv
    ? Promise.all(windowMonths(today).map((month) => store.readPast(kv, month))).catch(() => [])
    : [],
  listSpeciesRarity(),
])
const { lead, rest } = pickLead(page?.articles ?? [])
const leadImage = lead?.image && isHeroWorthy(lead.image) ? lead.image : null
// A lead photo too narrow or too tall for the 3:2 spread, such as a poster, still
// leads: whole, beside the headline in the outer margin (docs/design.md, "Kontaktark").
const leadAside =
  lead?.image && !leadImage && lead.image.width >= 480 && lead.image.height > 0 ? lead.image : null
const leadPicture = leadImage ?? leadAside
const { nextStory, tiles, list } = arrangeArticles(
  withoutPhoto(rest, leadPicture?.src),
  leadPicture !== null
)
const seasonWeek = thisWeek(season, now, yearStats)
const seasonSlugs = taxonSlugs(
  buildSpecies(
    Object.entries(names ?? {}).map(([id, one]) => ({ id: Number(id), ...one })),
    []
  )
)
// Without the club's prefixes nothing can be called rare: no section.
const past = clubRarity.ok ? pickPast(pastMonths, clubRarity.value, today).slice(0, PAST_SHOWN) : []
// A larm failure costs the section, never the home page.
const alerts = larm.ok ? larm.value.alerts : []
const dayList = buildDayList(alerts, now)
const prints = latestPrints(alerts, 5, now)
// The same for the programme: nothing at all when it is empty.
const events = upcoming ?? []

// One set per page, shared by every list on it (lib/view-transition.ts). The lead's
// photo asks first; the next story's name is shared by its two copies, beside the
// lead from lg and the first tile below, since only one is ever displayed.
const taken = takenTransitionNames(Astro.locals)
const leadTransition = lead && leadPicture ? transitionName(taken, "artikel", lead.id) : undefined
const nextTransition = nextStory ? transitionName(taken, "artikel", nextStory.id) : undefined
---

<SiteLayout menu={navigation.menu} image={leadImage?.src} jsonLd={[websiteNode()]}>
  {/* The page's h1 first, in the band slot ahead of the larm band, so a screen
      reader moving by heading meets it before the band's h2. */}
  <h1 slot="band" class="sr-only">Markaryds Fågelklubb</h1>
  <LarmBand slot="band" list={dayList} prints={prints} now={now} />

  {/* The sponsors, twice, one shown at a time (docs/design.md, "Sponsorer"):
      from md up a credit line over the lead, as a magazine credits a sponsor
      beside its masthead; on a phone, where it would push the lead photo off
      the first screen, after the lead and the programme. */}
  <Sponsors class="hidden md:-mt-8 md:mb-4 md:flex md:justify-end" />

  <div class="page-stack">
  {
    !lead && (
      <EmptyNote>
        {page ? "Här kommer nyheterna att synas." : "Nyheterna kunde inte hämtas just nu. Ladda om sidan om en stund."}
      </EmptyNote>
    )
  }

  {
    lead && (
      <HomeLead
        lead={lead}
        image={leadImage}
        poster={leadAside}
        nextStory={nextStory}
        transition={leadTransition}
        nextTransition={nextTransition}
      />
    )
  }

  {/* The programme, the one invitation a newcomer can act on, as a section of
      its own rather than three small lines in a rail. The ways to keep up with
      the club sit beside it in the outer margin. */}
  {
    events.length > 0 && (
      <Section id="narmast" title="Närmast i programmet" href="/kalender" link="Hela programmet" layout="spread" wide>
        <div class="in-wide">
          <EventList events={events} headingLevel={3} />
        </div>
        <Aside label="Följ klubben" sticky={false} first={false}>
          <AsideNote label="Programmet i din kalender" headingLevel={3} kind="note">
            <p class="text-muted-foreground">
              <a href="/kalender.ics" class="link">Prenumerera på programmet</a>, så kommer ändringar med automatiskt.
            </p>
          </AsideNote>
          <AsideNote label="Få larmen direkt i mobilen" headingLevel={3} kind="note">
            <AppLinks sentence={false} />
          </AsideNote>
        </Aside>
      </Section>
    )
  }

  {
    events.length === 0 && (
      <section aria-labelledby="appen" class="flex flex-col gap-1.5">
        <h2 id="appen" class="type-label">Få larmen direkt i mobilen</h2>
        <AppLinks sentence={false} />
      </section>
    )
  }

  <Sponsors class="md:hidden" />

  {/* Photos may take the whole width; the dated list keeps its dates in the
      margin. Four in the list: the archive is one click away. */}
  {
    (tiles.length > 0 || list.length > 0) && (
      <Section id="artiklar" title="Fler artiklar" href="/artiklar" link="Alla artiklar" layout="spread" wide>
        <div class="in-full flex flex-col gap-12">
          {tiles.length > 0 && (
            <ArticleTiles
              articles={tiles}
              headingLevel={3}
              showCategory
              besideLead={nextStory !== null}
              firstTransition={nextTransition}
            />
          )}
          {list.length > 0 && <ArticleList articles={list.slice(0, 4)} headingLevel={3} years="other-years" />}
        </div>
      </Section>
    )
  }

  {/* The kommun's birds as one row of time: this year, this season, earlier
      years around this date; the forty years in the jubilee band close the page. */}
  <BirdRow
    stats={yearStats}
    recent={recent}
    week={seasonWeek}
    past={past}
    slugs={seasonSlugs}
    now={now}
    today={today}
  />

  {
    history && history.years.length > 10 && (
      <JubileeBand history={history} allTime={allTime} thisYear={thisYear} contained />
    )
  }
  </div>
</SiteLayout>
