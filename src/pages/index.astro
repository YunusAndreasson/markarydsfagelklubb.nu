---
export const prerender = false

import AppLinks from "@/components/site/AppLinks.astro"
import ArticleList from "@/components/site/ArticleList.astro"
import ArticleTiles from "@/components/site/ArticleTiles.astro"
import Aside from "@/components/site/Aside.astro"
import AsideNote from "@/components/site/AsideNote.astro"
import EventList from "@/components/site/EventList.astro"
import HomeSection from "@/components/site/HomeSection.astro"
import LarmBand from "@/components/site/LarmBand.astro"
import JubileeBand from "@/components/site/obsar/JubileeBand.astro"
import ObsarHome from "@/components/site/obsar/ObsarHome.astro"
import Sponsors from "@/components/site/Sponsors.astro"
import SeasonBlock from "@/components/site/species/SeasonBlock.astro"
import SiteLayout from "@/layouts/site.astro"
import { linkPhones } from "@/lib/article-body"
import { hideEmails } from "@/lib/email-hiding"
import { buildDayList, latestPrints, pickLead, splitFeatured, withoutPhoto } from "@/lib/front-page"
import { obsarStore, store } from "@/lib/obsar-data"
import { listPublicAlerts } from "@/lib/public-alerts"
import { listPublishedArticles, listUpcomingEvents, loadNavigation } from "@/lib/public-content"
import { thisWeek } from "@/lib/season"
import { buildSpecies, taxonSlugs } from "@/lib/species"
import { formatDate, isoDateTime, startOfStockholmDay, stockholmYear } from "@/lib/stockholm-time"
import { isHeroWorthy } from "@/lib/teaser"
import { transitionName } from "@/lib/view-transition"

// The club's day and magazine (docs/design.md, "Larmbandet", "Tidskriften",
// "Uppslaget"): one sentence and the newest larm photos on the spruce band, the
// page's one block of larm; the newest article as the lead, beside its photo when it
// has one; the programme as a section of its own; the kommun's birds; then three more
// articles with their photos and the rest as a dated list. front-page.ts decides what goes where; this file only lays it out.

// One read serves the day list and the rail. Far above the
// busiest day so far (43 larm), and it reaches back past a day of photo-less
// reports for the rail.
const LARM_WINDOW = 200
const { db } = Astro.locals
if (!db) return new Response(null, { status: 500 })

const now = new Date()
// The kommun's birds and the jubilee band read the statistics store
// (docs/design.md, "Obsar och statistik"); like larm, a failure costs the
// section, never the page.
const kv = obsarStore()
const thisYear = stockholmYear(now)
const [navigation, page, larm, upcoming, history, allTime, yearStats, recent, season, names] =
  await Promise.all([
    loadNavigation(db),
    listPublishedArticles(db, { limit: 10 }),
    listPublicAlerts({ limit: LARM_WINDOW }),
    listUpcomingEvents(db, { limit: 3, from: startOfStockholmDay(now) }),
    kv ? store.readHistory(kv).catch(() => null) : null,
    kv ? store.readAllTime(kv).catch(() => null) : null,
    kv ? store.readYear(kv, thisYear).catch(() => null) : null,
    kv ? store.readRecent(kv).catch(() => null) : null,
    kv ? store.readSeason(kv).catch(() => null) : null,
    kv ? store.readNames(kv).catch(() => null) : null,
  ])
const { lead, rest } = pickLead(page?.articles ?? [])
const leadImage = lead?.image && isHeroWorthy(lead.image) ? lead.image : null
// A lead photo too narrow or too tall for the 3:2 spread, such as a poster, still
// leads: whole, beside the headline in the outer margin (docs/design.md, "Kontaktark").
const leadAside =
  lead?.image && !leadImage && lead.image.width >= 480 && lead.image.height > 0 ? lead.image : null
const { tiles, list } = splitFeatured(withoutPhoto(rest, (leadImage ?? leadAside)?.src), 3)
const seasonWeek = thisWeek(season, now, yearStats)
const seasonSlugs = taxonSlugs(
  buildSpecies(
    Object.entries(names ?? {}).map(([id, one]) => ({ id: Number(id), ...one })),
    []
  )
)
// A larm failure costs the section, never the home page.
const alerts = larm.ok ? larm.value.alerts : []
const dayList = buildDayList(alerts, now)
const prints = latestPrints(alerts, 5, now)
// The same for the programme: nothing at all when it is empty.
const events = upcoming ?? []

// One set per page, shared by every list on it (lib/view-transition.ts).
Astro.locals.transitionNames ??= new Set()
const taken = Astro.locals.transitionNames
---

<SiteLayout menu={navigation.menu} image={leadImage?.src}>
  <LarmBand slot="band" list={dayList} prints={prints} now={now} />

  <h1 class="sr-only">Markaryds Fågelklubb</h1>

  {/* The sponsors, twice, one shown at a time (docs/design.md, "Sponsorer"):
      from md up a credit line over the lead, as a magazine credits a sponsor
      beside its masthead; on a phone, where it would push the lead photo off
      the first screen, after the lead and the programme. */}
  <Sponsors class="hidden md:-mt-8 md:mb-4 md:flex md:justify-end" />

  {
    !lead && (
      <p class="at-text text-muted-foreground">
        {page ? "Här kommer klubbens nyheter att synas." : "Nyheterna kunde inte hämtas just nu. Ladda om sidan om en stund."}
      </p>
    )
  }

  {/* The lead as a spread (docs/design.md, "Uppslaget"): from lg up the photo
      at 3:2 on the left and the headline beside it, so neither the bird nor the
      headline is cut by a 3:1 band. Without a hero photo it is type alone, on
      the margin and the text track. On a phone the photo comes full-bleed first. */}
  {
    lead && (
      <article
        class:list={[
          // Not "flex" on both: it beat "spread", so a lead without a hero photo
          // never sat on the margin and text tracks.
          leadImage
            ? "flex flex-col gap-5 lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-x-10"
            : "spread gap-y-4",
        ]}
      >
        {leadImage && (
          /* The photo repeats the headline's link, so it is hidden from the
             accessibility tree and kept out of the tab order. */
          <a href={`/artiklar/${lead.slug}`} tabindex="-1" aria-hidden="true" class="-mx-4 block sm:mx-0">
            <img
              src={leadImage.src}
              srcset={leadImage.srcset || undefined}
              sizes="(min-width: 72rem) 40rem, (min-width: 64rem) 58vw, 100vw"
              width={leadImage.width}
              height={leadImage.height}
              alt=""
              fetchpriority="high"
              class="bg-muted aspect-3/2 w-full object-cover sm:rounded-[4px]"
              style={transitionName(taken, "artikel", lead.id)}
            />
          </a>
        )}
        <p
          class:list={[
            "type-meta text-muted-foreground flex flex-wrap items-center gap-x-3",
            !leadImage && "md:in-margin md:flex-col md:items-start md:gap-y-1.5 md:pt-[0.15rem]",
            leadImage && "lg:hidden",
          ]}
        >
          <time datetime={isoDateTime(lead.published_at)} class:list={["flex flex-wrap gap-x-1", !leadImage && "md:flex-col"]}>
            <span>{formatDate(lead.published_at, "weekdayName")}</span>
            <span>{formatDate(lead.published_at, "dayMonth")}</span>
          </time>
          {lead.category && (
            /* From md, without a hero photo, the category stands over the headline
               instead: "Föreningsaktuellt" is wider than the 7rem margin, and Gecko
               won't hyphenate it there. */
            <a href={`/artiklar/kategori/${lead.category.slug}`} class:list={["crumb", !leadImage && "md:hidden"]}>
              {lead.category.name}
            </a>
          )}
        </p>
        <div class:list={["flex flex-col gap-4", !leadImage && "in-text"]}>
          {!leadImage && lead.category && (
            <p class="type-meta text-muted-foreground -mb-2 hidden md:flex">
              <a href={`/artiklar/kategori/${lead.category.slug}`} class="crumb">
                {lead.category.name}
              </a>
            </p>
          )}
          {leadImage && (
            <p class="type-meta text-muted-foreground hidden flex-wrap items-center gap-x-3 lg:flex">
              <time datetime={isoDateTime(lead.published_at)}>
                {formatDate(lead.published_at, "weekday")}
              </time>
              {lead.category && (
                <a href={`/artiklar/kategori/${lead.category.slug}`} class="crumb">
                  {lead.category.name}
                </a>
              )}
            </p>
          )}
          <h2 class="type-display">
            <a href={`/artiklar/${lead.slug}`} class="decoration-primary underline-offset-[0.12em] hover:underline hover:decoration-4">
              {lead.title}
            </a>
          </h2>
          {lead.excerpt && <p class="type-ingress text-muted-foreground measure">{lead.excerpt}</p>}
          {lead.opening.paragraphs.length > 0 && (
            <div class="content" set:html={hideEmails(linkPhones(lead.opening.paragraphs.map((paragraph) => `<p>${paragraph}</p>`).join("")))} />
          )}
          {lead.opening.more && (
            <a href={`/artiklar/${lead.slug}`} class="link flex min-h-11 w-fit items-center font-medium">
              Läs hela artikeln
            </a>
          )}
        </div>
        {leadAside && (
          /* Like the hero photo, a repeat of the headline's link: hidden from the
             accessibility tree and the tab order. The article page carries its alt. */
          <a
            href={`/artiklar/${lead.slug}`}
            tabindex="-1"
            aria-hidden="true"
            class="in-aside block w-full max-w-[60%] self-start sm:max-w-[16rem] lg:row-start-1 lg:max-w-none lg:pt-3"
          >
            <img
              src={leadAside.src}
              srcset={leadAside.srcset || undefined}
              sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 16rem, 60vw"
              width={leadAside.width}
              height={leadAside.height}
              alt=""
              fetchpriority="high"
              class="bg-muted h-auto w-full rounded-[4px]"
              style={transitionName(taken, "artikel", lead.id)}
            />
          </a>
        )}
      </article>
    )
  }

  {/* The programme, the one invitation a newcomer can act on, as a section of
      its own rather than three small lines in a rail. The ways to keep up with
      the club sit beside it in the outer margin. */}
  {
    events.length > 0 && (
      <HomeSection id="narmast" title="Närmast i programmet" href="/kalender" link="Hela programmet">
        <div class="in-wide">
          <EventList events={events} headingLevel={3} />
        </div>
        <Aside label="Håll dig uppdaterad" sticky={false} first={false}>
          <AsideNote label="Programmet i din kalender" headingLevel={3}>
            <p class="text-muted-foreground leading-relaxed">
              <a href="/kalender.ics" class="link font-medium">Prenumerera</a>, så kommer ändringar med automatiskt.
            </p>
          </AsideNote>
          <AsideNote label="Få larmen direkt i mobilen" headingLevel={3}>
            <AppLinks sentence={false} />
          </AsideNote>
        </Aside>
      </HomeSection>
    )
  }

  {
    events.length === 0 && (
      <section aria-labelledby="appen" class="at-text mt-16 flex flex-col gap-1 md:mt-24">
        <h2 id="appen" class="type-meta text-muted-foreground">Få larmen direkt i mobilen</h2>
        <AppLinks sentence={false} />
      </section>
    )
  }

  <Sponsors class="mt-16 md:hidden" />

  <ObsarHome stats={yearStats} recent={recent} now={now} />

  {/* "Så här års" (docs/design.md): what usually arrives or leaves around
      now, from Artportalen's history. Links are built from Artportalen's own
      names, so the page needs no read of the app's species list; a species
      page answers a differently spelled slug with a 301. */}
  {
    (seasonWeek.arriving.length > 0 || seasonWeek.leaving.length > 0) && (
      <HomeSection id="veckan" title="Så här års" href="/obsar/markarydslistan?ordning=a-o" link="Alla arter">
        <div class="in-wide">
          <SeasonBlock week={seasonWeek} slugs={seasonSlugs} headingId="veckan" />
        </div>
      </HomeSection>
    )
  }

  {/* Photos may take the whole width; the dated list keeps its dates in the
      margin. Four in the list: the archive is one click away. */}
  {
    (tiles.length > 0 || list.length > 0) && (
      <HomeSection id="artiklar" title="Fler artiklar" href="/artiklar" link="Alla artiklar">
        <div class="in-full flex flex-col gap-12">
          {tiles.length > 0 && <ArticleTiles articles={tiles} headingLevel={3} showCategory />}
          {list.length > 0 && <ArticleList articles={list.slice(0, 4)} headingLevel={3} years="other-years" />}
        </div>
      </HomeSection>
    )
  }

  {
    history && history.years.length > 10 && (
      <div class="mt-16 md:mt-24">
        <JubileeBand history={history} allTime={allTime} thisYear={thisYear} contained />
      </div>
    )
  }
</SiteLayout>
