---
// The document shell every page shares: the head. It queries
// nothing, so the prerendered 404 can use it at build time. The public header
// and menu live in site.astro, the admin chrome in admin.astro.

import alegreyaLatin from "@fontsource-variable/alegreya/files/alegreya-latin-wght-normal.woff2"
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2"
import appleTouchIcon from "@/assets/apple-touch-icon.png"
import icon from "@/assets/icon-64.png"
import { APP_STORE_ID } from "@/lib/app-stores"
import { SITE_ORIGIN } from "@/lib/canonical-host"
import { type Alternate, ogLocale, type SiteLang } from "@/lib/languages"
import "@/styles/global.css"

interface Props {
  title: string
  description?: string
  /**
   * The picture a shared link shows (Open Graph): an article's photo, a larm's.
   * Root-relative or absolute; made absolute against the request here.
   */
  image?: string
  type?: "website" | "article"
  /** The page's language: Swedish but for the visitor pages (docs/design.md, "Besökare"). */
  lang?: SiteLang
  /** The same page in other languages, itself included, for hreflang. */
  alternates?: readonly Alternate[]
  /** Safari on iPhone shows the club app's Smart App Banner: the public pages, not the admin. */
  appBanner?: boolean
  /** Structured data for the head (schema.org), as one JSON-LD block. */
  jsonLd?: Record<string, unknown>
}

const {
  title,
  description,
  image,
  type = "website",
  lang = "sv",
  alternates = [],
  appBanner = false,
  jsonLd,
} = Astro.props
// Prerendered pages have no request to resolve against, and pass no image.
const imageUrl = image ? new URL(image, Astro.url).href : null
// hreflang wants absolute URLs, and the canonical ones, as the sitemap lists
// them: the apex over https, whichever host or scheme the request came on.
const alternateLinks = alternates.map((one) => ({
  ...one,
  url: new URL(one.href, SITE_ORIGIN).href,
}))

const notAPage = {
  not: {
    or: [
      { href_matches: "/admin*" },
      { href_matches: "/api/*" },
      { href_matches: "/larm/bild/*" },
      { href_matches: "/kalender.ics" },
      { href_matches: "/feed" },
      { href_matches: "/sok*" },
      { selector_matches: "[rel~=nofollow], [download], .photo" },
    ],
  },
}
const pages = { and: [{ href_matches: "/*" }, notAPage] }
const SPECULATION_RULES = {
  prefetch: [{ where: pages, eagerness: "moderate" }],
  prerender: [{ where: pages, eagerness: "conservative" }],
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The Latin subset carries every page, Swedish, English and German; the stylesheet only asks
        for it once it has downloaded and parsed. Preloading starts it next to
        the CSS, which shortens the swap from the fallback face. It is the
        same hashed file global.css's @font-face points at, so it downloads
        once. Fonts are always fetched in CORS mode, hence `crossorigin`. */}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={alegreyaLatin} as="font" type="font/woff2" crossorigin />
    {/* Light only (docs/design.md, "Colour"). `only` keeps browsers from
        darkening the page on their own; theme-color matches the browser's
        toolbar to the white header. */}
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#ffffff" />
    {description && <meta name="description" content={description} />}
    {/* The club's emblem, as in the header and on the app's icon. Imported, so
        it gets an immutable /_astro/ name and never wakes the Worker. The
        home-screen icon sits on white: iOS fills transparency with black. */}
    <link rel="icon" type="image/png" sizes="64x64" href={icon.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    {/* Lets a feed reader find the articles' feed from any page. */}
    <link rel="alternate" type="application/rss+xml" title="Markaryds Fågelklubb" href="/feed" />
    {/* How a link looks when it's shared, in Facebook groups above all. */}
    <meta property="og:site_name" content="Markaryds Fågelklubb" />
    <meta property="og:locale" content={ogLocale(lang)} />
    {
      alternateLinks
        .filter((one) => one.lang !== lang)
        .map((one) => <meta property="og:locale:alternate" content={ogLocale(one.lang)} />)
    }
    {alternateLinks.map((one) => <link rel="alternate" hreflang={one.lang} href={one.url} />)}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    {appBanner && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
    {/* Escaped so no stored text can close the script element. */}
    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
      />
    )}
    {/* Pages a reader is about to open, fetched ahead (docs/design.md, "Lupen"):
        on a hover of about 200 ms, and rendered ahead on the press itself.
        Chromium only; other browsers ignore it. Public pages are cached for
        60 s, so the fetched page is the one shown. Left out: the admin, the
        API, larm photos, the calendar and RSS feeds (downloads, not pages),
        and search (every query is new). */}
    <script is:inline type="speculationrules" set:html={JSON.stringify(SPECULATION_RULES)} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-svh">
    <slot />
  </body>
</html>
