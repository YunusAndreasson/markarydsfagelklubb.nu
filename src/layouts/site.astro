---
import logo from "@/assets/logo.webp"
/**
 * The club's emblem, the dipper of 1986, from the app
 * (`../mafk-mobie/assets/images/splash-icon.png`, which the app shows on both
 * themes): trimmed, squared and cut to 144 px, enough for 2× at the header's
 * 64 px and 3× at 48. It is imported rather than put in public/, so it gets a hashed
 * `/_astro/` name, immutable caching and no Worker invocation. The image
 * service passes images through untouched on rendered pages, so the file is
 * sized here, not at request time.
 */
import shareEmblem from "@/assets/share-emblem.jpg"
import AppLinks from "@/components/site/AppLinks.astro"
import EmailLink from "@/components/site/EmailLink.astro"
import SiteHeader from "@/components/site/SiteHeader.astro"
import BaseLayout from "@/layouts/base.astro"
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "@/lib/app-stores"
import { SITE_ORIGIN } from "@/lib/canonical-host"
import type { Alternate, SiteLang } from "@/lib/languages"
import type { MenuEntry } from "@/lib/page-tree"
import { SITE_FALLBACK_MENU } from "@/lib/site-menu"
import { type JsonLd, jsonLdGraph, ORGANIZATION_ID, SITE_NAME } from "@/lib/structured-data"

interface Props {
  /** The page's own title; the club's name is appended. */
  title?: string
  /** The whole title, as it is, in place of `title` and the club's name: the home page's. */
  fullTitle?: string
  description?: string
  /**
   * From the page tree. Each route loads it; the layout queries nothing. Empty
   * (a prerendered page, or a failed read) shows SITE_FALLBACK_MENU.
   */
  menu: MenuEntry[]
  /** For a shared link's preview; see base.astro. */
  image?: string
  type?: "website" | "article"
  /** The page's language and its other-language versions; see base.astro. */
  lang?: SiteLang
  alternates?: readonly Alternate[]
  /** False on the error pages; see base.astro. */
  canonical?: boolean
  /**
   * The page's own schema.org nodes (lib/structured-data.ts), joined to the
   * club's in the head's one graph.
   */
  jsonLd?: readonly JsonLd[]
}

/** The site's public Web Analytics token (Cloudflare: Analytics → Web analytics). */
const WEB_ANALYTICS_TOKEN = "e2bdfb4ab63544e7a42804b08ae494ed"
const TAGLINE = "Fågelskådning och naturliv i Markaryds kommun"
/**
 * A shared link's picture when the page has no photo: the emblem on white,
 * 600 px, made from the app's icon (../mafk-mobie/assets/images/icon.png,
 * transparent corners flattened onto white). Facebook shows a picture only
 * from 200 px, which the 180 px home-screen icon missed.
 */
const SHARE_EMBLEM = new URL(shareEmblem.src, SITE_ORIGIN).href
// The club and its app's store pages, so search engines read the site and the app as one.
// The page's own nodes point at it by its @id.
const ORGANIZATION = {
  "@type": "Organization",
  "@id": ORGANIZATION_ID,
  name: SITE_NAME,
  url: SITE_ORIGIN,
  logo: new URL(logo.src, SITE_ORIGIN).href,
  sameAs: [APP_STORE_URL, GOOGLE_PLAY_URL],
}
/**
 * The header's one button (docs/design.md, "Klubben"): joining is what the
 * section is for, so it is the one place the public site spends a filled
 * button. In the bar from md up; on a phone, where the wordmark and "Meny"
 * fill the bar, it opens the menu panel instead.
 */
const JOIN_PATH = "/om-foreningen/medlemskap"

const {
  title,
  fullTitle,
  description,
  menu: loaded,
  image,
  type,
  lang = "sv",
  alternates,
  canonical,
  jsonLd = [],
} = Astro.props
const menu = loaded.length > 0 ? loaded : SITE_FALLBACK_MENU

/**
 * On a visitor page (docs/design.md, "Besökare") the header and footer stay
 * Swedish, so they say so, and a screen reader reads them in Swedish (WCAG
 * 3.1.2). The skip link is the page's own first words, in its language.
 */
const chromeLang = lang === "sv" ? undefined : "sv"
const SKIP_LINK: Record<SiteLang, string> = {
  sv: "Gå direkt till innehållet",
  en: "Skip to content",
  de: "Zum Inhalt springen",
}

/**
 * The footer's links (docs/design.md, "Footer"): only routes that live in code,
 * so renaming a page in /admin can't break them. The tree's own pages are one
 * click away in the menu above.
 */
const footerGroups = [
  {
    title: "Klubben",
    links: [
      { label: "Om klubben", href: "/om-foreningen" },
      { label: "Bli medlem", href: JOIN_PATH },
      { label: "Program", href: "/kalender" },
      { label: "Prenumerera på programmet", href: "/kalender.ics" },
      { label: "Artiklar som RSS-flöde", href: "/feed" },
    ],
  },
  {
    title: "Appen",
    links: [
      { label: "Larm", href: "/larm" },
      {
        label: "Integritetspolicy",
        href: "/om-foreningen/integritetspolicy-markaryds-fagelklubb-appen",
      },
      {
        label: "Användarvillkor",
        href: "/om-foreningen/anvandarvillkor-markaryds-fagelklubb-appen",
      },
    ],
  },
]
---

<BaseLayout
  title={fullTitle ?? (title ? `${title} · ${SITE_NAME}` : SITE_NAME)}
  description={description ?? TAGLINE}
  image={image}
  fallbackImage={SHARE_EMBLEM}
  type={type}
  lang={lang}
  alternates={alternates}
  canonical={canonical}
  appBanner
  jsonLd={jsonLdGraph([ORGANIZATION, ...jsonLd])}
>
  <a
    href="#innehall"
    class="bg-background focus:ring-ring sr-only z-30 rounded-md px-4 py-3 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:ring-2"
  >
    {SKIP_LINK[lang]}
  </a>

  {/* A column the height of the window, so the footer sits at the bottom of a
      short page instead of halfway up it. */}
  <div class="flex min-h-svh flex-col">
    <SiteHeader siteName={SITE_NAME} menu={menu} joinPath={JOIN_PATH} pageLang={lang} />

    <main id="innehall" class="flex flex-1 flex-col">
      {/* Full width above the container: the home page's day list. */}
      <slot name="band" />
      <div class="mx-auto w-full max-w-page flex-1 px-4 pt-8 pb-16 sm:px-6 md:pt-12 md:pb-24">
        <slot />
      </div>
    </main>

    <footer class="surface-gran" lang={chromeLang}>
      <div class="mx-auto grid w-full max-w-page grid-cols-2 gap-x-6 gap-y-10 px-4 pt-12 pb-14 sm:gap-x-8 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto_auto] md:gap-x-20 md:pt-14 md:pb-16">
        <div class="col-span-2 flex items-start gap-3 md:col-span-1">
          <img src={logo.src} width={logo.width} height={logo.height} alt="" loading="lazy" class="size-10 shrink-0" />
          <div class="flex flex-col gap-1 text-sm">
            <p class="text-foreground font-semibold">{SITE_NAME}</p>
            <p class="text-muted-foreground">{TAGLINE}</p>
            <p>
              <EmailLink
                address="webmaster@markarydsfagelklubb.nu"
                class="text-muted-foreground hover:text-foreground flex min-h-11 w-fit items-center underline underline-offset-4 md:min-h-8"
              />
            </p>
            <AppLinks sentence={false} class="mt-2" />
            <p class="type-caption mt-2">
              Besök räknas anonymt med Cloudflare Web Analytics, utan cookies.
            </p>
          </div>
        </div>
        {
          footerGroups.map((group) => (
            <nav aria-label={group.title} class="flex flex-col gap-2 text-sm">
              <h2 class="type-label">{group.title}</h2>
              <ul class="flex flex-col">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} class="hover:decoration-primary flex min-h-11 w-fit items-center underline-offset-4 hover:underline md:min-h-8">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </footer>
  </div>

  {/* Cloudflare Web Analytics, public pages only (the admin uses admin.astro):
      cookieless, and the footer says so. The CSP allows its script and
      report origins (security-headers.ts and public/_headers). */}
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}
  ></script>
</BaseLayout>
