{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Takes over the Worker of the retired TanStack app (../mafk). The URL
  // https://mafk-web.jonas-268.workers.dev is also the shared Supabase project's
  // auth `site_url`, so keeping the name keeps that setting valid.
  "name": "mafk-web",

  // Our own entry (src/worker.ts): the adapter's request handler plus the
  // `scheduled` handler that reads Artportalen into KV. It replaced the
  // adapter's `@astrojs/cloudflare/entrypoints/server` in step 10.
  "main": "./src/worker.ts",

  // Pinned to the installed workerd build (1.20260918). Must be >= 2025-04-01
  // so navigation requests can skip the Worker when a static asset matches.
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  // The site's address since the launch (step 9, 2026-11-15). Custom domains:
  // Cloudflare makes the DNS records and the certificate, and the zone
  // (Cloudflare DNS since 2026-11-15) must have no other A/AAAA/CNAME at these
  // names. www answers too, and the middleware 301s it to the apex
  // (src/lib/canonical-host.ts).
  "routes": [
    { "pattern": "markarydsfagelklubb.nu", "custom_domain": true },
    { "pattern": "www.markarydsfagelklubb.nu", "custom_domain": true }
  ],

  // workers.dev stays on for the deploy's smoke test of /api/health and as the
  // Supabase auth site_url's old host; every page there 301s to the apex.
  // Per-version preview URLs are off — nothing uses them (production ships
  // with `pnpm ship`), and each would be another public copy of the site.
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Astro emits a real 404.html. This is the SSG mode — NOT
    // "single-page-application", which would 200 every unmatched path.
    "not_found_handling": "404-page",

    // ARRAY form on purpose. `run_worker_first: true` would also route the
    // scripts, styles and fonts through the Worker, burning the free-tier
    // invocation budget on files that never change.
    //
    // Every page is server-rendered from the database since step 3
    // (docs/roadmap.md, D4), so every path runs the Worker first, except the
    // static files, which stay free and unlimited. `!` patterns win over the
    // rest, regardless of order (at most 100 entries). A new file in public/
    // needs an exclusion here, or it is served through the Worker.
    //
    // The prerendered 404 needs no exclusion: the adapter serves it from the
    // assets when no route matches.
    //
    // `astro dev` applies this list too, so "/*" would send Vite's own files to
    // the Worker, where they 404: no CSS, fonts, images or islands in dev. The
    // last four exclusions are for those; no built page lives under them.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/robots.txt",
      "!/@*",
      "!/src/*",
      "!/node_modules/*",
      "!/.astro/*"
    ]
  },

  // The kommun's bird statistics from Artportalen (docs/roadmap.md, step 10).
  // Written only by the cron jobs below, read by the /obsar pages and the home
  // page. No id: wrangler creates the namespace on the first deploy and keeps it.
  "kv_namespaces": [{ "binding": "OBSAR" }],

  // Must match FAST_CRON and NIGHTLY_CRON in src/lib/artportalen/jobs.ts.
  // Every half hour: the newest sightings and this year (about six SOS calls).
  // 03:17 UTC: the all-time list and eight past years, so all of history
  // refreshes about once a week within SOS's rate limit.
  "triggers": { "crons": ["*/30 * * * *", "17 3 * * *"] },

  // Both values are public by design: the publishable key ships to the browser
  // and Postgres RLS is the security boundary. Keeping them here (not as
  // secrets) means a build-time prerender needs no CI secret, and there is one
  // source of truth for local, preview and production. `src/lib/env.ts` refuses
  // to start if a `sb_secret_*` key ever lands in the publishable slot.
  "vars": {
    "SUPABASE_URL": "https://zgnmajovyqibgxlcomvb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_S96c9usYadiz4ryo1zEK4Q_SOmsVyVG"
  }

  // NOTE: once this file exists it is the SOURCE OF TRUTH for bindings.
  // Anything configured in the Cloudflare dashboard stops applying on the next
  // deploy. Secrets are NOT declared here — set them with `wrangler secret put`
  // and locally in .dev.vars (see .dev.vars.example): SUPABASE_SECRET_KEY
  // (larm) and ARTPORTALEN_API_KEY (the statistics jobs).
}
