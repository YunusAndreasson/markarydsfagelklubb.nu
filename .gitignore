# Third-party agent skills are a cache, not source. `skills-lock.json` IS
# tracked; the downloaded files are restored with `npx skills
# experimental_install`, exactly as node_modules is restored from a lockfile.
#
# Both paths are needed: the CLI installs to `.claude/skills/` when it targets
# Claude Code, but a lockfile restore lands in `.agents/skills/` (the
# cross-agent universal dir). `/*` rather than `/` so the skills we author
# ourselves can be re-included below — git cannot re-include a file whose
# parent directory is excluded.
.claude/skills/*
!.claude/skills/new-migration/
.agents/
.claude/settings.local.json
.claude/projects/

# Per-dev agent/editor config — not committed
.codex/
.opencode/
.zed/
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Environment — the .example files ARE tracked and document every key
.env
.env.*
!.env.example

# Generated by `wrangler types` from wrangler.jsonc — ~500K of runtime types.
# `pnpm typecheck` regenerates it, so a fresh clone never needs it committed.
worker-configuration.d.ts

# Cloudflare — local secrets and local state
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# Supabase CLI local state (config.toml and migrations/ are tracked)
supabase/.temp/
supabase/.branches/

# The WordPress import's cache and dry-run output (scripts/wp-import/)
.wp-import/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
